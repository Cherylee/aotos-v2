{%- style -%}
  #CollectionWhy-{{ section.id }} {
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
    background: #ffffff;
  }

  #CollectionWhy-{{ section.id }} .collection-why__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
  }

  #CollectionWhy-{{ section.id }} .collection-why__title {
    margin: 0 0 calc(48 * var(--rem));
    font-weight: 700;
    color: #000000;
    text-align: {{ section.settings.heading_align | default: 'center' }};
  }

  #CollectionWhy-{{ section.id }} .collection-why__grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: calc(16 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #ffffff;
    text-decoration: none;
    border-radius: calc(16 * var(--rem));
    box-sizing: border-box;
  }

  #CollectionWhy-{{ section.id }} .collection-why__card--large {
    grid-column: 1;
    grid-row: 1 / 3;
    min-height: calc(520 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__card--small {
    min-height: calc(252 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__media {
    position: absolute;
    inset: 0;
  }

  #CollectionWhy-{{ section.id }} .collection-why__media img,
  #CollectionWhy-{{ section.id }} .collection-why__ph {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #CollectionWhy-{{ section.id }} .collection-why__ph {
    background: #d9d9d9;
  }

  #CollectionWhy-{{ section.id }} .collection-why__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 8%) 0%, rgb(0 0 0 / 42%) 100%);
  }

  #CollectionWhy-{{ section.id }} .collection-why__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: calc(24 * var(--rem));
    box-sizing: border-box;
  }

  #CollectionWhy-{{ section.id }} .collection-why__badge {
    display: inline-flex;
    align-items: center;
    margin: 0 0 calc(12 * var(--rem));
    padding: calc(4 * var(--rem)) calc(10 * var(--rem));
    background: var(--aotos-theme-color, #ff6501);
    color: #ffffff;
    border-radius: var(--buttons-radius, calc(40 * var(--rem)));
    font-size: calc(12 * var(--rem));
    font-weight: 600;
    line-height: calc(16 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__name {
    margin: 0;
    color: #ffffff;
    font-size: calc(18 * var(--rem));
    font-weight: 700;
    line-height: calc(22 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__text {
    margin: calc(6 * var(--rem)) 0 0;
    color: #ffffff;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__btn {
    gap: calc(6 * var(--rem));
    width: max-content;
    margin-top: auto;
    padding-left: calc(16 * var(--rem));
    padding-right: calc(16 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__btn .icon {
    width: calc(10 * var(--rem));
    height: calc(10 * var(--rem));
  }

  #CollectionWhy-{{ section.id }} .collection-why__plus {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(32 * var(--rem));
    height: calc(32 * var(--rem));
    margin-top: auto;
    margin-left: auto;
    color: var(--aotos-theme-color, #ff6501);
    background: #ffffff;
    border-radius: 50%;
  }

  #CollectionWhy-{{ section.id }} .collection-why__plus .icon {
    width: calc(12 * var(--rem));
    height: calc(12 * var(--rem));
  }

  @media (hover: hover) {
    #CollectionWhy-{{ section.id }} .collection-why__card {
      transition: transform 0.2s ease;
    }

    #CollectionWhy-{{ section.id }} .collection-why__card:hover {
      transform: translateY(calc(-2 * var(--rem)));
    }
  }

  @media screen and (max-width: 768px) {
    #CollectionWhy-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__shell {
      width: 100%;
      padding: 0 calc(40 * var(--rem));
      box-sizing: border-box;
    }

    #CollectionWhy-{{ section.id }} .collection-why__title {
      margin-bottom: calc(48 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: calc(24 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__card--large,
    #CollectionWhy-{{ section.id }} .collection-why__card--small {
      grid-column: auto;
      grid-row: auto;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    #CollectionWhy-{{ section.id }} .collection-why__copy {
      padding: calc(32 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__badge {
      font-size: calc(20 * var(--rem));
      line-height: calc(28 * var(--rem));
      padding: calc(8 * var(--rem)) calc(18 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__name {
      font-size: calc(28 * var(--rem));
      line-height: calc(36 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__text {
      margin-top: calc(8 * var(--rem));
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #CollectionWhy-{{ section.id }} .collection-why__plus {
      width: calc(56 * var(--rem));
      height: calc(56 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #CollectionWhy-{{ section.id }} .collection-why__card {
      transition: none;
    }
  }
{%- endstyle -%}

<div id="CollectionWhy-{{ section.id }}" class="collection-why">
  <div class="collection-why__shell">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-why__title aotos-section-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collection-why__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_class = 'collection-why__card collection-why__card--small'
            if forloop.first
              assign card_class = 'collection-why__card collection-why__card--large'
            endif
            assign img_width = 540
            if forloop.first
              assign img_width = 800
            endif
            assign img_height = img_width | times: 10 | divided_by: 16
            if forloop.first
              assign img_height = img_width
            endif
          -%}
          {%- if block.settings.button_link != blank -%}
            <a
              class="{{ card_class }}"
              href="{{ block.settings.button_link }}"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <article class="{{ card_class }}" {{ block.shopify_attributes }}>
          {%- endif -%}
            <div class="collection-why__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: img_width }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: img_width }} {{ img_width }}w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="{% if forloop.first %}(max-width: 768px) 89vw, 568px{% else %}(max-width: 768px) 89vw, 500px{% endif %}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  width="{{ img_width }}"
                  height="{{ img_height }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="collection-why__ph"></span>
              {%- endif -%}
            </div>
            <div class="collection-why__copy">
              {%- if block.settings.badge != blank -%}
                <span class="collection-why__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="collection-why__name">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="collection-why__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if forloop.first -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="button collection-why__btn">
                    {{ block.settings.button_label | escape }}
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
              {%- else -%}
                <span class="collection-why__plus" aria-hidden="true">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </div>
          {%- if block.settings.button_link != blank -%}
            </a>
          {%- else -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Why choose 卡片",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Why choose AOTOS E-Bike"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "标题对齐",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "上边距（PC）",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "下边距（PC）",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "上边距（手机）",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "下边距（手机）",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "标签"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题"
        },
        {
          "type": "text",
          "id": "text",
          "label": "副标题"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字（左侧大卡）",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "链接"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Why choose 卡片",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
