{%- liquid
  assign accent = section.settings.accent_color | default: '#ff6501'
-%}

{% style %}
  body:has(.sr-support) #MainContent > .shopify-section.section + .shopify-section.section {
    margin-top: 0;
  }

  #sr-support-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#ffffff' }};
    color: #000000;
    font-family: var(--font-body-family);
    padding-top: calc({{ section.settings.padding_top | default: 80 }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80 }} * var(--rem));
  }

  #sr-support-{{ section.id }} * {
    box-sizing: border-box;
  }

  #sr-support-{{ section.id }} .sr-support__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
  }

  #sr-support-{{ section.id }} .sr-support__heading {
    margin: 0 0 calc(48 * var(--rem));
    color: #000000;
    font-size: var(--aotos-section-title-size);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  #sr-support-{{ section.id }} .sr-support__steps {
    position: relative;
    margin: 0 0 calc(80 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-support__connectors {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(88 * var(--rem));
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }

  #sr-support-{{ section.id }} .sr-support__connectors path {
    fill: none;
    stroke: #d0d0d0;
    stroke-width: 1.5;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
  }

  #sr-support-{{ section.id }} .sr-support__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(24 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-step {
    position: relative;
    text-align: center;
  }

  #sr-support-{{ section.id }} .sr-step__icon-wrap {
    position: relative;
    z-index: 1;
    width: calc(68 * var(--rem));
    height: calc(68 * var(--rem));
    margin: 0 auto calc(24 * var(--rem));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: {{ section.settings.background_color | default: '#ffffff' }};
  }

  #sr-support-{{ section.id }} .sr-step__num {
    position: absolute;
    top: calc(-2 * var(--rem));
    left: calc(-2 * var(--rem));
    width: calc(20 * var(--rem));
    height: calc(20 * var(--rem));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: {{ accent }};
    color: #ffffff;
    font-size: calc(10 * var(--rem));
    line-height: 1;
    font-weight: 600;
  }

  #sr-support-{{ section.id }} .sr-step__icon,
  #sr-support-{{ section.id }} .sr-step__icon svg,
  #sr-support-{{ section.id }} .sr-step__icon img {
    display: block;
    width: calc(32 * var(--rem));
    height: calc(32 * var(--rem));
    object-fit: contain;
  }

  #sr-support-{{ section.id }} .sr-step__vcurve {
    display: none;
  }

  #sr-support-{{ section.id }} .sr-step__title {
    margin: 0 0 calc(8 * var(--rem));
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-step__text {
    margin: 0 auto;
    max-width: calc(220 * var(--rem));
    color: #999999;
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(24 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-offer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: calc(40 * var(--rem)) calc(32 * var(--rem));
    border: 1px solid #e8e8e8;
    border-radius: calc(8 * var(--rem));
    background: #ffffff;
  }

  #sr-support-{{ section.id }} .sr-offer__icon {
    position: relative;
    width: calc(64 * var(--rem));
    height: calc(64 * var(--rem));
    margin: 0 0 calc(20 * var(--rem));
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #f5f5f5;
    color: #ff6501;
  }

  #sr-support-{{ section.id }} .sr-offer__icon--custom::after {
    content: '';
    display: block;
    width: calc(28 * var(--rem));
    height: calc(28 * var(--rem));
    background-color: currentColor;
    -webkit-mask-image: var(--sr-offer-icon-mask);
    mask-image: var(--sr-offer-icon-mask);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  #sr-support-{{ section.id }} .sr-offer__icon--custom img {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }

  #sr-support-{{ section.id }} .sr-offer__icon img {
    display: block;
    width: calc(28 * var(--rem));
    height: calc(28 * var(--rem));
    object-fit: contain;
  }

  #sr-support-{{ section.id }} .sr-offer__title {
    margin: 0 0 calc(8 * var(--rem));
    color: #000000;
    font-size: calc(16 * var(--rem));
    font-weight: 600;
    line-height: calc(22 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-offer__text {
    margin: 0 0 calc(24 * var(--rem));
    max-width: calc(360 * var(--rem));
    color: #999999;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-support-{{ section.id }} .sr-offer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(40 * var(--rem));
    padding: 0 calc(20 * var(--rem));
    border-radius: calc(4 * var(--rem));
    font-size: calc(12 * var(--rem));
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    transition: opacity 0.25s ease;
  }

  #sr-support-{{ section.id }} .sr-offer__btn--accent {
    background: {{ accent }};
  }

  #sr-support-{{ section.id }} .sr-offer__btn--dark {
    background: #000000;
  }

  #sr-support-{{ section.id }} .sr-support__note {
    margin: calc(24 * var(--rem)) 0 0;
    color: #999999;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
    text-align: center;
  }

  @media (hover: hover) {
    #sr-support-{{ section.id }} .sr-offer__btn:hover {
      opacity: 0.88;
    }
  }

  @media screen and (max-width: 749px) {
    #sr-support-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88 }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88 }} * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__shell {
      width: 100%;
      padding: 0 calc(40 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__heading {
      margin-bottom: calc(48 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__steps {
      margin-bottom: calc(88 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__connectors {
      display: none;
    }

    #sr-support-{{ section.id }} .sr-support__grid {
      grid-template-columns: 1fr;
      gap: calc(56 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon-wrap {
      width: calc(112 * var(--rem));
      height: calc(112 * var(--rem));
      margin-bottom: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__num {
      width: calc(36 * var(--rem));
      height: calc(36 * var(--rem));
      font-size: calc(20 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon,
    #sr-support-{{ section.id }} .sr-step__icon svg,
    #sr-support-{{ section.id }} .sr-step__icon img {
      width: calc(88 * var(--rem));
      height: calc(88 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon-wrap {
      margin-bottom: 0;
    }

    #sr-support-{{ section.id }} .sr-step__vcurve {
      display: block;
      position: relative;
      width: calc(48 * var(--rem));
      height: calc(56 * var(--rem));
      margin: calc(8 * var(--rem)) auto;
      overflow: visible;
      pointer-events: none;
    }

    #sr-support-{{ section.id }} .sr-step:last-child .sr-step__icon-wrap {
      margin-bottom: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step:last-child .sr-step__vcurve {
      display: none;
    }

    #sr-support-{{ section.id }} .sr-step__title {
      margin-bottom: calc(12 * var(--rem));
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__text {
      max-width: none;
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offers {
      grid-template-columns: 1fr;
      gap: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer {
      padding: calc(48 * var(--rem)) calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__icon {
      width: calc(96 * var(--rem));
      height: calc(96 * var(--rem));
      margin-bottom: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__icon svg,
    #sr-support-{{ section.id }} .sr-offer__icon img,
    #sr-support-{{ section.id }} .sr-offer__icon--custom::after {
      width: calc(44 * var(--rem));
      height: calc(44 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__title {
      font-size: calc(28 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__text {
      margin-bottom: calc(32 * var(--rem));
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__btn {
      min-height: calc(72 * var(--rem));
      padding: 0 calc(28 * var(--rem));
      font-size: calc(22 * var(--rem));
      border-radius: calc(6 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__note {
      margin-top: calc(32 * var(--rem));
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    #sr-support-{{ section.id }} {
      padding-top: calc(168 * var(--rem));
      padding-bottom: calc(168 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__shell {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 calc(34 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__heading {
      margin-bottom: calc(90 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__steps {
      margin-bottom: calc(152 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__connectors {
      display: none;
    }

    #sr-support-{{ section.id }} .sr-support__grid {
      grid-template-columns: 1fr;
      gap: calc(90 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon-wrap {
      width: calc(88 * var(--rem));
      height: calc(88 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon,
    #sr-support-{{ section.id }} .sr-step__icon svg,
    #sr-support-{{ section.id }} .sr-step__icon img {
      width: calc(72 * var(--rem));
      height: calc(72 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__icon-wrap {
      margin-bottom: 0;
    }

    #sr-support-{{ section.id }} .sr-step__vcurve {
      display: block;
      position: relative;
      width: calc(40 * var(--rem));
      height: calc(90 * var(--rem));
      margin: calc(16 * var(--rem)) auto;
      pointer-events: none;
    }

    #sr-support-{{ section.id }} .sr-step:last-child .sr-step__icon-wrap {
      margin-bottom: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step:last-child .sr-step__vcurve {
      display: none;
    }

    #sr-support-{{ section.id }} .sr-step__title {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-step__text {
      max-width: none;
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offers {
      grid-template-columns: 1fr;
      gap: calc(24 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__title {
      font-size: calc(28 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__text {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-offer__btn {
      min-height: calc(52 * var(--rem));
      font-size: calc(14 * var(--rem));
    }

    #sr-support-{{ section.id }} .sr-support__note {
      font-size: calc(18 * var(--rem));
      line-height: calc(32 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sr-support-{{ section.id }} .sr-offer__btn {
      transition: none;
    }
  }
{% endstyle %}

{%- capture sr_icon_document -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M16 8h13l7 7v25H16V8Z" stroke="#111111" stroke-width="1.7" stroke-linejoin="round"/>
    <path d="M29 8v7h7" stroke="#111111" stroke-width="1.7" stroke-linejoin="round"/>
    <path d="M21 22h10M21 27h10" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M26 32.5 33 30l2.2 2.2-7 7H25.5l.5-6.7Z" stroke="#111111" stroke-width="1.7" stroke-linejoin="round"/>
    <path d="M31.2 31.8 33.8 34.4" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
  </svg>
{%- endcapture -%}
{%- capture sr_icon_monitor -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <rect x="8" y="10" width="32" height="22" rx="2" stroke="#111111" stroke-width="1.7"/>
    <path d="M18 38h12M24 32v6" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M24 16.5 28.2 21 24 25.5 19.8 21 24 16.5Z" stroke="#111111" stroke-width="1.7" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}
{%- capture sr_icon_branch -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M10 24h10" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M20 24c6 0 8-8 16-8" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M20 24c6 0 8 0 16 0" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M20 24c6 0 8 8 16 8" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M32 12.5 36 16l-4 3.5M32 20.5 36 24l-4 3.5M32 28.5 36 32l-4 3.5" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}
{%- capture sr_icon_tools -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M16 32 32 16" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <path d="M29 13c2.6-2.6 6.8-2.8 9.6-.6l-6.2 6.2 4 4 6.2-6.2c2.2 2.8 2 7-.6 9.6" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M19 35H13v-6" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M18 14v8M15 18h6" stroke="#111111" stroke-width="1.7" stroke-linecap="round"/>
    <rect x="14" y="22" width="4" height="10" rx="1" transform="rotate(-45 14 22)" stroke="#111111" stroke-width="1.7"/>
  </svg>
{%- endcapture -%}
{%- capture sr_icon_headset -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M12 24a12 12 0 1 1 24 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <rect x="8" y="22" width="7" height="12" rx="3" stroke="currentColor" stroke-width="1.8"/>
    <rect x="33" y="22" width="7" height="12" rx="3" stroke="currentColor" stroke-width="1.8"/>
    <path d="M36 34v3a5 5 0 0 1-5 5h-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
{%- endcapture -%}
{%- capture sr_icon_store -%}
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M8 20h32v18H8V20Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M8 20 12 10h24l4 10" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M16 10v10M24 10v10M32 10v10" stroke="currentColor" stroke-width="1.8"/>
    <path d="M20 38v-8h8v8" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
  </svg>
{%- endcapture -%}

<section class="sr-support" id="sr-support-{{ section.id }}">
  <div class="sr-support__shell">
    {%- if section.settings.steps_heading != blank -%}
      <h2 class="sr-support__heading aotos-section-title">{{ section.settings.steps_heading }}</h2>
    {%- endif -%}

    <div class="sr-support__steps">
      <svg class="sr-support__connectors" viewBox="0 0 1100 88" preserveAspectRatio="none" aria-hidden="true">
        <path d="M137.5 44 H412.5"/>
        <path d="M412.5 44 H687.5"/>
        <path d="M687.5 44 H962.5"/>
      </svg>
      <div class="sr-support__grid">
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'step' -%}{%- continue -%}{%- endif -%}
          {%- assign step_index = step_index | plus: 1 -%}
          {%- assign icon_key = block.settings.icon_key | default: 'document' -%}
          <div class="sr-step" {{ block.shopify_attributes }}>
            <div class="sr-step__icon-wrap">
              <span class="sr-step__num">{{ step_index }}</span>
              <div class="sr-step__icon">
                {%- if block.settings.icon != blank -%}
                  <img
                    src="{{ block.settings.icon | image_url: width: 144 }}"
                    srcset="{{ block.settings.icon | image_url: width: 144 }} 144w, {{ block.settings.icon | image_url: width: 200 }} 200w"
                    sizes="(max-width: 749px) 88px, 72px"
                    width="144"
                    height="144"
                    alt=""
                    loading="lazy"
                  >
                {%- else -%}
                  {%- case icon_key -%}
                    {%- when 'monitor' -%}{{ sr_icon_monitor }}
                    {%- when 'branch' -%}{{ sr_icon_branch }}
                    {%- when 'tools' -%}{{ sr_icon_tools }}
                    {%- else -%}{{ sr_icon_document }}
                  {%- endcase -%}
                {%- endif -%}
              </div>
            </div>
            <svg class="sr-step__vcurve" viewBox="0 0 48 56" preserveAspectRatio="none" aria-hidden="true">
              <path d="M24 2 V54" fill="none" stroke="#d0d0d0" stroke-width="1.5" stroke-dasharray="5 7" stroke-linecap="round"/>
            </svg>
            {%- if block.settings.title != blank -%}
              <h3 class="sr-step__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="sr-step__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.offers_heading != blank -%}
      <h2 class="sr-support__heading aotos-section-title">{{ section.settings.offers_heading }}</h2>
    {%- endif -%}

    <div class="sr-offers">
      {%- for block in section.blocks -%}
        {%- if block.type != 'offer' -%}{%- continue -%}{%- endif -%}
        {%- assign offer_icon = block.settings.icon_key | default: 'headset' -%}
        {%- assign offer_icon_color = block.settings.icon_color | default: '#ff6501' -%}
        <article class="sr-offer" {{ block.shopify_attributes }}>
          <div
            class="sr-offer__icon{% if block.settings.icon != blank %} sr-offer__icon--custom{% endif %}"
            style="color: {{ offer_icon_color }};{% if block.settings.icon != blank %} --sr-offer-icon-mask: url({{ block.settings.icon | image_url: width: 120 }});{% endif %}"
          >
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 80 }}"
                srcset="{{ block.settings.icon | image_url: width: 80 }} 80w, {{ block.settings.icon | image_url: width: 120 }} 120w"
                sizes="28px"
                width="80"
                height="80"
                alt=""
                loading="lazy"
              >
            {%- elsif offer_icon == 'store' -%}
              {{ sr_icon_store }}
            {%- else -%}
              {{ sr_icon_headset }}
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="sr-offer__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="sr-offer__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              class="sr-offer__btn sr-offer__btn--{{ block.settings.button_style | default: 'accent' }}"
              href="{{ block.settings.button_link | default: '#' }}"
            >
              {{- block.settings.button_label -}}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="sr-support__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
