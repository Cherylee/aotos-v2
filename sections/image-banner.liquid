{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner_img_pc = section.settings.image | default: section.settings.image_mobile
  assign banner_img_mob = section.settings.image_mobile | default: section.settings.image
  assign banner_video = section.settings.video
  assign banner_video_mob = section.settings.video_mobile
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign poster_pc = banner_img_pc
  if poster_pc == blank and banner_video != blank
    assign poster_pc = banner_video.preview_image
  endif
  assign poster_mob = banner_img_mob
  if poster_mob == blank and banner_video_mob != blank
    assign poster_mob = banner_video_mob.preview_image
  endif
  if poster_mob == blank
    assign poster_mob = poster_pc
  endif
  assign banner_defer_video = false
  if section.index > 1
    if banner_video != blank or banner_video_mob != blank
      assign banner_defer_video = true
    endif
  endif
-%}

{%- if section.settings.image_height == 'adapt' and poster_pc != blank -%}
  {%- style -%}
    #Banner-{{ section.id }}.banner--adapt {
      display: block;
      height: auto;
    }

    #Banner-{{ section.id }}.banner--adapt .banner__media {
      position: relative;
      width: 100%;
      height: auto;
    }

    #Banner-{{ section.id }}.banner--adapt .banner__media.media > picture,
    #Banner-{{ section.id }}.banner--adapt .banner__media.media > img,
    #Banner-{{ section.id }}.banner--adapt .banner__media.media > .banner__poster {
      position: static;
      display: block;
      width: 100%;
      height: auto;
      max-width: none;
      object-fit: contain;
    }

    #Banner-{{ section.id }}.banner--adapt .banner__media.media > picture img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    #Banner-{{ section.id }}.banner--adapt .banner__media video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #Banner-{{ section.id }}.banner--adapt .banner__media:not(:has(img)) video {
      position: relative;
      inset: auto;
      height: auto;
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }} .banner__media video {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #Banner-{{ section.id }}:not(.banner--adapt) .banner__media picture,
  #Banner-{{ section.id }}:not(.banner--adapt) .banner__media picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #Banner-{{ section.id }} .banner__video--mobile {
    display: none;
  }

  {%- if banner_defer_video -%}
    #Banner-{{ section.id }} .banner__poster {
      z-index: 2;
    }

    #Banner-{{ section.id }}.is-video-ready .banner__poster {
      visibility: hidden;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__video--pc {
      display: none;
    }

    #Banner-{{ section.id }} .banner__video--mobile {
      display: block;
    }
  }
{%- endstyle -%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--{{ section.settings.image_height }}{% if section.settings.image_height == 'adapt' and poster_pc != blank %} banner--adapt{% endif %}"
>
  <div class="banner__media media{% if poster_pc == blank and banner_video == blank and banner_video_mob == blank %} placeholder{% endif %}">
    {%- if banner_video != blank or banner_video_mob != blank -%}
      {%- if poster_pc != blank -%}
        <img
          class="banner__poster{% if poster_mob != blank and poster_mob != poster_pc %} banner__poster--pc{% endif %}"
          src="{{ poster_pc | image_url: width: 1600 }}"
          srcset="{{ poster_pc | image_url: width: 1100 }} 1100w, {{ poster_pc | image_url: width: 1600 }} 1600w, {{ poster_pc | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="1600"
          height="{{ 1600 | divided_by: poster_pc.aspect_ratio | round }}"
          alt=""
          {% if fetch_priority == 'high' %}
            loading="eager"
            fetchpriority="high"
          {% else %}
            loading="lazy"
          {% endif %}
        >
      {%- endif -%}
      {%- if poster_mob != blank and poster_mob != poster_pc -%}
        <img
          class="banner__poster banner__poster--mobile"
          src="{{ poster_mob | image_url: width: 1100 }}"
          srcset="{{ poster_mob | image_url: width: 750 }} 750w, {{ poster_mob | image_url: width: 1100 }} 1100w, {{ poster_mob | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="1100"
          height="{{ 1100 | divided_by: poster_mob.aspect_ratio | round }}"
          alt=""
          {% if fetch_priority == 'high' %}
            loading="eager"
            fetchpriority="high"
          {% else %}
            loading="lazy"
          {% endif %}
        >
      {%- endif -%}
      {%- if banner_video != blank -%}
        {%- capture banner_video_class -%}banner__video{% if banner_video_mob != blank %} banner__video--pc{% endif %}{%- endcapture -%}
        {%- if banner_defer_video -%}
          {{ banner_video | video_tag: class: banner_video_class, autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' }}
        {%- else -%}
          {{ banner_video | video_tag: class: banner_video_class, autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {%- endif -%}
      {%- endif -%}
      {%- if banner_video_mob != blank -%}
        {%- if banner_defer_video -%}
          {{ banner_video_mob | video_tag: class: 'banner__video banner__video--mobile', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' }}
        {%- else -%}
          {{ banner_video_mob | video_tag: class: 'banner__video banner__video--mobile', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {%- endif -%}
      {%- endif -%}
    {%- elsif banner_img_pc != blank -%}
      {%- assign pc_tag_h = 1600 | divided_by: banner_img_pc.aspect_ratio | round -%}
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ banner_img_mob | image_url: width: 750 }} 750w, {{ banner_img_mob | image_url: width: 1100 }} 1100w, {{ banner_img_mob | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
          <img
            src="{{ banner_img_pc | image_url: width: 1600 }}"
            srcset="{{ banner_img_pc | image_url: width: 1100 }} 1100w, {{ banner_img_pc | image_url: width: 1600 }} 1600w, {{ banner_img_pc | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            width="1600"
            height="{{ pc_tag_h }}"
            alt=""
            {% if fetch_priority == 'high' %}
              loading="eager"
              fetchpriority="high"
            {% else %}
              loading="lazy"
            {% endif %}
          >
        </picture>
      {%- else -%}
        <img
          src="{{ banner_img_pc | image_url: width: 1600 }}"
          srcset="{{ banner_img_pc | image_url: width: 1100 }} 1100w, {{ banner_img_pc | image_url: width: 1600 }} 1600w, {{ banner_img_pc | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="1600"
          height="{{ pc_tag_h }}"
          alt=""
          {% if fetch_priority == 'high' %}
            loading="eager"
            fetchpriority="high"
          {% else %}
            loading="lazy"
          {% endif %}
        >
      {%- endif -%}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</div>

{%- if banner_video != blank or banner_video_mob != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }} .banner__poster--pc {
        display: none;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }} .banner__poster--mobile {
        display: none;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- if banner_defer_video -%}
  <script>
    (function () {
      var root = document.getElementById('Banner-{{ section.id }}');
      if (!root) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var videos = root.querySelectorAll('video');
      if (!videos.length || reduce) return;

      var visible = function (video) {
        return window.getComputedStyle(video).display !== 'none';
      };

      var sync = function (video, on) {
        if (!on || !visible(video)) {
          video.pause();
          return;
        }
        video.preload = 'auto';
        var play = video.play();
        if (play && play.then) {
          play.then(function () {
            root.classList.add('is-video-ready');
          }).catch(function () {});
        }
      };

      if (!('IntersectionObserver' in window)) {
        videos.forEach(function (video) { sync(video, true); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sync(entry.target, entry.isIntersecting);
        });
      }, { threshold: 0.15 });

      videos.forEach(function (video) { io.observe(video); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "PC"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片（PC）",
      "info": "有视频时作为封面。"
    },
    {
      "type": "video",
      "id": "video",
      "label": "视频（PC）"
    },
    {
      "type": "header",
      "content": "手机"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "图片（手机）",
      "info": "建议 750 × 1000。不上传则使用 PC 图片。"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "视频（手机）",
      "info": "不上传则使用 PC 视频。"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-banner.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-banner.settings.image_height.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-banner.presets.name"
    }
  ]
}
{% endschema %}
