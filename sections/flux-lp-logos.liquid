{% render 'flux-landing-assets' %}
<section
  class="flp flp-logos"
  style="--pad-t: {{ section.settings.padding_top | default: 90, allow_false: true }}; --pad-b: {{ section.settings.padding_bottom | default: 90, allow_false: true }}; --pad-tm: {{ section.settings.padding_top_mobile | default: 80, allow_false: true }}; --pad-bm: {{ section.settings.padding_bottom_mobile | default: 80, allow_false: true }}; --flp-bg: {{ section.settings.bg_color }}; --flp-inner: {{ section.settings.inner_color }}; --flp-title: {{ section.settings.title_color }};"
>
  <div class="flp-logos__box">
    {%- if section.settings.title != blank -%}
      <h2 class="flp-display aotos-section-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <div class="flp-logos__row">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}>
            {%- endif -%}
            {{
              block.settings.image
              | image_url: width: 280
              | image_tag:
                widths: '120, 180, 280',
                sizes: '(max-width: 768px) 70px, 140px',
                width: 280,
                height: 80,
                loading: 'lazy',
                alt: block.settings.alt
            }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FLUX 背书",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "Endorsed By" },
    { "type": "color", "id": "bg_color", "label": "背景", "default": "#f8f8f8" },
    { "type": "color", "id": "inner_color", "label": "内容背景", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "标题颜色", "default": "#000000" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "上边距", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "下边距", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机上边距", "default": 80 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机下边距", "default": 80 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "alt", "label": "替代文字" },
        { "type": "url", "id": "link", "label": "链接" },
        { "type": "checkbox", "id": "new_tab", "label": "新窗口", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "FLUX 背书" }]
}
{% endschema %}
