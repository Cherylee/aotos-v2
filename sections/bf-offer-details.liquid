{{ 'aotos-bf.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .bf-terms {
    background-color: {{ section.settings.bg_color }};
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .bf-terms {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }
  }
</style>

<section class="bf bf-terms"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="bf-shell">
    {%- if section.settings.heading != blank -%}
      <h2 class="bf-terms__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="bf-terms__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BF 活动说明",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID",
      "default": "offer-details"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#f5f5f5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Offer details"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "说明内容",
      "default": "<p>Offers valid November 16 – December 6, 2026 (PT) on aotos.com while supplies last. Free helmet applies to eligible e-bike orders only. Prices and promotions are subject to change without notice.</p>"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距 PC",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距 PC",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距 手机",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距 手机",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "BF 活动说明"
    }
  ]
}
{% endschema %}
