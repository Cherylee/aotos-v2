{% render 'flux-landing-assets' %}
<section
  class="flp flp-control"
  style="--pad-t: {{ section.settings.padding_top | default: 60, allow_false: true }}; --pad-b: {{ section.settings.padding_bottom | default: 90, allow_false: true }}; --pad-tm: {{ section.settings.padding_top_mobile | default: 80, allow_false: true }}; --pad-bm: {{ section.settings.padding_bottom_mobile | default: 120, allow_false: true }}; --flp-bg: {{ section.settings.bg_color }}; --flp-title: {{ section.settings.title_color }}; --flp-text: {{ section.settings.text_color }};"
>
  <div class="flp-shell">
    <div class="flp-control__head">
      {%- if section.settings.title != blank -%}
        <h2 class="flp-display aotos-section-title flp-reveal"><span>{{ section.settings.title | escape }}</span></h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="flp-lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <div class="flp-control__grid">
      {%- for block in section.blocks -%}
        <article class="flp-control__card" {{ block.shopify_attributes }}>
          <div class="flp-control__body">
          {%- if block.settings.image != blank -%}
            {%- assign card_h = 720 | divided_by: block.settings.image.aspect_ratio | round -%}
            <div class="flp-control__shot">
              {{
                block.settings.image
                | image_url: width: 720
                | image_tag:
                  widths: '360, 540, 720',
                  sizes: '(max-width: 768px) 89vw, 360px',
                  width: 720,
                  height: card_h,
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            </div>
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FLUX 控制力",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "Power Means Nothing Without Control" },
    { "type": "textarea", "id": "text", "label": "说明" },
    { "type": "color", "id": "bg_color", "label": "背景", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "标题颜色", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "说明颜色", "default": "#333333" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "上边距", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "下边距", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机上边距", "default": 80 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机下边距", "default": 120 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "卡片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "title", "label": "标题" },
        { "type": "textarea", "id": "text", "label": "说明" }
      ]
    }
  ],
  "presets": [{ "name": "FLUX 控制力" }]
}
{% endschema %}
