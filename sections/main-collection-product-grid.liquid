{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .aotos-collection-{{ section.id }} {
    background: #fff;
    width: 100%;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__inner {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
    box-sizing: border-box;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 calc(16 * var(--rem));
    font-size: calc(12 * var(--rem));
    line-height: calc(16 * var(--rem));
    font-weight: 400;
    color: #999999;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb-item {
    display: flex;
    align-items: center;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb-sep {
    margin: 0 calc(8 * var(--rem));
    color: #999999;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb a {
    color: #999999;
    text-decoration: none;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__crumb-current {
    color: #000000;
  }

  @media (hover: hover) {
    .aotos-collection-{{ section.id }} .aotos-collection__crumb a:hover {
      color: #000000;
    }
  }

  .aotos-collection-{{ section.id }} .aotos-collection__heading {
    margin: 0 0 calc(48 * var(--rem));
    font-weight: 700;
    color: #000000;
    text-align: left;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__heading:first-child {
    margin-top: 0;
  }

  .aotos-collection-{{ section.id }} .aotos-collection__layout,
  .aotos-collection-{{ section.id }} .facets-vertical {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: calc(32 * var(--rem));
    width: 100%;
  }

  .aotos-collection-{{ section.id }} .facets-wrapper {
    flex: 0 0 calc(240 * var(--rem));
    width: calc(240 * var(--rem));
    max-width: 100%;
    padding-right: 0;
  }

  .aotos-collection-{{ section.id }} .aotos-collection-cats {
    margin: 0 0 calc(24 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .aotos-collection-cats__title {
    margin: 0 0 calc(12 * var(--rem));
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
    font-weight: 700;
    color: #000000;
  }

  .aotos-collection-{{ section.id }} .aotos-collection-cats__list {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--rem));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aotos-collection-{{ section.id }} .aotos-collection-cats__link {
    display: inline-block;
    padding: calc(8 * var(--rem)) 0;
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
    font-weight: 400;
    color: #000000;
    text-decoration: none;
  }

  .aotos-collection-{{ section.id }} .aotos-collection-cats__link.is-active {
    font-weight: 700;
    color: var(--aotos-theme-color, #ff6501);
  }

  .aotos-collection-{{ section.id }} .facets__form-vertical {
    width: 100%;
  }

  .aotos-collection-{{ section.id }} .product-grid-container {
    flex: 1 1 auto;
    min-width: 0;
    width: auto;
  }

  .aotos-collection-{{ section.id }} .facets-vertical-sort {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto calc(16 * var(--rem));
  }

  .aotos-collection-{{ section.id }} #product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    gap: calc(18 * var(--rem));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aotos-collection-{{ section.id }} #product-grid > .grid__item {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .aotos-collection-{{ section.id }} .card-wrapper {
    height: 100%;
  }

  .aotos-collection-{{ section.id }} .card {
    position: relative;
    border-radius: calc(12 * var(--rem));
    overflow: hidden;
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card {
    background: #fff;
    box-shadow: none;
    border: 1px solid #f0f0f0;
    border-radius: calc(6 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card__inner {
    background: #fff;
    padding: calc(28 * var(--rem)) calc(24 * var(--rem)) calc(8 * var(--rem));
    box-sizing: border-box;
    --ratio-percent: 100%;
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card__inner.ratio::before {
    padding-bottom: 100%;
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card__media,
  .aotos-collection-{{ section.id }} .product-card-wrapper .card__inner .media {
    inset: 0;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card__inner .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0 auto;
    object-fit: contain;
    object-position: center center;
  }

  .aotos-collection-{{ section.id }} .card__badge {
    display: none;
  }

  .aotos-collection-{{ section.id }} .product-card-wrapper .card__information {
    padding: calc(6 * var(--rem)) calc(12 * var(--rem)) calc(12 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .card__heading {
    margin: 0 0 calc(2 * var(--rem));
    width: 100%;
    min-width: 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(16 * var(--rem));
    font-weight: 500;
    color: #000000;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .aotos-collection-{{ section.id }} .card__heading a {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .aotos-collection-{{ section.id }} .card-information {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(2 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .card-information > .caption-large {
    display: none;
  }

  .aotos-collection-{{ section.id }} .rating-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 0;
    gap: calc(6 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .rating {
    display: inline-flex;
    align-items: center;
    gap: calc(2 * var(--rem));
    margin: 0;
    line-height: 1;
  }

  .aotos-collection-{{ section.id }} .rating-star-icon {
    display: block;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    flex: 0 0 auto;
    overflow: visible;
  }

  .aotos-collection-{{ section.id }} .rating-star-icon .rating-star-outline {
    fill: none;
    stroke: var(--aotos-theme-color, #ff6501);
    stroke-width: 1.8;
  }

  .aotos-collection-{{ section.id }} .rating-star-icon.is-filled .rating-star-outline {
    fill: var(--aotos-theme-color, #ff6501);
  }

  .aotos-collection-{{ section.id }} .rating-star-icon.is-half .rating-star-fill {
    fill: var(--aotos-theme-color, #ff6501);
    stroke: none;
  }

  .aotos-collection-{{ section.id }} .rating-count {
    display: inline-flex;
    align-items: center;
    margin: 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(14 * var(--rem));
    font-weight: 400;
    letter-spacing: 0;
    color: #999999;
  }

  .aotos-collection-{{ section.id }} .price {
    width: auto;
    max-width: 100%;
    margin: calc(2 * var(--rem)) 0 0;
    font-size: calc(12 * var(--rem));
    font-weight: 600;
    line-height: calc(16 * var(--rem));
    color: #000000;
    white-space: nowrap;
  }

  .aotos-collection-{{ section.id }} .price .price-item {
    margin: 0;
  }

  .aotos-collection-{{ section.id }} .price__sale {
    display: none;
  }

  .aotos-collection-{{ section.id }} .price--on-sale .price__regular {
    display: none;
  }

  .aotos-collection-{{ section.id }} .price--on-sale .price__sale {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: baseline;
    white-space: nowrap;
    gap: calc(6 * var(--rem));
  }

  .aotos-collection-{{ section.id }} .price--on-sale .price-item--sale::before {
    content: 'From ';
    font-weight: 600;
  }

  .aotos-collection-{{ section.id }} .price--on-sale .price-item--sale,
  .aotos-collection-{{ section.id }} .price--on-sale .price-item--last {
    color: var(--aotos-theme-color, #ff6501);
  }

  .aotos-collection-{{ section.id }} .price--on-sale .price-item--regular {
    color: #999999;
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    line-height: calc(14 * var(--rem));
  }

  @media screen and (max-width: 768px) {
    .aotos-collection-{{ section.id }} .aotos-collection__inner {
      width: 100%;
      padding: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem)) calc(40 * var(--rem)) calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }

    .aotos-collection-{{ section.id }} .aotos-collection__crumb {
      margin-bottom: calc(16 * var(--rem));
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .aotos-collection__layout,
    .aotos-collection-{{ section.id }} .facets-vertical {
      flex-direction: column;
      gap: calc(24 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .facets-wrapper {
      flex: none;
      width: 100%;
      padding: 0;
    }

    .aotos-collection-{{ section.id }} .product-grid-container {
      width: 100%;
    }

    .aotos-collection-{{ section.id }} #product-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(24 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .product-card-wrapper .card__inner {
      padding: calc(48 * var(--rem)) calc(96 * var(--rem)) calc(24 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .product-card-wrapper .card__information {
      padding: calc(16 * var(--rem)) calc(32 * var(--rem)) calc(20 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .card__heading {
      font-size: calc(28 * var(--rem));
      line-height: calc(36 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .rating-count {
      font-size: calc(24 * var(--rem));
      line-height: calc(28 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .rating-star-icon {
      width: calc(28 * var(--rem));
      height: calc(28 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .price {
      font-size: calc(28 * var(--rem));
      line-height: calc(36 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .price--on-sale .price-item--regular {
      font-size: calc(22 * var(--rem));
      line-height: calc(28 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .facets.small-hide,
    .aotos-collection-{{ section.id }} .facets-vertical-sort {
      display: none !important;
    }

    .aotos-collection-{{ section.id }} .mobile-facets__wrapper.medium-hide,
    .aotos-collection-{{ section.id }} .mobile-facets__wrapper.large-up-hide {
      display: block !important;
    }

    .aotos-collection-{{ section.id }} .mobile-facets__open-label.medium-hide,
    .aotos-collection-{{ section.id }} .mobile-facets__open-label.large-up-hide,
    .aotos-collection-{{ section.id }} .mobile-facets__heading.medium-hide,
    .aotos-collection-{{ section.id }} .mobile-facets__heading.large-up-hide {
      display: inline !important;
    }

    .aotos-collection-{{ section.id }} .mobile-facets__heading.medium-hide {
      display: block !important;
    }

    .aotos-collection-{{ section.id }} .mobile-facets__open-label.small-hide,
    .aotos-collection-{{ section.id }} .mobile-facets__heading.small-hide {
      display: none !important;
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats {
      width: auto;
      max-width: none;
      margin: 0 calc(-40 * var(--rem)) calc(24 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__title {
      display: none;
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: calc(16 * var(--rem));
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 calc(40 * var(--rem));
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__list::-webkit-scrollbar {
      display: none;
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__list > li {
      flex: 0 0 auto;
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__link {
      padding: calc(12 * var(--rem)) calc(28 * var(--rem));
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
      white-space: nowrap;
      border: 1px solid transparent;
      border-radius: var(--buttons-radius, calc(40 * var(--rem)));
      box-sizing: border-box;
    }

    .aotos-collection-{{ section.id }} .aotos-collection-cats__link.is-active {
      border-color: var(--aotos-theme-color, #ff6501);
    }
  }
{%- endstyle -%}

<div class="aotos-collection-{{ section.id }}">
  <div class="aotos-collection__inner">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="aotos-collection__crumb" aria-label="Breadcrumb">
        <ol class="aotos-collection__crumb-list">
          <li class="aotos-collection__crumb-item">
            <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
            <span class="aotos-collection__crumb-sep" aria-hidden="true">/</span>
          </li>
          <li class="aotos-collection__crumb-item">
            <span class="aotos-collection__crumb-current" aria-current="page">{{ collection.title | escape }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}
    {%- if section.settings.show_heading -%}
      <h1 class="aotos-section-title aotos-collection__heading">
        {{ collection.title | escape }}
      </h1>
    {%- else -%}
      <h1 class="visually-hidden">{{ collection.title | escape }}</h1>
    {%- endif -%}
  {%- paginate collection.products by section.settings.products_per_page -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="aotos-collection__layout{% if section.settings.filter_type == 'vertical' %} facets-vertical{% endif %}">
      {{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          <nav class="aotos-collection-cats" aria-label="Categories">
            <h2 class="aotos-collection-cats__title">Categories</h2>
            <ul class="aotos-collection-cats__list" id="AotosCollectionCats-{{ section.id }}">
              {%- if collections.all != blank -%}
                <li>
                  <a
                    class="aotos-collection-cats__link{% if collection.handle == 'all' %} is-active{% endif %}"
                    href="{{ collections.all.url }}"
                  >
                    {{ collections.all.title | escape }}
                  </a>
                </li>
              {%- endif -%}
              {%- for cat_col in collections -%}
                {%- if cat_col.handle == 'all' or cat_col.products_count == 0 -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign cat_handle_down = cat_col.handle | downcase -%}
                {%- if cat_handle_down contains 'avada' -%}
                  {%- continue -%}
                {%- endif -%}
                <li>
                  <a
                    class="aotos-collection-cats__link{% if collection.handle == cat_col.handle %} is-active{% endif %}"
                    href="{{ cat_col.url }}"
                  >
                    {{ cat_col.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          <script>
            (function () {
              var list = document.getElementById('AotosCollectionCats-{{ section.id }}');
              if (!list) return;
              var active = list.querySelector('.is-active');
              if (!active) return;
              var centerActive = function () {
                if (!window.matchMedia('(max-width: 768px)').matches) return;
                var listBox = list.getBoundingClientRect();
                var itemBox = active.getBoundingClientRect();
                list.scrollLeft += itemBox.left + itemBox.width / 2 - (listBox.left + listBox.width / 2);
              };
              centerActive();
              window.addEventListener('load', centerActive, { once: true });
            })();
          </script>
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: true,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    section_id: section.id,
                    hide_from_prefix: true
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
  </div>
</div>

