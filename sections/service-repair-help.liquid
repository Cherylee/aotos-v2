{%- endcapture -%}
{%- capture sr_ico_headset_orange -%}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M8 16a8 8 0 1 1 16 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="5.5" y="14.5" width="5" height="8" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="21.5" y="14.5" width="5" height="8" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M24 22.5V24a3.5 3.5 0 0 1-3.5 3.5H16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{%- endcapture -%}
{%- capture sr_ico_people -%}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="11" r="3.2" stroke="#111" stroke-width="1.6"/><path d="M10 24c.6-3.4 3-5.2 6-5.2s5.4 1.8 6 5.2" stroke="#111" stroke-width="1.6" stroke-linecap="round"/><circle cx="8.5" cy="12.5" r="2.4" stroke="#111" stroke-width="1.6"/><path d="M4.5 23c.5-2.4 2.2-3.7 4.2-3.7" stroke="#111" stroke-width="1.6" stroke-linecap="round"/><circle cx="23.5" cy="12.5" r="2.4" stroke="#111" stroke-width="1.6"/><path d="M27.5 23c-.5-2.4-2.2-3.7-4.2-3.7" stroke="#111" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- endcapture -%}
{%- capture sr_ico_refresh -%}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M7 16a9 9 0 0 1 15.4-6.3L25 12" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M25 7v5h-5M25 16a9 9 0 0 1-15.4 6.3L7 20" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 25v-5h5" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}
{%- capture sr_ico_book -%}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 8c-2.4-1.8-6-2.4-10-1.2v16.5c4.2-1.2 7.8-.4 10 1.4 2.2-1.8 5.8-2.6 10-1.4V6.8C22 5.6 18.4 6.2 16 8Z" stroke="#111" stroke-width="1.6" stroke-linejoin="round"/><path d="M16 8v16.7" stroke="#111" stroke-width="1.6"/></svg>
{%- endcapture -%}

<section class="sr-help" id="sr-help-{{ section.id }}">
  <div class="sr-help__shell">
    {%- assign hi_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'highlight' -%}
        {%- assign hi_count = hi_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if hi_count > 0 -%}
      <div class="sr-help__highlights">
        {%- for block in section.blocks -%}
          {%- if block.type != 'highlight' -%}{%- continue -%}{%- endif -%}
          {%- assign tag = 'div' -%}
          {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
          <{{ tag }}
            class="sr-help__hi"
            {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="sr-help__hi-icon">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 80 }}" width="80" height="80" alt="" loading="lazy">
              {%- else -%}
                {%- case block.settings.icon_key -%}
                  {%- when 'gear' -%}{{ sr_ico_gear }}
                  {%- when 'headset' -%}{{ sr_ico_headset }}
                  {%- when 'people' -%}{{ sr_ico_people }}
                  {%- else -%}{{ sr_ico_shield }}
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}
              <p class="sr-help__hi-title">{{ block.settings.title }}</p>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.policies_heading != blank -%}
      <h2 class="sr-help__heading aotos-section-title">{{ section.settings.policies_heading }}</h2>
    {%- endif -%}

    <div class="sr-help__policies">
      {%- for block in section.blocks -%}
        {%- if block.type != 'policy' -%}{%- continue -%}{%- endif -%}
        <article class="sr-help__card" {{ block.shopify_attributes }}>
          <div class="sr-help__card-icon">
            {%- if block.settings.icon != blank -%}
              <img src="{{ block.settings.icon | image_url: width: 80 }}" width="80" height="80" alt="" loading="lazy">
            {%- else -%}
              {%- case block.settings.icon_key -%}
                {%- when 'refresh' -%}{{ sr_ico_refresh }}
                {%- when 'book' -%}{{ sr_ico_book }}
                {%- else -%}{{ sr_ico_shield }}
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div>
            {%- if block.settings.title != blank -%}
              <h3 class="sr-help__card-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="sr-help__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              {%- liquid
                assign card_link_label = block.settings.link_label | strip
                assign card_link_arrow = '→'
                if card_link_label contains '→'
                  assign card_link_text = card_link_label | split: '→' | first | strip
                else
                  assign card_link_text = card_link_label
                endif
              -%}
              <a class="sr-help__card-link" href="{{ block.settings.link | default: '#' }}">
                <span class="sr-help__card-link-text">{{ card_link_text }}</span>
                <span class="sr-help__card-link-arrow" aria-hidden="true">{{ card_link_arrow }}</span>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="sr-help__cta">
      <div
        class="sr-help__cta-media{% if section.settings.cta_image != blank %} sr-help__cta-media--custom{% endif %}"
        style="color: {{ cta_icon_color }};{% if section.settings.cta_image != blank %} --sr-help-cta-mask: url({{ section.settings.cta_image | image_url: width: 160 }});{% endif %}"
      >
        {%- if section.settings.cta_image != blank -%}
          <img
            src="{{ section.settings.cta_image | image_url: width: 280 }}"
            srcset="{{ section.settings.cta_image | image_url: width: 240 }} 240w, {{ section.settings.cta_image | image_url: width: 280 }} 280w, {{ section.settings.cta_image | image_url: width: 400 }} 400w"
            sizes="(max-width: 749px) 92vw, 120px"
            width="280"
            height="{{ 280 | divided_by: section.settings.cta_image.aspect_ratio | round }}"
            alt="{{ section.settings.cta_title | escape }}"
            loading="lazy"
          >
        {%- else -%}
          {{ sr_ico_headset_orange }}
        {%- endif -%}
      </div>
      <div class="sr-help__cta-copy">
        {%- if section.settings.cta_title != blank -%}
          <h2 class="sr-help__cta-title">{{ section.settings.cta_title }}</h2>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <p class="sr-help__cta-text">{{ section.settings.cta_text }}</p>
        {%- endif -%}
        {%- if section.settings.phone != blank or section.settings.email != blank -%}
          <div class="sr-help__contacts">
            {%- if section.settings.phone != blank -%}
              <a class="sr-help__contact" href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.2 2.8h2.2l.9 2.3-1.2 1.2a9 9 0 0 0 4.6 4.6l1.2-1.2 2.3.9v2.2c0 .6-.5 1.1-1.1 1.1C6.6 14 2 9.4 2 3.9c0-.6.5-1.1 1.2-1.1Z" stroke="{{ accent }}" stroke-width="1.3" stroke-linejoin="round"/></svg>
                <span>
                  <span class="sr-help__phone">{{ section.settings.phone }}</span>
                  {%- if section.settings.hours != blank -%}
                    <span class="sr-help__hours">{{ section.settings.hours }}</span>
                  {%- endif -%}
                </span>
              </a>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <a class="sr-help__contact" href="mailto:{{ section.settings.email }}">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.2" stroke="{{ accent }}" stroke-width="1.3"/><path d="m2.5 4.5 5.5 4 5.5-4" stroke="{{ accent }}" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="sr-help__email">{{ section.settings.email }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="sr-help__btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
