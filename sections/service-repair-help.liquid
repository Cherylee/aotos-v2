{%- endcapture -%}
{%- capture sr_ico_gear -%}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="4" stroke="#111" stroke-width="1.6"/><path d="M16 6v2.5M16 23.5V26M6 16h2.5M23.5 16H26M8.9 8.9l1.8 1.8M21.3 21.3l1.8 1.8M8.9 23.1l1.8-1.8M21.3 10.7l1.8-1.8" stroke="#111" stroke-width="1.6" stroke-linecap="round"/></svg>
{%- endcapture -%}
{%- capture sr_ico_headset -%}
