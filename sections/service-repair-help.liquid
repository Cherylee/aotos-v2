{%- liquid
  assign accent = section.settings.accent_color | default: '#ff6501'
  assign cta_icon_color = section.settings.cta_icon_color | default: '#ff6501'
-%}

{% style %}
  body:has(.sr-help) #MainContent > .shopify-section.section + .shopify-section.section {
    margin-top: 0;
  }

  #sr-help-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#ffffff' }};
    color: #000000;
    font-family: var(--font-body-family);
    padding-top: calc(0 * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80 }} * var(--rem));
  }

  #sr-help-{{ section.id }} * {
    box-sizing: border-box;
  }

  #sr-help-{{ section.id }} .sr-help__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
  }

  #sr-help-{{ section.id }} .sr-help__highlights {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 calc(80 * var(--rem));
    border: 1px solid #e8e8e8;
    border-radius: calc(8 * var(--rem));
    background: #ffffff;
  }

  #sr-help-{{ section.id }} .sr-help__hi {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(10 * var(--rem));
    min-height: calc(72 * var(--rem));
    padding: calc(16 * var(--rem)) calc(12 * var(--rem));
    text-align: left;
    text-decoration: none;
    color: #000000;
  }

  #sr-help-{{ section.id }} .sr-help__hi:not(:last-child) {
    border-right: 1px solid #e8e8e8;
  }

  #sr-help-{{ section.id }} .sr-help__hi-icon,
  #sr-help-{{ section.id }} .sr-help__hi-icon svg,
  #sr-help-{{ section.id }} .sr-help__hi-icon img {
    display: block;
    width: calc(20 * var(--rem));
    height: calc(20 * var(--rem));
    flex-shrink: 0;
    object-fit: contain;
  }

  #sr-help-{{ section.id }} .sr-help__hi-title {
    margin: 0;
    font-size: calc(12 * var(--rem));
    font-weight: 500;
    line-height: calc(18 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__heading {
    margin: 0 0 calc(48 * var(--rem));
    color: #000000;
    font-size: var(--aotos-section-title-size);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  #sr-help-{{ section.id }} .sr-help__policies {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(16 * var(--rem));
    margin: 0 0 calc(80 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__card {
    display: flex;
    align-items: flex-start;
    gap: calc(16 * var(--rem));
    padding: calc(24 * var(--rem));
    border: 1px solid #e8e8e8;
    border-radius: calc(8 * var(--rem));
    background: #ffffff;
  }

  #sr-help-{{ section.id }} .sr-help__card-icon,
  #sr-help-{{ section.id }} .sr-help__card-icon svg,
  #sr-help-{{ section.id }} .sr-help__card-icon img {
    display: block;
    width: calc(30 * var(--rem));
    height: calc(30 * var(--rem));
    flex-shrink: 0;
    object-fit: contain;
  }

  #sr-help-{{ section.id }} .sr-help__card-title {
    margin: 0 0 calc(6 * var(--rem));
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 500;
    line-height: calc(22 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__card-text {
    margin: 0 0 calc(12 * var(--rem));
    color: #999999;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__card-link {
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--rem));
    color: {{ accent }};
    font-size: calc(10 * var(--rem));
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #sr-help-{{ section.id }} .sr-help__card-link-text,
  #sr-help-{{ section.id }} .sr-help__card-link-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  #sr-help-{{ section.id }} .sr-help__cta {
    display: flex;
    align-items: center;
    gap: calc(24 * var(--rem));
    padding: calc(24 * var(--rem)) calc(32 * var(--rem));
    border-radius: calc(8 * var(--rem));
    background: {{ section.settings.cta_background | default: '#f5f5f5' }};
  }

  #sr-help-{{ section.id }} .sr-help__cta-media {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(120 * var(--rem));
    height: calc(120 * var(--rem));
    overflow: hidden;
    border-radius: calc(8 * var(--rem));
    background: #ffffff;
    color: #ff6501;
  }

  #sr-help-{{ section.id }} .sr-help__cta-media img,
  #sr-help-{{ section.id }} .sr-help__cta-media svg {
    display: block;
    width: calc(56 * var(--rem));
    height: calc(56 * var(--rem));
    object-fit: contain;
    color: inherit;
  }

  #sr-help-{{ section.id }} .sr-help__cta-media--custom::after {
    content: '';
    display: block;
    width: calc(56 * var(--rem));
    height: calc(56 * var(--rem));
    background-color: currentColor;
    -webkit-mask-image: var(--sr-help-cta-mask);
    mask-image: var(--sr-help-cta-mask);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  #sr-help-{{ section.id }} .sr-help__cta-media--custom img {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }

  #sr-help-{{ section.id }} .sr-help__cta-copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  #sr-help-{{ section.id }} .sr-help__cta-title {
    margin: 0 0 calc(8 * var(--rem));
    color: #000000;
    font-size: calc(20 * var(--rem));
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
  }

  #sr-help-{{ section.id }} .sr-help__cta-text {
    margin: 0;
    color: #000000;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
    text-align: left;
  }

  #sr-help-{{ section.id }} .sr-help__contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--rem)) calc(24 * var(--rem));
    margin-top: calc(12 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__contact {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--rem));
    text-decoration: none;
    color: inherit;
  }

  #sr-help-{{ section.id }} .sr-help__contact svg {
    width: calc(16 * var(--rem));
    height: calc(16 * var(--rem));
    flex-shrink: 0;
  }

  #sr-help-{{ section.id }} .sr-help__phone {
    color: {{ accent }};
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__hours {
    display: block;
    margin-top: calc(2 * var(--rem));
    color: #000000;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__email {
    color: #000000;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #sr-help-{{ section.id }} .sr-help__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: auto;
    min-height: calc(40 * var(--rem));
    padding: 0 calc(24 * var(--rem));
    border-radius: calc(4 * var(--rem));
    background: {{ accent }};
    color: #ffffff;
    font-size: calc(12 * var(--rem));
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  @media (hover: hover) {
    #sr-help-{{ section.id }} .sr-help__card-link:hover .sr-help__card-link-text {
      transform: translateX(calc(-4 * var(--rem)));
    }

    #sr-help-{{ section.id }} .sr-help__card-link:hover .sr-help__card-link-arrow {
      transform: translateX(calc(6 * var(--rem)));
    }

    #sr-help-{{ section.id }} .sr-help__btn:hover {
      opacity: 0.88;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sr-help-{{ section.id }} .sr-help__card-link-text,
    #sr-help-{{ section.id }} .sr-help__card-link-arrow {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    #sr-help-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88 }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88 }} * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__shell {
      width: 100%;
      padding: 0 calc(40 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: calc(88 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__hi {
      justify-content: flex-start;
      min-height: calc(88 * var(--rem));
      padding: calc(24 * var(--rem));
      gap: calc(24 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__hi:not(:last-child) {
      border-right: 0;
      border-bottom: 0;
    }

    #sr-help-{{ section.id }} .sr-help__hi:nth-child(odd) {
      border-right: 1px solid #e8e8e8;
    }

    #sr-help-{{ section.id }} .sr-help__hi:nth-child(-n + 2) {
      border-bottom: 1px solid #e8e8e8;
    }

    #sr-help-{{ section.id }} .sr-help__hi-icon,
    #sr-help-{{ section.id }} .sr-help__hi-icon svg,
    #sr-help-{{ section.id }} .sr-help__hi-icon img {
      width: calc(40 * var(--rem));
      height: calc(40 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__hi-title {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__heading {
      margin-bottom: calc(48 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__policies {
      grid-template-columns: 1fr;
      gap: calc(24 * var(--rem));
      margin-bottom: calc(88 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__card-title {
      font-size: calc(28 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__card-text {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__card-link {
      font-size: calc(20 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__cta {
      flex-direction: column;
      align-items: stretch;
      padding: calc(32 * var(--rem));
      gap: calc(24 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__cta-media {
      width: calc(160 * var(--rem));
      height: calc(160 * var(--rem));
      aspect-ratio: auto;
      margin: 0 auto;
    }

    #sr-help-{{ section.id }} .sr-help__cta-media img,
    #sr-help-{{ section.id }} .sr-help__cta-media svg,
    #sr-help-{{ section.id }} .sr-help__cta-media--custom::after {
      width: calc(72 * var(--rem));
      height: calc(72 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__cta-title {
      font-size: calc(38 * var(--rem));
      text-align: center;
    }

    #sr-help-{{ section.id }} .sr-help__cta-text {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
      text-align: center;
    }

    #sr-help-{{ section.id }} .sr-help__contacts {
      flex-direction: column;
      align-items: center;
      gap: calc(16 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__contact {
      justify-content: center;
    }

    #sr-help-{{ section.id }} .sr-help__phone,
    #sr-help-{{ section.id }} .sr-help__email {
      font-size: calc(24 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__hours {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__btn {
      width: 100%;
      margin-left: 0;
      min-height: calc(72 * var(--rem));
      font-size: calc(22 * var(--rem));
    }
    #sr-help-{{ section.id }} .sr-help__card-icon,
    #sr-help-{{ section.id }} .sr-help__card-icon svg,
    #sr-help-{{ section.id }} .sr-help__card-icon img {
      display: block;
      width: calc(60 * var(--rem));
      height: calc(60 * var(--rem));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    #sr-help-{{ section.id }} {
      padding-top: calc(168 * var(--rem));
      padding-bottom: calc(168 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__shell {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 calc(34 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #sr-help-{{ section.id }} .sr-help__policies {
      grid-template-columns: 1fr;
    }

    #sr-help-{{ section.id }} .sr-help__hi:not(:last-child) {
      border-right: 0;
      border-bottom: 0;
    }

    #sr-help-{{ section.id }} .sr-help__hi:nth-child(odd) {
      border-right: 1px solid #e8e8e8;
    }

    #sr-help-{{ section.id }} .sr-help__hi:nth-child(-n + 2) {
      border-bottom: 1px solid #e8e8e8;
    }

    #sr-help-{{ section.id }} .sr-help__heading {
      margin-bottom: calc(90 * var(--rem));
    }

    #sr-help-{{ section.id }} .sr-help__cta {
      flex-direction: column;
      align-items: stretch;
    }

    #sr-help-{{ section.id }} .sr-help__btn {
      width: 100%;
      margin-left: 0;
      min-height: calc(52 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sr-help-{{ section.id }} .sr-help__btn {
      transition: none;
    }
  }
{% endstyle %}

{%- capture sr_ico_shield -%}
