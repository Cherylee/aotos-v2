{{ 'l2-page.css' | asset_url | stylesheet_tag }}
<section class="l2-band l2-video" id="l2-video-{{ section.id }}">
  <div class="l2-video__pin">
    {%- if section.settings.title != blank -%}
      <div class="l2-video__head">
        <h2 class="l2-video__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    <div class="l2-video__stage">
      <div class="l2-video__frame">
        {%- if section.settings.video != blank -%}
          <div class="l2-video__desktop">
            {{ section.settings.video | video_tag: image_size: '1600x', autoplay: false, loop: false, controls: false, muted: false, playsinline: true, preload: 'metadata' }}
          </div>
        {%- endif -%}
        {%- assign l2_video_mobile = section.settings.video_mobile | default: section.settings.video -%}
        {%- if l2_video_mobile != blank -%}
          <div class="l2-video__mobile">
            {{ l2_video_mobile | video_tag: image_size: '900x', autoplay: false, loop: false, controls: false, muted: false, playsinline: true, preload: 'metadata' }}
          </div>
        {%- endif -%}
        <button type="button" class="l2-video__play" data-l2-play aria-label="Play">
          <span>PLAY</span>
        </button>
      </div>
    </div>
  </div>
</section>
<script>
  (function () {
    var root = document.getElementById('l2-video-{{ section.id }}');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    var head = root.querySelector('.l2-video__head');
    var stage = root.querySelector('.l2-video__stage');
    var button = root.querySelector('[data-l2-play]');
    var cursor = button && button.querySelector('span');
    if (!stage || !button) return;
    var mobileQuery = window.matchMedia('(max-width: 768px)');
    var fineQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
    var reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var held = false;
    var starting = false;
    var shown = 0;
    var goal = 0;
    var smoothing = false;
    root.querySelectorAll('video').forEach(function (item) {
      item.controls = false;
      item.addEventListener('play', function () {
        root.classList.add('is-playing');
      });
      item.addEventListener('pause', function () {
        root.classList.remove('is-playing');
      });
    });

    function video() {
      var box = root.querySelector(mobileQuery.matches ? '.l2-video__mobile' : '.l2-video__desktop');
      return box && box.querySelector('video');
    }

    function rem() {
      return window.innerWidth / (mobileQuery.matches ? 750 : 1440);
    }

    function ease(value) {
      return value * value * (3 - 2 * value);
    }

    function paint(progress) {
      var first = Math.min(1, Math.max(0, progress * 2));
      var second = Math.min(1, Math.max(0, progress * 2 - 1));
      var grow = ease(second);
      var shift = 150 * rem();
      if (head) {
        head.style.transform = 'translateY(' + (-(shift * ease(first) + shift * grow)) + 'px)';
        head.style.opacity = String(first < 1 ? 1 - 0.5 * ease(first) : 0.5 * (1 - grow));
      }
      var scale = 0.4 + 0.6 * grow;
      var drop = (1 - grow) * 140 * rem();
      stage.style.transform = 'translate(-50%, -50%) translateY(' + drop + 'px) scale(' + scale + ')';
      var current = video();
      if (!current) return;
      if (grow > 0.98 && !held && current.paused && !starting) {
        starting = true;
        var playAttempt = current.play();
        if (playAttempt && playAttempt.finally) {
          playAttempt.finally(function () { starting = false; });
        } else {
          starting = false;
        }
        if (playAttempt && playAttempt.catch) {
          playAttempt.catch(function () {
            current.muted = true;
            current.play();
          });
        }
      } else if (grow < 0.98 && !current.paused) {
        current.pause();
      }
    }

    function readGoal() {
      var rect = root.getBoundingClientRect();
      var distance = root.offsetHeight - window.innerHeight - 500 * rem();
      goal = distance <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / distance));
    }

    function step() {
      shown += (goal - shown) * 0.08;
      if (Math.abs(goal - shown) < 0.001) {
        shown = goal;
        smoothing = false;
      }
      paint(shown);
      if (smoothing) requestAnimationFrame(step);
    }

    function requestPaint() {
      if (reduceQuery.matches) return;
      readGoal();
      if (smoothing) return;
      smoothing = true;
      requestAnimationFrame(step);
    }

    button.addEventListener('click', function () {
      var current = video();
      if (!current) return;
      if (current.paused) {
        held = false;
        current.play();
        root.classList.add('is-playing');
      } else {
        held = true;
        current.pause();
        root.classList.remove('is-playing');
      }
    });

    if (fineQuery.matches && cursor) {
      button.addEventListener('mouseenter', function () {
        cursor.style.opacity = '1';
      });
      button.addEventListener('mouseleave', function () {
        cursor.style.opacity = '0';
      });
      button.addEventListener('mousemove', function (event) {
        var rect = button.getBoundingClientRect();
        cursor.style.transition = 'transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1)';
        cursor.style.transform = 'translate(' + (event.clientX - rect.left) + 'px, ' + (event.clientY - rect.top) + 'px) translate(-50%, -50%)';
      });
    }

    if (!reduceQuery.matches) {
      window.addEventListener('scroll', requestPaint, { passive: true });
      window.addEventListener('resize', requestPaint);
      onScroll();
    }
  })();
</script>
{% schema %}
{
  "name": "L2 Video",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "html", "id": "title", "label": "标题", "default": "Travel Smart, <br>Arrive in Style." },
    { "type": "video", "id": "video", "label": "电脑视频" },
    { "type": "video", "id": "video_mobile", "label": "手机视频" }
  ],
  "presets": [{ "name": "L2 Video" }]
}
{% endschema %}
