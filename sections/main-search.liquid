{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.image_shape == 'blob' -%}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

{% style %}
  .aotos-search-{{ section.id }} {
    background: #fff;
    width: 100%;
  }

  .aotos-search-{{ section.id }} .aotos-search__inner {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
    box-sizing: border-box;
  }

  .aotos-search-{{ section.id }} .aotos-search__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .aotos-search-{{ section.id }} .aotos-search__bar {
    width: calc(520 * var(--rem));
    max-width: 100%;
    margin: 0 auto calc(40 * var(--rem));
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .search {
    margin: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .field {
    margin: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .field__input {
    min-height: calc(var(--aotos-button-height, 40) * var(--rem));
    height: calc(var(--aotos-button-height, 40) * var(--rem));
    padding: 0 calc(48 * var(--rem)) 0 calc(18 * var(--rem));
    border-radius: var(--buttons-radius, calc(40 * var(--rem)));
    font-size: calc(14 * var(--rem));
    font-weight: 400;
    color: #000000;
    background: #fff;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .field__label {
    display: none;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .reset__button,
  .aotos-search-{{ section.id }} .aotos-search__bar .search__button {
    top: 50%;
    transform: translateY(-50%);
    width: calc(36 * var(--rem));
    height: calc(36 * var(--rem));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .field__button > .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(18 * var(--rem));
    height: calc(18 * var(--rem));
    margin: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__bar .field__button svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .aotos-search-{{ section.id }} .aotos-search__empty {
    margin: 0;
    text-align: center;
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
    color: #999999;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets-container {
    padding-top: 0;
    padding-bottom: calc(20 * var(--rem));
    margin-bottom: calc(24 * var(--rem));
    border-bottom: 1px solid #f1f1f1;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__form {
    align-items: center;
    gap: 0 calc(16 * var(--rem));
    margin-bottom: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__wrapper,
  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters,
  .aotos-search-{{ section.id }} .aotos-search__facets .product-count {
    align-self: center;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__heading,
  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__label,
  .aotos-search-{{ section.id }} .aotos-search__facets .product-count__text {
    display: flex;
    align-items: center;
    margin: 0 calc(10 * var(--rem)) 0 0;
    text-transform: none;
    letter-spacing: normal;
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    line-height: 1;
    color: #000000;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__disclosure {
    margin: 0 calc(8 * var(--rem)) 0 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary {
    display: flex;
    align-items: center;
    min-height: calc(36 * var(--rem));
    margin: 0;
    padding: 0 calc(14 * var(--rem));
    border: 1px solid #e4e4e4;
    border-radius: calc(40 * var(--rem));
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    color: #000000;
    background: #fff;
    box-sizing: border-box;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary:hover,
  .aotos-search-{{ section.id }} .aotos-search__facets .facets__disclosure[open] .facets__summary {
    color: #000000;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary:hover .facets__summary-label,
  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary span:first-of-type {
    text-decoration: none;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary > div,
  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary > span {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--rem));
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary .icon-caret,
  .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary .svg-wrapper {
    position: static;
    width: calc(10 * var(--rem));
    height: calc(6 * var(--rem));
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters {
    padding-left: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__field .select {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: calc(36 * var(--rem));
    padding-right: calc(28 * var(--rem));
    border: 1px solid #e4e4e4;
    border-radius: calc(40 * var(--rem));
    background: #fff;
    box-sizing: border-box;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort {
    min-height: calc(36 * var(--rem));
    padding: 0 calc(8 * var(--rem)) 0 calc(14 * var(--rem));
    border: 0;
    border-radius: 0;
    font-size: calc(10 * var(--rem));
    color: #000000;
    background: transparent;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__field .icon-caret,
  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort + .icon-caret {
    right: calc(12 * var(--rem));
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort:focus,
  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort:focus-visible,
  .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort.focused,
  .aotos-search-{{ section.id }} .aotos-search__facets .select__select:focus,
  .aotos-search-{{ section.id }} .aotos-search__facets .select__select:focus-visible {
    outline: none;
    box-shadow: none;
    border-color: #e4e4e4;
  }

  .aotos-search-{{ section.id }} .aotos-search__group {
    margin: 0 0 calc(48 * var(--rem));
  }

  .aotos-search-{{ section.id }} .aotos-search__group:last-child {
    margin-bottom: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__group-title {
    margin: 0 0 calc(20 * var(--rem));
    font-size: calc(14 * var(--rem));
    font-weight: 700;
    line-height: 1.3;
    color: #000000;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
    gap: calc(18 * var(--rem));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles {
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__content {
    background: #f5f5f5;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(12 * var(--rem));
    padding: calc(16 * var(--rem));
    box-sizing: border-box;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__badge,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__badge.top,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__badge.bottom,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__badge.left,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__badge.right {
    position: static;
    inset: auto;
    margin: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__information {
    padding: 0;
    width: 100%;
  }

  .aotos-search-{{ section.id }} .card-wrapper {
    height: 100%;
  }

  .aotos-search-{{ section.id }} .card {
    position: relative;
    border-radius: calc(12 * var(--rem));
    overflow: hidden;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card,
  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card {
    background: #fff;
    box-shadow: 0 calc(6 * var(--rem)) calc(20 * var(--rem)) rgba(0, 0, 0, 0.08);
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner {
    background: #fff;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner {
    padding: calc(28 * var(--rem)) calc(24 * var(--rem)) calc(8 * var(--rem));
    box-sizing: border-box;
    --ratio-percent: 100%;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner.ratio::before {
    padding-bottom: 100%;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__media,
  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner .media {
    inset: 0;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner .media img {
    position: absolute;
    inset: 0;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0 auto;
    object-fit: contain;
    object-position: center center;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__inner {
    padding: 0;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__media,
  .aotos-search-{{ section.id }} .aotos-search__grid--articles .article-card__image-wrapper {
    margin: 0;
    width: 100%;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .media img {
    object-fit: cover;
    object-position: center;
  }

  .aotos-search-{{ section.id }} .card__badge,
  .aotos-search-{{ section.id }} .card__badge.top,
  .aotos-search-{{ section.id }} .card__badge.bottom,
  .aotos-search-{{ section.id }} .card__badge.left,
  .aotos-search-{{ section.id }} .card__badge.right {
    position: absolute;
    top: calc(12 * var(--rem));
    left: calc(12 * var(--rem));
    right: auto;
    bottom: auto;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: calc(6 * var(--rem));
    align-self: flex-start;
    justify-self: flex-start;
    grid-row-start: 1;
    margin: 0;
  }

  .aotos-search-{{ section.id }} .badge {
    background: var(--aotos-theme-color, #ff6501);
    color: #fff;
    border: 0;
    border-radius: calc(40 * var(--rem));
    padding: calc(4 * var(--rem)) calc(10 * var(--rem));
    font-size: calc(12 * var(--rem));
    font-weight: 600;
    line-height: 1.2;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .badge,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .badge {
    background: #000000;
    color: #fff;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__information {
    padding: calc(6 * var(--rem)) calc(12 * var(--rem)) calc(12 * var(--rem));
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__information {
    padding: calc(12 * var(--rem)) calc(16 * var(--rem)) calc(16 * var(--rem));
    box-sizing: border-box;
  }

  .aotos-search-{{ section.id }} .card__heading {
    margin: 0 0 calc(2 * var(--rem));
    width: 100%;
    min-width: 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(16 * var(--rem));
    font-weight: 500;
    color: #000000;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .aotos-search-{{ section.id }} .card__heading a {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__heading,
  .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__heading a {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__heading,
  .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__heading a {
    display: block;
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
    word-break: break-word;
  }

  .aotos-search-{{ section.id }} .card-information {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: calc(2 * var(--rem));
  }

  .aotos-search-{{ section.id }} .card-information > .caption-large {
    display: none;
  }

  .aotos-search-{{ section.id }} .rating-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: 100%;
    margin: 0;
    gap: calc(6 * var(--rem));
  }

  .aotos-search-{{ section.id }} .rating {
    display: inline-flex;
    align-items: center;
    gap: calc(2 * var(--rem));
    margin: 0;
    line-height: 1;
  }

  .aotos-search-{{ section.id }} .rating-star-icon {
    display: block;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    flex: 0 0 auto;
    overflow: visible;
  }

  .aotos-search-{{ section.id }} .rating-star-icon .rating-star-outline {
    fill: none;
    stroke: var(--aotos-theme-color, #ff6501);
    stroke-width: 1.8;
  }

  .aotos-search-{{ section.id }} .rating-star-icon.is-filled .rating-star-outline {
    fill: var(--aotos-theme-color, #ff6501);
  }

  .aotos-search-{{ section.id }} .rating-star-icon.is-half .rating-star-fill {
    fill: var(--aotos-theme-color, #ff6501);
    stroke: none;
  }

  .aotos-search-{{ section.id }} .rating-count {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(14 * var(--rem));
    font-weight: 400;
    letter-spacing: 0;
    color: #999999;
  }

  .aotos-search-{{ section.id }} .price {
    width: auto;
    max-width: 100%;
    margin: calc(2 * var(--rem)) 0 0;
    font-size: calc(12 * var(--rem));
    font-weight: 600;
    line-height: calc(16 * var(--rem));
    color: #000000;
    white-space: nowrap;
  }

  .aotos-search-{{ section.id }} .price .price-item {
    margin: 0;
  }

  .aotos-search-{{ section.id }} .price__sale {
    display: none;
  }

  .aotos-search-{{ section.id }} .price--on-sale .price__regular {
    display: none;
  }

  .aotos-search-{{ section.id }} .price--on-sale .price__sale {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: baseline;
    white-space: nowrap;
    gap: calc(6 * var(--rem));
  }

  .aotos-search-{{ section.id }} .price__sale > .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .aotos-search-{{ section.id }} .price__sale > .price-item--sale {
    order: 1;
  }

  .aotos-search-{{ section.id }} .price__sale > span:has(s) {
    order: 2;
  }

  .aotos-search-{{ section.id }} .price--on-sale .price-item--sale::before {
    content: 'From ';
    font-weight: 600;
  }

  .aotos-search-{{ section.id }} .price--on-sale .price-item--sale,
  .aotos-search-{{ section.id }} .price--on-sale .price-item--last {
    color: var(--aotos-theme-color, #ff6501);
  }

  .aotos-search-{{ section.id }} .price--on-sale .price-item--regular {
    color: #999999;
    font-size: calc(10 * var(--rem));
    font-weight: 400;
    line-height: calc(14 * var(--rem));
  }

  @media screen and (max-width: 768px) {
    .aotos-search-{{ section.id }} .aotos-search__inner {
      width: 100%;
      padding: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem)) calc(40 * var(--rem)) calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar {
      width: 100%;
      margin-bottom: calc(32 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar .field__input {
      min-height: calc(var(--aotos-button-height-mobile, 80) * var(--rem));
      height: calc(var(--aotos-button-height-mobile, 80) * var(--rem));
      font-size: max(16px, calc(22 * var(--rem)));
      padding-left: calc(28 * var(--rem));
      padding-right: calc(120 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar .reset__button,
    .aotos-search-{{ section.id }} .aotos-search__bar .search__button {
      width: calc(64 * var(--rem));
      height: calc(64 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar .search__button {
      right: calc(8 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar .reset__button {
      right: calc(72 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__bar .field__button > .svg-wrapper {
      width: calc(32 * var(--rem));
      height: calc(32 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__empty {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__group-title {
      margin-bottom: calc(24 * var(--rem));
      font-size: calc(28 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__grid,
    .aotos-search-{{ section.id }} .aotos-search__grid--articles,
    .aotos-search-{{ section.id }} .aotos-search__grid--pages {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(24 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary,
    .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__field .select {
      min-height: calc(64 * var(--rem));
      border-radius: calc(40 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .facets__summary,
    .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__sort {
      font-size: calc(16 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .facets__heading,
    .aotos-search-{{ section.id }} .aotos-search__facets .facet-filters__label,
    .aotos-search-{{ section.id }} .aotos-search__facets .product-count__text {
      font-size: calc(16 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__inner {
      padding: calc(48 * var(--rem)) calc(96 * var(--rem)) calc(24 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__inner.ratio::before,
    .aotos-search-{{ section.id }} .aotos-search__grid--articles .media.ratio::before {
      padding-bottom: 52%;
    }

    .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__media,
    .aotos-search-{{ section.id }} .aotos-search__grid--articles .media {
      max-height: calc(360 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__grid .product-card-wrapper .card__information,
    .aotos-search-{{ section.id }} .aotos-search__grid--articles .card__information {
      padding: calc(16 * var(--rem)) calc(32 * var(--rem)) calc(20 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__grid--pages .card__content {
      padding: calc(24 * var(--rem)) calc(32 * var(--rem));
      gap: calc(16 * var(--rem));
    }

    .aotos-search-{{ section.id }} .card__heading {
      font-size: calc(28 * var(--rem));
      line-height: calc(36 * var(--rem));
    }

    .aotos-search-{{ section.id }} .rating-text,
    .aotos-search-{{ section.id }} .rating-count {
      font-size: calc(24 * var(--rem));
      line-height: calc(28 * var(--rem));
    }

    .aotos-search-{{ section.id }} .rating-star-icon {
      width: calc(28 * var(--rem));
      height: calc(28 * var(--rem));
    }

    .aotos-search-{{ section.id }} .price {
      font-size: calc(28 * var(--rem));
      line-height: calc(36 * var(--rem));
    }

    .aotos-search-{{ section.id }} .price--on-sale .price-item--regular {
      font-size: calc(22 * var(--rem));
      line-height: calc(28 * var(--rem));
    }

    .aotos-search-{{ section.id }} .badge {
      font-size: calc(22 * var(--rem));
      padding: calc(8 * var(--rem)) calc(18 * var(--rem));
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .facets-container {
      grid-template-columns: auto minmax(0, max-content);
    }

    .aotos-search-{{ section.id }} .aotos-search__facets facet-filters-form.small-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .facets.small-hide {
      display: none !important;
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__wrapper.medium-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__wrapper.large-up-hide {
      display: block !important;
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .active-facets-mobile.medium-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .active-facets-mobile.large-up-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .product-count.medium-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .product-count.large-up-hide {
      display: block !important;
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__open-label.medium-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__open-label.large-up-hide {
      display: inline !important;
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__heading.medium-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__heading.large-up-hide {
      display: block !important;
    }

    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__open-label.small-hide,
    .aotos-search-{{ section.id }} .aotos-search__facets .mobile-facets__heading.small-hide {
      display: none !important;
    }
  }
{% endstyle %}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{% paginate search.results by 24 %}
  {%- liquid
    assign has_products = false
    assign has_articles = false
    assign has_pages = false
    if search.performed
      for item in search.results
        if item.object_type == 'product'
          assign has_products = true
        elsif item.object_type == 'article'
          assign has_articles = true
        elsif item.object_type == 'page'
          assign has_pages = true
        endif
      endfor
    endif
  -%}

  <div class="aotos-search-{{ section.id }} template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %}">
    <div class="aotos-search__inner">
      <h1 class="aotos-search__title">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </h1>

      <div class="aotos-search__bar template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <label class="field__label" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>
                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>

      {%- if search.performed -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          <p class="aotos-search__empty" role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}

        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <div class="aotos-search__facets" id="main-search-filters" data-id="{{ section.id }}">
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div class="collection" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>

              {%- if has_products -%}
                <section class="aotos-search__group" aria-labelledby="SearchProducts-{{ section.id }}">
                  <h2 class="aotos-search__group-title" id="SearchProducts-{{ section.id }}">
                    {{ 'templates.search.products' | t }}
                  </h2>
                  <ul class="aotos-search__grid" role="list">
                {%- assign skip_card_product_styles = false -%}
                    {%- assign product_index = 0 -%}
                {%- for item in search.results -%}
                      {%- if item.object_type == 'product' -%}
                        {%- assign product_index = product_index | plus: 1 -%}
                    {%- assign lazy_load = true -%}
                        {%- if product_index <= 2 -%}
                          {%- assign lazy_load = false -%}
                  {%- endif -%}
                        <li>
                        {% render 'card-product',
                          card_product: item,
                            media_aspect_ratio: 'square',
                          image_shape: section.settings.image_shape,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_rating: section.settings.show_rating,
                          lazy_load: lazy_load,
                            skip_styles: skip_card_product_styles,
                            hide_from_prefix: true
                        %}
                        {%- assign skip_card_product_styles = true -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- if has_articles -%}
                <section class="aotos-search__group" aria-labelledby="SearchArticles-{{ section.id }}">
                  <h2 class="aotos-search__group-title" id="SearchArticles-{{ section.id }}">
                    {{ 'templates.search.articles' | t }}
                  </h2>
                  <ul class="aotos-search__grid aotos-search__grid--articles" role="list">
                    {%- for item in search.results -%}
                      {%- if item.object_type == 'article' -%}
                        <li>
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                            lazy_load: true
                          %}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- if has_pages -%}
                <section class="aotos-search__group" aria-labelledby="SearchPages-{{ section.id }}">
                  <h2 class="aotos-search__group-title" id="SearchPages-{{ section.id }}">
                    {{ 'templates.search.pages' | t }}
                  </h2>
                  <ul class="aotos-search__grid aotos-search__grid--pages" role="list">
                    {%- for item in search.results -%}
                      {%- if item.object_type == 'page' -%}
                        <li>
                          <div class="article-card-wrapper card-wrapper">
                            <div class="card card--card card--text">
                            <div class="card__content">
                                <div class="card__badge">
                                  <span class="badge color-scheme-1">{{ 'templates.search.page' | t }}</span>
                                </div>
                              <div class="card__information">
                                <h3 class="card__heading">
                                  <a href="{{ item.url }}" class="full-unstyled-link">
                                      {{ item.title | escape }}
                                  </a>
                                </h3>
                              </div>
                              </div>
                            </div>
                          </div>
                  </li>
                      {%- endif -%}
                {%- endfor -%}
              </ul>
                </section>
              {%- endif -%}

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      </div>
  </div>
{% endpaginate %}

{%- if section.settings.image_shape == 'arch' -%}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "t:sections.main-search.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.main-search.settings.image_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.main-search.settings.image_ratio.options__3.label" }
      ],
      "default": "adapt",
      "label": "t:sections.main-search.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "default", "label": "t:sections.all.image_shape.options__1.label" },
        { "value": "arch", "label": "t:sections.all.image_shape.options__2.label" },
        { "value": "blob", "label": "t:sections.all.image_shape.options__3.label" },
        { "value": "chevronleft", "label": "t:sections.all.image_shape.options__4.label" },
        { "value": "chevronright", "label": "t:sections.all.image_shape.options__5.label" },
        { "value": "diamond", "label": "t:sections.all.image_shape.options__6.label" },
        { "value": "parallelogram", "label": "t:sections.all.image_shape.options__7.label" },
        { "value": "round", "label": "t:sections.all.image_shape.options__8.label" }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "info": "t:sections.all.image_shape.info"
    },
    { "type": "checkbox", "id": "show_secondary_image", "default": false, "label": "t:sections.main-search.settings.show_secondary_image.label" },
    { "type": "checkbox", "id": "show_vendor", "default": false, "label": "t:sections.main-search.settings.show_vendor.label" },
    { "type": "checkbox", "id": "show_rating", "default": true, "label": "t:sections.main-search.settings.show_rating.label", "info": "t:sections.main-search.settings.show_rating.info" },
    { "type": "header", "content": "t:sections.main-collection-product-grid.settings.header__1.content" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label", "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info" },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        { "value": "horizontal", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label" },
        { "value": "vertical", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label" },
        { "value": "drawer", "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label" }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label",
      "info": "t:sections.main-collection-product-grid.settings.filter_type.info"
    },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label" },
    { "type": "header", "content": "t:sections.main-search.settings.header__2.content", "info": "t:sections.main-search.settings.header__2.info" },
    { "type": "checkbox", "id": "article_show_date", "default": false, "label": "t:sections.main-search.settings.article_show_date.label" },
    { "type": "checkbox", "id": "article_show_author", "default": false, "label": "t:sections.main-search.settings.article_show_author.label" },
    { "type": "header", "content": "t:sections.main-search.settings.header_mobile.content" },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "t:sections.main-search.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.main-search.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-search.settings.columns_mobile.options__2.label" }
      ]
    },
    { "type": "header", "content": "间距" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "上边距（PC）", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "下边距（PC）", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "上边距（手机）", "default": 88 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "下边距（手机）", "default": 88 }
  ]
}
{% endschema %}
