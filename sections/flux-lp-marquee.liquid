{% render 'flux-landing-assets' %}
<section
  class="flp flp-marquee"
  style="--pad-t: {{ section.settings.padding_top | default: 16, allow_false: true }}; --pad-b: {{ section.settings.padding_bottom | default: 16, allow_false: true }}; --pad-tm: {{ section.settings.padding_top_mobile | default: 24, allow_false: true }}; --pad-bm: {{ section.settings.padding_bottom_mobile | default: 24, allow_false: true }}; --flp-bg: {{ section.settings.bg_color }}; --flp-title: {{ section.settings.text_color }}; --flp-speed: {{ section.settings.speed }}s; color: {{ section.settings.text_color }}; border-top: 1px solid {{ section.settings.border_color }}; border-bottom: 1px solid {{ section.settings.border_color }};"
>
  <div class="flp-marquee__run">
    {%- for pass in (1..2) -%}
      {%- for block in section.blocks -%}
        <span>{{ block.settings.text | escape }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FLUX 跑马灯",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "背景", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "边框", "default": "#333333" },
    { "type": "range", "id": "speed", "min": 8, "max": 40, "step": 1, "unit": "s", "label": "速度", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "上边距", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "下边距", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "手机上边距", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "手机下边距", "default": 24 }
  ],
  "blocks": [
    { "type": "item", "name": "文字", "settings": [{ "type": "text", "id": "text", "label": "文字", "default": "Ride the future" }] }
  ],
  "presets": [{ "name": "FLUX 跑马灯" }]
}
{% endschema %}
