{{ 'aotos-bf.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .bf-helmet-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .bf-helmet-section {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }
  }
</style>

{%- assign bf_image = section.settings.image -%}

<section class="bf bf-helmet-section"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  <div class="bf-shell">
    <div class="bf-helmet">
      <div class="bf-helmet__visual">
        <span class="bf-helmet__rings" aria-hidden="true"></span>
        <div class="bf-helmet__img">
          {%- if bf_image != blank -%}
            <img
              class="bf-media-img"
              src="{{ bf_image | image_url: width: 720 }}"
              srcset="
                {{ bf_image | image_url: width: 480 }} 480w,
                {{ bf_image | image_url: width: 720 }} 720w,
                {{ bf_image | image_url: width: 960 }} 960w
              "
              sizes="(max-width: 768px) 60vw, 26vw"
              width="720"
              height="{{ 720 | divided_by: bf_image.aspect_ratio | round }}"
              alt="{{ bf_image.alt | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="bf-placeholder">{{ 'product-3' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.multiplier != blank -%}
          <span class="bf-helmet__x2">{{ section.settings.multiplier }}</span>
        {%- endif -%}
      </div>

      <div class="bf-helmet__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="bf-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bf-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="bf-text">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.highlight != blank -%}
          <p class="bf-helmet__highlight">{{ section.settings.highlight }}</p>
        {%- endif -%}
        {%- if section.settings.discount_code != blank or section.settings.button_label != blank -%}
          <div class="bf-helmet__actions">
            {%- if section.settings.discount_code != blank -%}
              <button type="button" class="bf-code" data-bf-code="{{ section.settings.discount_code | escape }}" aria-label="Copy discount code {{ section.settings.discount_code | escape }}">
                <span class="bf-code__value">{{ section.settings.discount_code }}</span>
                <svg class="bf-code__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="bf-code__hint" data-bf-code-hint aria-live="polite">Copy</span>
              </button>
            {%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a class="bf-btn bf-btn--primary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="bf-note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.__bfCodeCopy) {
    window.__bfCodeCopy = true;
    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-bf-code]');
      if (!btn || btn.dataset.copying === '1') return;
      var code = btn.getAttribute('data-bf-code');
      var hint = btn.querySelector('[data-bf-code-hint]');
      var finish = function () {
        if (!hint) return;
        var prev = hint.textContent;
        hint.textContent = 'Copied';
        btn.classList.add('is-copied');
        window.setTimeout(function () {
          hint.textContent = prev;
          btn.classList.remove('is-copied');
          btn.dataset.copying = '';
        }, 1600);
      };
      var fallbackCopy = function () {
        var input = document.createElement('textarea');
        input.value = code;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.left = '-999px';
        document.body.appendChild(input);
        input.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        input.remove();
        return ok;
      };
      btn.dataset.copying = '1';
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(finish).catch(function () {
          if (fallbackCopy()) finish();
          else btn.dataset.copying = '';
        });
      } else if (fallbackCopy()) {
        finish();
      } else {
        btn.dataset.copying = '';
      }
    });
  }
</script>

{% schema %}
{
  "name": "BF Part 03 头盔买一送一",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点 ID",
      "default": "part-03"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "头盔图（建议透明底）"
    },
    {
      "type": "text",
      "id": "multiplier",
      "label": "图片角标",
      "default": "×2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小标题",
      "default": "Part 03 / AOTOS logo helmet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "One for you. One for a friend."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述",
      "default": "Buy one AOTOS logo helmet and get a second one free. Ride together, stay protected together."
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "橙色强调文案",
      "default": "2 helmets for the price of 1"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "折扣码",
      "info": "显示在按钮上方，点击可复制。留空则不显示"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文案",
      "default": "Explore the helmet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "按钮下方小字",
      "default": "Add two helmets to your cart. The discount applies automatically at checkout."
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距 PC",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距 PC",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距 手机",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距 手机",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "BF Part 03 头盔买一送一"
    }
  ]
}
{% endschema %}
