{%- liquid
  assign umv_id = section.id
-%}

{% style %}
  #user-manuals-videos-{{ umv_id }} {
    display: block;
    width: 100%;
    background: #f5f5f5;
    color: #000000;
    font-family: var(--font-body-family);
    padding-top: 0;
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80 }} * var(--rem));
  }

  #user-manuals-videos-{{ umv_id }} * {
    box-sizing: border-box;
  }

  #user-manuals-videos-{{ umv_id }} .umv-shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
  }

  #user-manuals-videos-{{ umv_id }} .umv-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(16 * var(--rem));
    margin: 0 0 calc(48 * var(--rem));
  }

  #user-manuals-videos-{{ umv_id }} .umv-title {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--rem));
    margin: 0;
    font-size: calc(18 * var(--rem));
    line-height: calc(22 * var(--rem));
    font-weight: 700;
    color: #000000;
  }

  #user-manuals-videos-{{ umv_id }} .umv-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(24 * var(--rem));
    height: calc(24 * var(--rem));
    border-radius: 50%;
    background: #ff6501;
    color: #ffffff;
    font-size: calc(10 * var(--rem));
    line-height: 1;
    flex-shrink: 0;
  }

  #user-manuals-videos-{{ umv_id }} .umv-hint {
    margin: 0;
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
    color: #999999;
    text-align: right;
  }

  #user-manuals-videos-{{ umv_id }} .umv-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(16 * var(--rem));
  }

  #user-manuals-videos-{{ umv_id }} .umv-card {
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: calc(8 * var(--rem));
    background: #ffffff;
    overflow: hidden;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
    width: 100%;
  }

  #user-manuals-videos-{{ umv_id }} .umv-card[aria-disabled='true'] {
    cursor: default;
  }

  #user-manuals-videos-{{ umv_id }} .umv-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e8e8e8;
  }

  #user-manuals-videos-{{ umv_id }} .umv-thumb img,
  #user-manuals-videos-{{ umv_id }} .umv-thumb svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #user-manuals-videos-{{ umv_id }} .umv-idx {
    position: absolute;
    top: calc(12 * var(--rem));
    left: calc(16 * var(--rem));
    z-index: 1;
    font-size: calc(48 * var(--rem));
    line-height: 1;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.72);
    pointer-events: none;
  }

  #user-manuals-videos-{{ umv_id }} .umv-play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(56 * var(--rem));
    height: calc(56 * var(--rem));
    border-radius: 50%;
    background: #ff6501;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  #user-manuals-videos-{{ umv_id }} .umv-play svg {
    width: calc(18 * var(--rem));
    height: calc(18 * var(--rem));
    margin-left: calc(2 * var(--rem));
  }

  #user-manuals-videos-{{ umv_id }} .umv-dur {
    position: absolute;
    right: calc(12 * var(--rem));
    bottom: calc(12 * var(--rem));
    z-index: 1;
    padding: calc(4 * var(--rem)) calc(8 * var(--rem));
    background: #000000;
    color: #ffffff;
    font-size: calc(12 * var(--rem));
    line-height: 1.2;
    font-weight: 600;
  }

  #user-manuals-videos-{{ umv_id }} .umv-body {
    padding: calc(16 * var(--rem));
    background: #ffffff;
  }

  #user-manuals-videos-{{ umv_id }} .umv-label {
    margin: 0 0 calc(8 * var(--rem));
    font-size: calc(10 * var(--rem));
    line-height: calc(16 * var(--rem));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ff6501;
    font-weight: 600;
  }

  #user-manuals-videos-{{ umv_id }} .umv-name {
    margin: 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(22 * var(--rem));
    color: #000000;
  }

  #user-manuals-videos-{{ umv_id }} .umv-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(24 * var(--rem));
    background: rgba(0, 0, 0, 0.72);
  }

  #user-manuals-videos-{{ umv_id }} .umv-modal[hidden] {
    display: none;
  }

  #user-manuals-videos-{{ umv_id }} .umv-modal__box {
    position: relative;
    width: min(100%, calc(960 * var(--rem)));
    aspect-ratio: 16 / 9;
    background: #000000;
  }

  #user-manuals-videos-{{ umv_id }} .umv-modal__box iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  #user-manuals-videos-{{ umv_id }} .umv-modal__close {
    position: absolute;
    top: calc(-36 * var(--rem));
    right: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffffff;
    font-size: calc(28 * var(--rem));
    line-height: 1;
    cursor: pointer;
  }

  @media (hover: hover) {
    #user-manuals-videos-{{ umv_id }} .umv-card:hover .umv-play {
      filter: brightness(1.06);
    }
  }

  @media screen and (max-width: 749px) {
    #user-manuals-videos-{{ umv_id }} {
      padding-top: calc(0 * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88 }} * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-shell {
      width: 100%;
      padding: 0 calc(40 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-head {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: calc(48 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-title {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-num {
      width: calc(36 * var(--rem));
      height: calc(36 * var(--rem));
      font-size: calc(18 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-hint {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
      text-align: left;
    }

    #user-manuals-videos-{{ umv_id }} .umv-grid {
      grid-template-columns: 1fr;
      gap: calc(24 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-idx {
      font-size: calc(64 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-play {
      width: calc(80 * var(--rem));
      height: calc(80 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-label {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-name {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }
    #user-manuals-videos-{{ umv_id }} .umv-play svg {
      width: calc(24 * var(--rem));
      height: calc(24 * var(--rem));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    #user-manuals-videos-{{ umv_id }} {
      padding-top: calc(0 * var(--rem));
      padding-bottom: calc(168 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-shell {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 calc(34 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-head {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: calc(90 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-title {
      font-size: calc(42 * var(--rem));
      line-height: calc(61 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-num {
      width: calc(46 * var(--rem));
      height: calc(46 * var(--rem));
      font-size: calc(23 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-hint {
      font-size: calc(38 * var(--rem));
      line-height: calc(61 * var(--rem));
      text-align: left;
    }

    #user-manuals-videos-{{ umv_id }} .umv-grid {
      grid-template-columns: 1fr;
      gap: calc(46 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-idx {
      font-size: calc(90 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-play {
      width: calc(106 * var(--rem));
      height: calc(106 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-label,
    #user-manuals-videos-{{ umv_id }} .umv-dur {
      font-size: calc(23 * var(--rem));
      line-height: calc(30 * var(--rem));
    }

    #user-manuals-videos-{{ umv_id }} .umv-name {
      font-size: calc(42 * var(--rem));
      line-height: calc(42 * var(--rem));
    }
  }
{% endstyle %}

<section
  class="user-manuals-videos"
  id="user-manuals-videos-{{ umv_id }}"
>
  <div class="umv-shell">
    <div class="umv-head">
      <h2 class="umv-title">
        <span class="umv-num">{{ section.settings.step_num | default: '3' | escape }}</span>
        {{ section.settings.heading | default: 'Setup videos' | escape }}
      </h2>
      {%- if section.settings.hint != blank -%}
        <p class="umv-hint">{{ section.settings.hint | escape }}</p>
      {%- endif -%}
    </div>

    <div class="umv-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'video' -%}
          {%- liquid
            assign umv_idx = block.settings.index
            if umv_idx == blank
              assign umv_idx = forloop.index | prepend: '0'
              if forloop.index > 9
                assign umv_idx = forloop.index
              endif
            endif
            assign umv_src = ''
            if block.settings.video_url != blank
              if block.settings.video_url.type == 'youtube'
                assign umv_src = 'https://www.youtube.com/embed/' | append: block.settings.video_url.id | append: '?autoplay=1&rel=0'
              elsif block.settings.video_url.type == 'vimeo'
                assign umv_src = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?autoplay=1'
              endif
            endif
          -%}
          <button
            class="umv-card"
            type="button"
            data-src="{{ umv_src | escape }}"
            {% if umv_src == blank %}aria-disabled="true"{% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="umv-thumb">
              <span class="umv-idx">{{ umv_idx | escape }}</span>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 540
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720',
                    sizes: '(max-width: 749px) 92vw, 356px',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'umv-ph' }}
              {%- endif -%}
              <span class="umv-play" aria-hidden="true">
                <svg viewBox="0 0 18 18" fill="none">
                  <path d="M6 4.2L14 9L6 13.8V4.2Z" fill="#fff"/>
                </svg>
              </span>
              {%- if block.settings.duration != blank -%}
                <span class="umv-dur">{{ block.settings.duration | escape }}</span>
              {%- endif -%}
            </div>
            <div class="umv-body">
              {%- if block.settings.label != blank -%}
                <p class="umv-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="umv-name">{{ block.settings.title | escape }}</p>
              {%- endif -%}
            </div>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="umv-modal" hidden>
    <div class="umv-modal__box">
      <button class="umv-modal__close" type="button" aria-label="Close">&times;</button>
      <iframe title="Setup video" allow="autoplay; fullscreen" allowfullscreen></iframe>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('user-manuals-videos-{{ umv_id }}');
    if (!root) return;
    var modal = root.querySelector('.umv-modal');
    var iframe = modal && modal.querySelector('iframe');
    if (!modal || !iframe) return;

    function closeModal() {
      modal.hidden = true;
      iframe.src = '';
    }

    root.addEventListener('click', function (e) {
      var card = e.target.closest('.umv-card');
      if (card && card.getAttribute('aria-disabled') !== 'true') {
        var src = card.getAttribute('data-src');
        if (!src) return;
        iframe.src = src;
        modal.hidden = false;
        return;
      }
      if (e.target.closest('.umv-modal__close') || e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();
</script>

{% schema %}
{
  "name": "User Manuals Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "step_num",
      "label": "步骤序号",
      "default": "3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Setup videos"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "右侧提示",
      "default": "Watch each step directly—no download needed."
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "上间距 (PC)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "下间距 (PC)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上间距 (手机)",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下间距 (手机)",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "视频",
      "settings": [
        {
          "type": "text",
          "id": "index",
          "label": "序号",
          "info": "不填则按 01、02 自动编号"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "时长",
          "default": "08:42"
        },
        {
          "type": "text",
          "id": "label",
          "label": "橙色标签",
          "default": "START HERE"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Unboxing & Assembly"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "封面"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "视频链接",
          "accept": ["youtube", "vimeo"]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "User Manuals Videos",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "index": "01",
            "duration": "08:42",
            "label": "START HERE",
            "title": "Unboxing & Assembly"
          }
        },
        {
          "type": "video",
          "settings": {
            "index": "02",
            "duration": "03:18",
            "label": "APP SETUP",
            "title": "Connect the AOTOS App"
          }
        },
        {
          "type": "video",
          "settings": {
            "index": "03",
            "duration": "05:06",
            "label": "DAILY USE",
            "title": "Display & Ride Modes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
