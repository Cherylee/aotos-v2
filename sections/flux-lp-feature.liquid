{% render 'flux-landing-assets' %}
<section
  class="flp flp-feature flp-reveal"
  style="--pad-t: {{ section.settings.padding_top | default: 0, allow_false: true }}; --pad-b: {{ section.settings.padding_bottom | default: 0, allow_false: true }}; --pad-tm: {{ section.settings.padding_top_mobile | default: 0, allow_false: true }}; --pad-bm: {{ section.settings.padding_bottom_mobile | default: 0, allow_false: true }}; --flp-bg: {{ section.settings.bg_color }}; --flp-title: {{ section.settings.title_color }}; --flp-text: {{ section.settings.text_color }};"
>
  {%- if section.settings.title != blank -%}
    <h2 class="flp-display aotos-section-title flp-reveal"><span>{{ section.settings.title | newline_to_br }}</span></h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="flp-lead">{{ section.settings.text | newline_to_br }}</div>
  {%- endif -%}
  <div class="flp-feature__media">
    {%- if section.settings.image != blank -%}
      {%- assign feat_h = 1600 | divided_by: section.settings.image.aspect_ratio | round -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          class: 'flp-hero__pc',
          widths: '750, 1100, 1600',
          sizes: '100vw',
          width: 1600,
          height: feat_h,
          loading: 'lazy',
          alt: ''
      }}
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      {%- assign feat_mh = 800 | divided_by: section.settings.image_mobile.aspect_ratio | round -%}
      {{
        section.settings.image_mobile
        | image_url: width: 800
        | image_tag:
          class: 'flp-hero__mob',
          widths: '400, 600, 800',
          sizes: '100vw',
          width: 800,
          height: feat_mh,
          loading: 'lazy',
          alt: ''
      }}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "FLUX 图文",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "title", "label": "标题" },
    { "type": "textarea", "id": "text", "label": "说明" },
    { "type": "image_picker", "id": "image", "label": "电脑图片" },
    { "type": "image_picker", "id": "image_mobile", "label": "手机图片" },
    { "type": "color", "id": "bg_color", "label": "背景", "default": "#000000" },
    { "type": "color", "id": "title_color", "label": "标题颜色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "说明颜色", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "上边距", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "下边距", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机上边距", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "手机下边距", "default": 0 }
  ],
  "presets": [{ "name": "FLUX 图文" }]
}
{% endschema %}
