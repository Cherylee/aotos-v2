      {%- for block in section.blocks -%}
        <button
          type="button"
          class="sc-hero__dot"
          role="tab"
          aria-label="{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{%- if section.blocks.size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('sc-hero-{{ section.id }}');
      if (!root) return;
      var slides = root.querySelectorAll('.sc-hero__slide');
      var dots = root.querySelectorAll('.sc-hero__dot');
      var index = 0;
      var timer;
      var paused = false;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var visibleVideo = function (slide) {
        var found = null;
        slide.querySelectorAll('video').forEach(function (video) {
          if (window.getComputedStyle(video).display === 'none') return;
          found = video;
        });
        return found;
      };

      var clearTimer = function () {
        clearTimeout(timer);
        timer = null;
      };

      var scheduleImage = function () {
        clearTimer();
        if (reduce || paused) return;
        timer = setTimeout(function () {
          go(index + 1);
        }, 5000);
      };

      var playSlide = function (slide) {
        root.querySelectorAll('video').forEach(function (video) {
          video.pause();
        });
        clearTimer();
        if (reduce) return;
        var video = visibleVideo(slide);
        if (!video) {
          scheduleImage();
          return;
        }
        try {
          video.currentTime = 0;
        } catch (error) {}
        var playing = video.play();
        if (playing && playing.catch) {
          playing.catch(function () {
            scheduleImage();
          });
        }
      };

      var go = function (next) {
        index = (next + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          slide.classList.toggle('is-active', i === index);
        });
        dots.forEach(function (dot, i) {
          dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
        });
        playSlide(slides[index]);
      };

      root.querySelectorAll('video').forEach(function (video) {
        video.loop = false;
        video.removeAttribute('loop');
        video.addEventListener('ended', function () {
          if (reduce) return;
          var slide = video.closest('.sc-hero__slide');
          if (!slide || !slide.classList.contains('is-active')) return;
          if (visibleVideo(slide) !== video) return;
          go(index + 1);
        });
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () {
          go(i);
        });
      });

      if (reduce) {
        root.querySelectorAll('video').forEach(function (video) {
          video.pause();
          video.removeAttribute('autoplay');
        });
        return;
      }

      root.addEventListener('mouseenter', function () {
        paused = true;
        clearTimer();
      });
      root.addEventListener('mouseleave', function () {
        paused = false;
        var video = visibleVideo(slides[index]);
        if (video && !video.ended) return;
        if (video) {
          go(index + 1);
          return;
        }
        scheduleImage();
      });
      playSlide(slides[0]);
    })();
  </script>
{%- endif -%}

