{%- liquid
  assign sc_overlay = section.settings.overlay_opacity | default: 45
  assign sc_height = section.settings.height | default: '400'
  assign sc_height_mob = section.settings.height_mobile | default: '480'
  if section.blocks.size > 0
    assign sc_hero_title = section.blocks.first.settings.heading | default: 'Safety Certified'
  else
    assign sc_hero_title = section.settings.heading | default: 'Safety Certified'
  endif
-%}

{% style %}
  body:has(.sc-hero) #MainContent {
    background-color: #ffffff;
  }

  body:has(.sc-hero) #MainContent > .shopify-section.section + .shopify-section.section {
    margin-top: 0;
  }

  #sc-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    {%- unless sc_height == 'adapt' -%}
      min-height: calc({{ sc_height }} * var(--rem));
    {%- endunless -%}
    overflow: hidden;
    color: #ffffff;
    font-family: var(--font-body-family);
  }

  #sc-hero-{{ section.id }} * {
    box-sizing: border-box;
  }

  #sc-hero-{{ section.id }} .sc-hero__slide {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
  }

  #sc-hero-{{ section.id }} .sc-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  #sc-hero-{{ section.id }} .sc-hero__media,
  #sc-hero-{{ section.id }} .sc-hero__media picture,
  #sc-hero-{{ section.id }} .sc-hero__media img,
  #sc-hero-{{ section.id }} .sc-hero__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
  }

  #sc-hero-{{ section.id }} .sc-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #sc-hero-{{ section.id }} .sc-hero__media picture,
  #sc-hero-{{ section.id }} .sc-hero__media img,
  #sc-hero-{{ section.id }} .sc-hero__media video {
    position: absolute;
    inset: 0;
  }

  #sc-hero-{{ section.id }} .sc-hero__media video {
    z-index: 1;
  }

  #sc-hero-{{ section.id }} .sc-hero__video--mobile,
  #sc-hero-{{ section.id }} .sc-hero__poster--mobile {
    display: none;
  }

  #sc-hero-{{ section.id }} .sc-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgb(0 0 0 / calc(var(--sc-hero-overlay, 45) * 1%));
    pointer-events: none;
  }

  #sc-hero-{{ section.id }} .sc-hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    width: calc(1100 * var(--rem));
    max-width: 100%;
    {%- unless sc_height == 'adapt' -%}
      min-height: calc({{ sc_height }} * var(--rem));
    {%- endunless -%}
    margin: 0 auto;
    padding: calc(80 * var(--rem)) calc(30 * var(--rem));
    pointer-events: none;
    opacity: 0;
    transform: translateY(calc(-20 * var(--rem)));
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  #sc-hero-{{ section.id }} .sc-hero__slide.is-active .sc-hero__inner {
    animation: sc-hero-copy-in-{{ section.id }} 0.7s ease both;
  }

  @keyframes sc-hero-copy-in-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(calc(28 * var(--rem)));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #sc-hero-{{ section.id }} .sc-hero__accent {
    display: block;
    width: calc(40 * var(--rem));
    height: calc(4 * var(--rem));
    margin-bottom: calc(20 * var(--rem));
    border-radius: calc(2 * var(--rem));
    background: var(--aotos-theme-color, #ff6501);
  }

  #sc-hero-{{ section.id }} .sc-hero__accent.is-color-black {
    background: #000000;
  }

  #sc-hero-{{ section.id }} .sc-hero__accent.is-color-gray {
    background: #999999;
  }

  #sc-hero-{{ section.id }} .sc-hero__accent.is-color-white {
    background: #ffffff;
  }

  #sc-hero-{{ section.id }} .sc-hero__eyebrow {
    margin: 0 0 calc(var(--sc-eyebrow-gap, 16) * var(--rem));
    color: #ffffff;
    font-size: calc(var(--sc-eyebrow-size, 12) * var(--rem));
    font-weight: var(--sc-weight, 400);
    line-height: 1.4;
    text-transform: uppercase;
  }

  #sc-hero-{{ section.id }} .sc-hero__title {
    margin: 0 0 calc(var(--sc-title-gap, 16) * var(--rem));
    color: #ffffff;
    font-size: calc(var(--sc-title-size, 32) * var(--rem));
    font-weight: var(--sc-weight, 600);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  #sc-hero-{{ section.id }} .sc-hero__subtitle {
    margin: 0 0 calc(var(--sc-subtitle-gap, 0) * var(--rem));
    max-width: calc(560 * var(--rem));
    color: #ffffff;
    font-size: calc(var(--sc-subtitle-size, 12) * var(--rem));
    font-weight: var(--sc-weight, 400);
    line-height: 1.5;
  }

  #sc-hero-{{ section.id }} .sc-hero__eyebrow.is-color-theme,
  #sc-hero-{{ section.id }} .sc-hero__title.is-color-theme,
  #sc-hero-{{ section.id }} .sc-hero__subtitle.is-color-theme {
    color: var(--aotos-theme-color, #ff6501);
  }

  #sc-hero-{{ section.id }} .sc-hero__eyebrow.is-color-black,
  #sc-hero-{{ section.id }} .sc-hero__title.is-color-black,
  #sc-hero-{{ section.id }} .sc-hero__subtitle.is-color-black {
    color: #000000;
  }

  #sc-hero-{{ section.id }} .sc-hero__eyebrow.is-color-gray,
  #sc-hero-{{ section.id }} .sc-hero__title.is-color-gray,
  #sc-hero-{{ section.id }} .sc-hero__subtitle.is-color-gray {
    color: #999999;
  }

  #sc-hero-{{ section.id }} .sc-hero__eyebrow.is-color-white,
  #sc-hero-{{ section.id }} .sc-hero__title.is-color-white,
  #sc-hero-{{ section.id }} .sc-hero__subtitle.is-color-white {
    color: #ffffff;
  }

  #sc-hero-{{ section.id }} .sc-hero__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: calc(var(--sc-stat-gap, 56) * var(--rem));
    margin: calc(var(--sc-stat-margin, 28) * var(--rem)) 0 0;
    padding: 0;
    list-style: none;
  }

  #sc-hero-{{ section.id }} .sc-hero__stat-value {
    margin: 0;
    color: #000000;
    font-size: calc(var(--sc-stat-size, 28) * var(--rem));
    font-weight: 700;
    line-height: 1.1;
  }

  #sc-hero-{{ section.id }} .sc-hero__stat-label {
    margin: calc(6 * var(--rem)) 0 0;
    color: rgb(0 0 0 / 80%);
    font-size: calc(var(--sc-stat-label-size, 14) * var(--rem));
    line-height: 1.3;
  }

  #sc-hero-{{ section.id }} .sc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: calc(16 * var(--rem));
    pointer-events: auto;
  }

  #sc-hero-{{ section.id }} .sc-hero__btn {
    margin-top: calc(var(--sc-btn-gap, 24) * var(--rem));
    text-decoration: none;
  }

  #sc-hero-{{ section.id }} .sc-hero__dots {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: calc(24 * var(--rem));
    display: flex;
    justify-content: center;
    align-items: center;
    gap: calc(8 * var(--rem));
  }

  #sc-hero-{{ section.id }} .sc-hero__dot {
    width: calc(36 * var(--rem));
    height: calc(4 * var(--rem));
    padding: 0;
    border: 0;
    border-radius: calc(1 * var(--rem));
    background: rgb(255 255 255 / 45%);
    cursor: pointer;
  }

  #sc-hero-{{ section.id }} .sc-hero__dot[aria-selected='true'] {
    background: var(--aotos-theme-color, #ff6501);
  }

  {%- if sc_height == 'adapt' -%}
    #sc-hero-{{ section.id }} .sc-hero__slide.is-active {
      position: relative;
      inset: auto;
    }

    #sc-hero-{{ section.id }} .sc-hero__media {
      position: relative;
      inset: auto;
      height: auto;
    }

    #sc-hero-{{ section.id }} .sc-hero__media picture,
    #sc-hero-{{ section.id }} .sc-hero__media img {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    #sc-hero-{{ section.id }} .sc-hero__media video {
      object-fit: contain;
    }

    #sc-hero-{{ section.id }} .sc-hero__media:not(:has(img)) video {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
    }

    #sc-hero-{{ section.id }} .sc-hero__inner {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      min-height: 0;
    }
  {%- endif -%}

  @media screen and (max-width: 768px) {
    {%- if sc_height_mob == 'adapt' -%}
      #sc-hero-{{ section.id }},
      #sc-hero-{{ section.id }} .sc-hero__inner {
        min-height: 0;
      }

      #sc-hero-{{ section.id }} .sc-hero__slide.is-active {
        position: relative;
        inset: auto;
      }

      #sc-hero-{{ section.id }} .sc-hero__media {
        position: relative;
        inset: auto;
        height: auto;
      }

      #sc-hero-{{ section.id }} .sc-hero__media picture,
      #sc-hero-{{ section.id }} .sc-hero__media img {
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      #sc-hero-{{ section.id }} .sc-hero__media video {
        object-fit: contain;
      }

      #sc-hero-{{ section.id }} .sc-hero__media:not(:has(img)) video {
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
      }

      #sc-hero-{{ section.id }} .sc-hero__inner {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
      }
    {%- else -%}
      #sc-hero-{{ section.id }},
      #sc-hero-{{ section.id }} .sc-hero__inner {
        min-height: calc({{ sc_height_mob }} * var(--rem));
      }

      {%- if sc_height == 'adapt' -%}
        #sc-hero-{{ section.id }} .sc-hero__slide.is-active {
          position: absolute;
          inset: 0;
        }

        #sc-hero-{{ section.id }} .sc-hero__media,
        #sc-hero-{{ section.id }} .sc-hero__media picture,
        #sc-hero-{{ section.id }} .sc-hero__media img,
        #sc-hero-{{ section.id }} .sc-hero__media video {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        #sc-hero-{{ section.id }} .sc-hero__inner {
          position: relative;
          top: auto;
          right: auto;
          bottom: auto;
          left: auto;
        }
      {%- endif -%}
    {%- endif -%}

    #sc-hero-{{ section.id }} .sc-hero__inner {
      width: 100%;
      padding: calc(88 * var(--rem)) calc(40 * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__video--pc,
    #sc-hero-{{ section.id }} .sc-hero__poster--pc {
      display: none;
    }

    #sc-hero-{{ section.id }} .sc-hero__video--mobile,
    #sc-hero-{{ section.id }} .sc-hero__poster--mobile {
      display: block;
    }

    #sc-hero-{{ section.id }} .sc-hero__accent {
      width: calc(56 * var(--rem));
      height: calc(6 * var(--rem));
      margin-bottom: calc(24 * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__eyebrow {
      margin-bottom: calc(var(--sc-eyebrow-gap-mob, 20) * var(--rem));
      font-size: calc(var(--sc-eyebrow-size-mob, 20) * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__title {
      margin-bottom: calc(var(--sc-title-gap-mob, 20) * var(--rem));
      font-size: calc(var(--sc-title-size-mob, 48) * var(--rem));
      line-height: 1.15;
    }

    #sc-hero-{{ section.id }} .sc-hero__subtitle {
      margin-bottom: calc(var(--sc-subtitle-gap-mob, 0) * var(--rem));
      font-size: calc(var(--sc-subtitle-size-mob, 20) * var(--rem));
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-top .sc-hero__inner {
      justify-content: flex-start;
      align-items: flex-start;
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__inner {
      justify-content: flex-start;
      align-items: center;
      text-align: center;
      padding-top: calc(38 * var(--rem));
      padding-bottom: calc(38 * var(--rem));
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__subtitle {
      max-width: 100%;
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__stats,
    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__actions {
      justify-content: center;
      width: 100%;
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__actions {
      margin-top: auto;
    }

    #sc-hero-{{ section.id }}.sc-hero--mob-split .sc-hero__btn {
      margin-top: 0;
    }

    #sc-hero-{{ section.id }} .sc-hero__stats {
      gap: calc(var(--sc-stat-gap-mob, 40) * var(--rem));
      margin-top: calc(var(--sc-stat-margin-mob, 32) * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__stat-value {
      font-size: calc(var(--sc-stat-size-mob, 36) * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__stat-label {
      margin-top: calc(8 * var(--rem));
      font-size: calc(var(--sc-stat-label-size-mob, 20) * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__actions {
      gap: calc(24 * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__btn {
      margin-top: calc(var(--sc-btn-gap-mob, 32) * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__dots {
      bottom: calc(32 * var(--rem));
      gap: calc(12 * var(--rem));
    }

    #sc-hero-{{ section.id }} .sc-hero__dot {
      width: calc(48 * var(--rem));
      height: calc(6 * var(--rem));
      border-radius: calc(6 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sc-hero-{{ section.id }} .sc-hero__slide {
      transition: none;
    }

    #sc-hero-{{ section.id }} .sc-hero__inner {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }
{% endstyle %}

<section
  class="sc-hero{% if section.settings.content_mobile == 'split' %} sc-hero--mob-split{% else %} sc-hero--mob-top{% endif %}"
  id="sc-hero-{{ section.id }}"
  style="--sc-hero-overlay: {{ sc_overlay }};"
>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign slide_image = block.settings.image
        assign slide_image_mob = block.settings.image_mobile | default: slide_image
        assign slide_video = block.settings.video
        assign slide_video_mob = block.settings.video_mobile | default: slide_video
        assign slide_poster = block.settings.poster | default: slide_image
        if slide_poster == blank and slide_video != blank
          assign slide_poster = slide_video.preview_image
        endif
        assign slide_poster_mob = block.settings.poster_mobile | default: block.settings.image_mobile
        if slide_poster_mob == blank
          assign slide_poster_mob = slide_poster
        endif
        assign slide_alt = block.settings.image_alt | default: block.settings.heading | default: sc_hero_title
        assign slide_eager = false
        if forloop.first
          assign slide_eager = true
        endif
      -%}
      <div
        class="sc-hero__slide{% if forloop.first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div class="sc-hero__media" aria-hidden="true">
          {%- if slide_video != blank or slide_video_mob != blank -%}
            {%- if slide_poster != blank -%}
              <img
                class="sc-hero__poster{% if slide_poster_mob != blank and slide_poster_mob != slide_poster %} sc-hero__poster--pc{% endif %}"
                src="{{ slide_poster | image_url: width: 1600 }}"
                srcset="{{ slide_poster | image_url: width: 1100 }} 1100w, {{ slide_poster | image_url: width: 1600 }} 1600w, {{ slide_poster | image_url: width: 1920 }} 1920w"
                sizes="100vw"
                width="1600"
                height="{{ 1600 | divided_by: slide_poster.aspect_ratio | round }}"
                alt=""
                {% if slide_eager %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {%- endif -%}
            {%- if slide_poster_mob != blank and slide_poster_mob != slide_poster -%}
              <img
                class="sc-hero__poster sc-hero__poster--mobile"
                src="{{ slide_poster_mob | image_url: width: 1100 }}"
                srcset="{{ slide_poster_mob | image_url: width: 750 }} 750w, {{ slide_poster_mob | image_url: width: 1100 }} 1100w, {{ slide_poster_mob | image_url: width: 1500 }} 1500w"
                sizes="100vw"
                width="1100"
                height="{{ 1100 | divided_by: slide_poster_mob.aspect_ratio | round }}"
                alt=""
                {% if slide_eager %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {%- endif -%}
            {%- if slide_video != blank -%}
              {%- capture slide_video_class -%}sc-hero__video{% if block.settings.video_mobile != blank %} sc-hero__video--pc{% endif %}{%- endcapture -%}
              {%- if slide_eager -%}
                {{ slide_video | video_tag: class: slide_video_class, autoplay: true, loop: false, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
              {%- else -%}
                {{ slide_video | video_tag: class: slide_video_class, autoplay: false, loop: false, muted: true, controls: false, playsinline: true, preload: 'none' }}
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.video_mobile != blank -%}
              {{ block.settings.video_mobile | video_tag: class: 'sc-hero__video sc-hero__video--mobile', autoplay: false, loop: false, muted: true, controls: false, playsinline: true, preload: 'none' }}
            {%- endif -%}
          {%- elsif slide_image != blank or slide_image_mob != blank -%}
            <picture>
              {%- if slide_image_mob != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ slide_image_mob | image_url: width: 750 }} 750w, {{ slide_image_mob | image_url: width: 1100 }} 1100w, {{ slide_image_mob | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                >
              {%- endif -%}
              {%- if slide_image != blank -%}
                <img
                  src="{{ slide_image | image_url: width: 1600 }}"
                  srcset="{{ slide_image | image_url: width: 1100 }} 1100w, {{ slide_image | image_url: width: 1600 }} 1600w, {{ slide_image | image_url: width: 1920 }} 1920w"
                  sizes="100vw"
                  width="1600"
                  height="{{ 1600 | divided_by: slide_image.aspect_ratio | round }}"
                  alt="{{ slide_alt | escape }}"
                  {% if slide_eager %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {%- else -%}
                <img
                  src="{{ slide_image_mob | image_url: width: 1100 }}"
                  srcset="{{ slide_image_mob | image_url: width: 750 }} 750w, {{ slide_image_mob | image_url: width: 1100 }} 1100w, {{ slide_image_mob | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                  width="1100"
                  height="{{ 1100 | divided_by: slide_image_mob.aspect_ratio | round }}"
                  alt="{{ slide_alt | escape }}"
                  {% if slide_eager %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              {%- endif -%}
            </picture>
          {%- else -%}
            <div style="width:100%;height:100%;background:#1a1a1a;"></div>
          {%- endif -%}
        </div>
        <div class="sc-hero__overlay" aria-hidden="true"></div>
        <div
          class="sc-hero__inner"
          style="--sc-eyebrow-size: {{ block.settings.eyebrow_size | default: 12 }}; --sc-eyebrow-gap: {{ block.settings.eyebrow_gap | default: 16 }}; --sc-title-size: {{ block.settings.title_size | default: 32 }}; --sc-title-gap: {{ block.settings.title_gap | default: 16 }}; --sc-subtitle-size: {{ block.settings.subtitle_size | default: 12 }}; --sc-subtitle-gap: {{ block.settings.subtitle_gap | default: 0 }}; --sc-eyebrow-size-mob: {{ block.settings.eyebrow_size_mobile | default: 20 }}; --sc-eyebrow-gap-mob: {{ block.settings.eyebrow_gap_mobile | default: 20 }}; --sc-title-size-mob: {{ block.settings.title_size_mobile | default: 48 }}; --sc-title-gap-mob: {{ block.settings.title_gap_mobile | default: 20 }}; --sc-subtitle-size-mob: {{ block.settings.subtitle_size_mobile | default: 20 }}; --sc-subtitle-gap-mob: {{ block.settings.subtitle_gap_mobile | default: 0 }};"
        >
          {%- if block.settings.show_accent != false -%}
            <span class="sc-hero__accent is-color-{{ block.settings.accent_color | default: 'theme' }}" aria-hidden="true"></span>
          {%- endif -%}
          {%- if block.settings.eyebrow != blank -%}
            <p class="sc-hero__eyebrow is-color-{{ block.settings.eyebrow_color | default: 'white' }}" style="--sc-weight: {{ block.settings.eyebrow_weight | default: 400 }};">{{ block.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            {%- if forloop.first -%}
              <h1 class="sc-hero__title is-color-{{ block.settings.title_color | default: 'white' }}" style="--sc-weight: {{ block.settings.title_weight | default: 600 }};">{{ block.settings.heading | escape }}</h1>
            {%- else -%}
              <h2 class="sc-hero__title is-color-{{ block.settings.title_color | default: 'white' }}" style="--sc-weight: {{ block.settings.title_weight | default: 600 }};">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="sc-hero__subtitle is-color-{{ block.settings.subtitle_color | default: 'white' }}" style="--sc-weight: {{ block.settings.subtitle_weight | default: 400 }};">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}
          {%- liquid
            assign slide_show_stats = false
            if block.settings.stat_1_value != blank
              assign slide_show_stats = true
            endif
            if block.settings.stat_2_value != blank
              assign slide_show_stats = true
            endif
            if block.settings.stat_3_value != blank
