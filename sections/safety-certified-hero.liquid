  {%- else -%}
    {%- liquid
      assign slide_image = section.settings.image
      assign slide_image_mob = section.settings.image_mobile | default: slide_image
      assign slide_alt = section.settings.image_alt | default: sc_hero_title
    -%}
    <div class="sc-hero__slide is-active">
      <div class="sc-hero__media" aria-hidden="true">
        {%- if slide_image != blank or slide_image_mob != blank -%}
          <picture>
            {%- if slide_image_mob != blank -%}
              <source
                media="(max-width: 768px)"
                srcset="{{ slide_image_mob | image_url: width: 750 }} 750w, {{ slide_image_mob | image_url: width: 1100 }} 1100w, {{ slide_image_mob | image_url: width: 1500 }} 1500w"
                sizes="100vw"
              >
            {%- endif -%}
            {%- if slide_image != blank -%}
              <img
                src="{{ slide_image | image_url: width: 1600 }}"
                srcset="{{ slide_image | image_url: width: 1100 }} 1100w, {{ slide_image | image_url: width: 1600 }} 1600w, {{ slide_image | image_url: width: 1920 }} 1920w"
                sizes="100vw"
                width="1600"
                height="{{ 1600 | divided_by: slide_image.aspect_ratio | round }}"
                alt="{{ slide_alt | escape }}"
                loading="eager"
                fetchpriority="high"
              >
            {%- else -%}
              <img
                src="{{ slide_image_mob | image_url: width: 1100 }}"
                srcset="{{ slide_image_mob | image_url: width: 750 }} 750w, {{ slide_image_mob | image_url: width: 1100 }} 1100w, {{ slide_image_mob | image_url: width: 1500 }} 1500w"
                sizes="100vw"
                width="1100"
                height="{{ 1100 | divided_by: slide_image_mob.aspect_ratio | round }}"
                alt="{{ slide_alt | escape }}"
                loading="eager"
                fetchpriority="high"
              >
            {%- endif -%}
          </picture>
        {%- else -%}
          <div style="width:100%;height:100%;background:#1a1a1a;"></div>
        {%- endif -%}
      </div>
      <div class="sc-hero__overlay" aria-hidden="true"></div>
      <div
        class="sc-hero__inner"
        style="--sc-eyebrow-size: {{ section.settings.eyebrow_size | default: 12 }}; --sc-eyebrow-gap: {{ section.settings.eyebrow_gap | default: 16 }}; --sc-title-size: {{ section.settings.title_size | default: 32 }}; --sc-title-gap: {{ section.settings.title_gap | default: 16 }}; --sc-subtitle-size: {{ section.settings.subtitle_size | default: 12 }}; --sc-subtitle-gap: {{ section.settings.subtitle_gap | default: 0 }}; --sc-eyebrow-size-mob: {{ section.settings.eyebrow_size_mobile | default: 20 }}; --sc-eyebrow-gap-mob: {{ section.settings.eyebrow_gap_mobile | default: 20 }}; --sc-title-size-mob: {{ section.settings.title_size_mobile | default: 48 }}; --sc-title-gap-mob: {{ section.settings.title_gap_mobile | default: 20 }}; --sc-subtitle-size-mob: {{ section.settings.subtitle_size_mobile | default: 20 }}; --sc-subtitle-gap-mob: {{ section.settings.subtitle_gap_mobile | default: 0 }};"
      >
        {%- if section.settings.show_accent != false -%}
          <span class="sc-hero__accent" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="sc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="sc-hero__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="sc-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 1 -%}
