{%- if section.settings.enter_animation -%}
  {% render 'aotos-fd-enter' %}
{%- endif -%}

{%- style -%}
  #HomeTrust-{{ section.id }} {
    padding-top: calc({{ section.settings.padding_top | default: 24 }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 24 }} * var(--rem));
  }

  #HomeTrust-{{ section.id }} .home-trust__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
  }

  #HomeTrust-{{ section.id }} .home-trust__card {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    align-items: center;
    background: #ffffff;
    border-radius: calc(10 * var(--rem));
    box-shadow: 0 calc(8 * var(--rem)) calc(28 * var(--rem)) rgb(0 0 0 / 8%);
    border: 1px solid #e6e6e6;
  }

  #HomeTrust-{{ section.id }} .home-trust__item {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--rem));
    min-width: 0;
    padding: calc(22 * var(--rem)) calc(24 * var(--rem));
    position: relative;
  }

  #HomeTrust-{{ section.id }} .home-trust__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 1px;
    height: calc(36 * var(--rem));
    background: #e6e6e6;
    transform: translateY(-50%);
  }

  #HomeTrust-{{ section.id }} .home-trust__icon {
    flex: 0 0 auto;
    width: calc(40 * var(--rem));
    height: calc(40 * var(--rem));
    border-radius: calc(8 * var(--rem));
    overflow: hidden;
  }

  #HomeTrust-{{ section.id }} .home-trust__icon {
    color: #111111;
  }

  #HomeTrust-{{ section.id }} .home-trust__icon img,
  #HomeTrust-{{ section.id }} .home-trust__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #HomeTrust-{{ section.id }}.home-trust--plain .home-trust__title {
    text-transform: none;
    letter-spacing: 0;
  }

  @media (hover: hover) {
    #HomeTrust-{{ section.id }} .home-trust__item:hover .home-trust__icon {
      color: #ff6501;
    }
  }

  #HomeTrust-{{ section.id }} .home-trust__copy {
    min-width: 0;
  }

  #HomeTrust-{{ section.id }} .home-trust__title {
    margin: 0;
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  #HomeTrust-{{ section.id }} .home-trust__text {
    margin: calc(4 * var(--rem)) 0 0;
    color: #999999;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  @media screen and (max-width: 768px) {
    #HomeTrust-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 40 }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 40 }} * var(--rem));
    }

    #HomeTrust-{{ section.id }} .home-trust__shell {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 calc(40 * var(--rem));
      box-sizing: border-box;
    }

    #HomeTrust-{{ section.id }} .home-trust__card {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      border-radius: calc(20 * var(--rem));
    }

    #HomeTrust-{{ section.id }} .home-trust__item {
      align-items: center;
      gap: calc(16 * var(--rem));
      padding: calc(22 * var(--rem)) calc(16 * var(--rem));
    }

    #HomeTrust-{{ section.id }} .home-trust__item::after {
      display: none;
    }

    #HomeTrust-{{ section.id }} .home-trust__item:nth-child(odd) {
      box-shadow: inset -1px 0 0 #e6e6e6;
    }

    #HomeTrust-{{ section.id }} .home-trust__item:nth-child(n + 3) {
      box-shadow: inset 0 1px 0 #e6e6e6;
    }

    #HomeTrust-{{ section.id }} .home-trust__item:nth-child(odd):nth-child(n + 3) {
      box-shadow: inset -1px 0 0 #e6e6e6, inset 0 1px 0 #e6e6e6;
    }

    #HomeTrust-{{ section.id }} .home-trust__icon {
      width: calc(44 * var(--rem));
      height: calc(44 * var(--rem));
      border-radius: calc(12 * var(--rem));
    }

    #HomeTrust-{{ section.id }} .home-trust__title {
      font-size: calc(20 * var(--rem));
      line-height: calc(28 * var(--rem));
    }

    #HomeTrust-{{ section.id }} .home-trust__text {
      margin-top: calc(2 * var(--rem));
      font-size: calc(18 * var(--rem));
      line-height: calc(20 * var(--rem));
    }
  }
{%- endstyle -%}

<div id="HomeTrust-{{ section.id }}" class="home-trust{% if section.settings.title_style == 'plain' %} home-trust--plain{% endif %}">
  <div class="home-trust__shell">
    <div class="home-trust__card{% if section.settings.enter_animation %} fd-anim fd-stagger{% endif %}">
      {%- for block in section.blocks -%}
        <div class="home-trust__item{% if section.settings.enter_animation %} fd-stagger__item{% endif %}" {{ block.shopify_attributes }}>
          <div class="home-trust__icon">
            {%- if block.settings.icon != blank -%}
              <img
                src="{{ block.settings.icon | image_url: width: 128 }}"
                srcset="{{ block.settings.icon | image_url: width: 80 }} 80w, {{ block.settings.icon | image_url: width: 128 }} 128w, {{ block.settings.icon | image_url: width: 160 }} 160w"
                sizes="(max-width: 768px) 64px, 48px"
                width="128"
                height="128"
                alt=""
                loading="lazy"
              >
            {%- elsif block.settings.icon_type == 'percent' -%}
              <svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><circle cx="22" cy="22" r="20.5" stroke="currentColor" stroke-width="1.5"/><path d="M15 17.5C16.3807 17.5 17.5 16.3807 17.5 15C17.5 13.6193 16.3807 12.5 15 12.5C13.6193 12.5 12.5 13.6193 12.5 15C12.5 16.3807 13.6193 17.5 15 17.5Z" fill="currentColor"/><path d="M29 31.5C30.3807 31.5 31.5 30.3807 31.5 29C31.5 27.6193 30.3807 26.5 29 26.5C27.6193 26.5 26.5 27.6193 26.5 29C26.5 30.3807 27.6193 31.5 29 31.5Z" fill="currentColor"/><path d="M29 15L15 29" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            {%- elsif block.settings.icon_type == 'bag' -%}
              <svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><circle cx="22" cy="22" r="20.5" stroke="currentColor" stroke-width="1.5"/><path d="M15 19H29L27.5 33H16.5L15 19Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M18 19V16.5C18 14.567 19.567 13 21.5 13H22.5C24.433 13 26 14.567 26 16.5V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            {%- elsif block.settings.icon_type == 'shield' -%}
              <svg viewBox="0 0 44 44" fill="none" aria-hidden="true"><path d="M22 6L34 10V20.5C34 28.232 28.732 33.5 22 37C15.268 33.5 10 28.232 10 20.5V10L22 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M22 16.5C19.7909 16.5 18 18.2909 18 20.5C18 22.7091 19.7909 24.5 22 24.5C24.2091 24.5 26 22.7091 26 20.5C26 18.2909 24.2091 16.5 22 16.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M22 24.5V29.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            {%- else -%}
              <span class="home-trust__ph" aria-hidden="true"></span>
            {%- endif -%}
          </div>
          <div class="home-trust__copy">
            {%- if block.settings.title != blank -%}
              <p class="home-trust__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="home-trust__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "信任条",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上边距（PC）",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下边距（PC）",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "上边距（手机）",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "下边距（手机）",
      "default": 40
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "标题样式",
      "default": "upper",
      "options": [
        { "value": "upper", "label": "全大写" },
        { "value": "plain", "label": "原样" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enter_animation",
      "label": "进场动画",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "条目",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "图标",
          "info": "不上传、也不选内置图标时显示灰色占位。"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "内置图标",
          "default": "none",
          "options": [
            { "value": "none", "label": "无" },
            { "value": "percent", "label": "百分比" },
            { "value": "shield", "label": "盾牌" },
            { "value": "bag", "label": "购物袋" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "标题"
        },
        {
          "type": "text",
          "id": "text",
          "label": "说明",
          "default": "说明文案"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "信任条",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "1-Year Warranty",
            "text": "With reliable local repair support."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lifetime Support",
            "text": "Expert help for as long as you ride"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Local Shipping",
            "text": "Delivered in 5 Days"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "30-Day Returns",
            "text": "Easy Returns Guaranteed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
