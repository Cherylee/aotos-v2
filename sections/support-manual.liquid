<section
  class="support-manual-container sman"
  id="sman-{{ section.id }}"
  style="--sman-pt: {{ section.settings.padding_top | default: 80, allow_false: true }}; --sman-pb: {{ section.settings.padding_bottom | default: 80, allow_false: true }}; --sman-pt-m: {{ section.settings.padding_top_mobile | default: 88, allow_false: true }}; --sman-pb-m: {{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }};"
>
  <div class="sman__shell">
    {%- if section.settings.title != blank -%}
      <h2 class="sman__title aotos-section-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <div class="sman__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'manual_item' -%}
          {%- liquid
            assign manual_product = block.settings.related_product
            assign manual_image = ''
            if manual_product.featured_image != blank
              assign manual_image = manual_product.featured_image | image_url: width: 80
            endif
          -%}
          <a
            class="support-manual-item sman__card"
            href="{{ block.settings.file_url | default: '#' }}"
            {% if block.settings.file_url != blank %}target="_blank" rel="noopener"{% endif %}
            data-product="{{ manual_product.id }}"
            data-product-title="{{ manual_product.title | escape }}"
            data-product-image="{{ manual_image }}"
            {{ block.shopify_attributes }}
          >
            <span class="sman__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M7 3.5h7.2L19 8.2V20.5H7V3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M14 3.8V8.4h4.4M9.2 12.2h5.6M9.2 15.6h5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="sman__info">
              <span class="sman__name">{{ block.settings.title | escape }}</span>
              {%- if block.settings.description != blank -%}
                <span class="sman__meta">{{ block.settings.description | escape }}</span>
              {%- endif -%}
            </span>
            <span class="sman__down" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 4.5v11M7.5 11.5L12 16l4.5-4.5M6 19.5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #sman-{{ section.id }} {
    background: #fdfdfd;
    border-bottom: 1px solid #e5e5e7;
    color: #1d1d1f;
    padding-top: calc(var(--sman-pt) * var(--rem));
    padding-bottom: calc(var(--sman-pb) * var(--rem));
  }

  #sman-{{ section.id }} .sman__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  #sman-{{ section.id }} .sman__title {
    margin: 0 0 calc(30 * var(--rem));
    color: #000000;
    font-weight: 700;
    text-align: center;
  }

  #sman-{{ section.id }} .sman__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(18 * var(--rem));
  }

  #sman-{{ section.id }} .sman__card {
    display: flex;
    align-items: center;
    gap: calc(15 * var(--rem));
    min-width: 0;
    padding: calc(18 * var(--rem));
    border: 1px solid #e5e5e7;
    border-radius: calc(12 * var(--rem));
    background: #ffffff;
    color: inherit;
    text-decoration: none;
  }

  #sman-{{ section.id }} .sman__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: calc(45 * var(--rem));
    height: calc(45 * var(--rem));
    border-radius: calc(6 * var(--rem));
    background: #f5f5f7;
    color: #000000;
  }

  #sman-{{ section.id }} .sman__icon svg,
  #sman-{{ section.id }} .sman__down svg {
    width: calc(22 * var(--rem));
    height: calc(22 * var(--rem));
  }

  #sman-{{ section.id }} .sman__info {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: calc(3 * var(--rem));
    min-width: 0;
  }

  #sman-{{ section.id }} .sman__name {
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 700;
    line-height: calc(18 * var(--rem));
  }

  #sman-{{ section.id }} .sman__meta {
    color: #86868b;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  #sman-{{ section.id }} .sman__down {
    display: flex;
    flex: 0 0 auto;
    color: #000000;
  }

  @media (hover: hover) {
    #sman-{{ section.id }} .sman__card {
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    #sman-{{ section.id }} .sman__card:hover {
      border-color: #ff6501;
      box-shadow: 0 calc(6 * var(--rem)) calc(15 * var(--rem)) rgba(0, 0, 0, 0.05);
    }
  }

  @media screen and (max-width: 768px) {
    #sman-{{ section.id }} {
      padding-top: calc(var(--sman-pt-m) * var(--rem));
      padding-bottom: calc(var(--sman-pb-m) * var(--rem));
    }

    #sman-{{ section.id }} .sman__shell {
      width: 100%;
      padding: 0 calc(40 * var(--rem));
    }

    #sman-{{ section.id }} .sman__title {
      margin-bottom: calc(60 * var(--rem));
    }

    #sman-{{ section.id }} .sman__grid {
      grid-template-columns: 1fr;
      gap: calc(24 * var(--rem));
    }

    #sman-{{ section.id }} .sman__card {
      gap: calc(24 * var(--rem));
      padding: calc(30 * var(--rem));
      border-radius: calc(16 * var(--rem));
    }

    #sman-{{ section.id }} .sman__icon {
      width: calc(80 * var(--rem));
      height: calc(80 * var(--rem));
      border-radius: calc(8 * var(--rem));
    }

    #sman-{{ section.id }} .sman__icon svg {
      width: calc(40 * var(--rem));
      height: calc(40 * var(--rem));
    }

    #sman-{{ section.id }} .sman__down svg {
      width: calc(38 * var(--rem));
      height: calc(38 * var(--rem));
    }

    #sman-{{ section.id }} .sman__name {
      font-size: calc(34 * var(--rem));
      line-height: calc(42 * var(--rem));
    }

    #sman-{{ section.id }} .sman__meta {
      font-size: calc(26 * var(--rem));
      line-height: calc(34 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sman-{{ section.id }} .sman__card {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Support Manuals",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "User Manuals & Guides" },
    { "type": "range", "id": "padding_top", "label": "上边距（PC）", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "下边距（PC）", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "上边距（手机）", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "下边距（手机）", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "manual_item",
      "name": "说明书",
      "settings": [
        { "type": "text", "id": "title", "label": "标题", "default": "User Guide" },
        { "type": "text", "id": "description", "label": "说明", "default": "PDF file" },
        { "type": "product", "id": "related_product", "label": "关联产品" },
        { "type": "url", "id": "file_url", "label": "文件链接" }
      ]
    }
  ],
  "presets": [{ "name": "Support Manuals" }]
}
{% endschema %}
