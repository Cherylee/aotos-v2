{% render 'aotos-flux-below-assets', with_js: true %}

{%- liquid
  assign story_image = section.settings.image
  assign story_video = section.settings.video
-%}

<section class="fxb fxb-story" style="--fxb-bg: {{ section.settings.bg_color }}; --fxb-color: #fff; --fxb-pt: {{ section.settings.padding_top | default: 80, allow_false: true }}; --fxb-pb: {{ section.settings.padding_bottom | default: 80, allow_false: true }}; --fxb-pt-m: {{ section.settings.padding_top_mobile | default: 88, allow_false: true }}; --fxb-pb-m: {{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }};">
  <div class="fxb-shell">
    <div class="fxb-story__head">
      <h2 class="fxb-title aotos-section-title fxb-story__title">{{ section.settings.title | escape | replace: '. ', '.<br>' }}</h2>
      <div class="fxb-story__copy">{{ section.settings.description }}</div>
    </div>
    <div class="fxb-story__media">
      {%- if story_video != blank -%}
        {%- assign story_poster = story_image | default: story_video.preview_image -%}
        {%- if story_poster != blank -%}
          {%- assign story_h = 1200 | divided_by: story_poster.aspect_ratio | round -%}
          <img src="{{ story_poster | image_url: width: 1200 }}" srcset="{{ story_poster | image_url: width: 600 }} 600w, {{ story_poster | image_url: width: 900 }} 900w, {{ story_poster | image_url: width: 1200 }} 1200w, {{ story_poster | image_url: width: 1600 }} 1600w" sizes="(max-width: 768px) 92vw, 1100px" width="1200" height="{{ story_h }}" alt="" loading="lazy">
        {%- endif -%}
        {% render 'aotos-video', video: story_video, autoplay: false, loop: true, muted: true, preload: 'none' %}
        <button type="button" class="fxb-story__mute" data-fxb-mute aria-pressed="false" aria-label="Mute">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4 9v6h4l5 4V5L8 9H4zm11.5 3a3.5 3.5 0 0 0-2-3.15v6.3a3.5 3.5 0 0 0 2-3.15z"/></svg>
        </button>
      {%- elsif story_image != blank -%}
        {%- assign story_h = 1200 | divided_by: story_image.aspect_ratio | round -%}
        <img src="{{ story_image | image_url: width: 1200 }}" srcset="{{ story_image | image_url: width: 600 }} 600w, {{ story_image | image_url: width: 900 }} 900w, {{ story_image | image_url: width: 1200 }} 1200w, {{ story_image | image_url: width: 1600 }} 1600w" sizes="(max-width: 768px) 92vw, 1100px" width="1200" height="{{ story_h }}" alt="" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</section>

{%- if story_video != blank -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var video = root.querySelector('video');
      if (!video || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var play = function () {
        video.preload = 'auto';
        var pending = video.play();
        if (pending && pending.catch) pending.catch(function () {});
      };
      if (!('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) play();
          else video.pause();
        });
      }, { threshold: 0.2 });
      io.observe(video);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Flux story",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Playful by choice. Predictable by design." },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top mobile", "min": 0, "max": 160, "step": 4, "default": 88 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "min": 0, "max": 160, "step": 4, "default": 88 }
  ],
  "presets": [{ "name": "Flux story" }]
}
{% endschema %}
