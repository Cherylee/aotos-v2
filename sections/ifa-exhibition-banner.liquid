{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile
  if desktop_image == blank
    assign desktop_image = mobile_image
  endif
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
  assign overlay_opacity = section.settings.overlay_opacity | default: 35 | times: 0.01
  assign ifa_light = false
  if section.settings.tone == 'light'
    assign ifa_light = true
  endif
  assign ifa_anim = section.settings.enter_animation
  assign ifa_wash = true
  if section.settings.light_wash == false
    assign ifa_wash = false
  endif
-%}

{%- if ifa_anim -%}
  {% render 'gsap-title-reveal' %}
  {% render 'aotos-fd-enter' %}
{%- endif -%}

<section
  class="ifa-banner section-{{ section.id }}{% if ifa_light %} ifa-banner--light{% endif %}{% if ifa_light and ifa_wash == false %} ifa-banner--no-wash{% endif %}"
  id="IfaBanner-{{ section.id }}"
  style="--ifa-accent: {{ section.settings.accent_color | default: '#ff6501' }}; --ifa-overlay: {{ overlay_opacity }};"
>
  <div class="ifa-banner__frame{% if desktop_image != blank %} ifa-banner__frame--has-image{% else %} ifa-banner__frame--placeholder{% endif %}">
    {%- if desktop_image != blank -%}
      <picture class="ifa-banner__media" aria-hidden="true">
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1440, 1920, 2560, 3200, 3840',
            class: 'ifa-banner__media-image',
            alt: ''
        }}
      </picture>
      {%- if overlay_opacity > 0 -%}
        <span class="ifa-banner__overlay" aria-hidden="true"></span>
      {%- endif -%}
    {%- else -%}
      <div class="ifa-banner__fallback" aria-hidden="true">
        <span class="ifa-banner__fallback-label">{{ section.settings.placeholder_label | default: 'Banner background image' | escape }}</span>
      </div>
    {%- endif -%}

    <div class="ifa-banner__content">
      <div class="ifa-banner__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ifa-banner__eyebrow{% if ifa_anim %} fd-anim fd-fade-up{% endif %}">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ifa-banner__heading{% if ifa_anim %} gsap-title-reveal{% endif %}">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="ifa-banner__description rte{% if ifa_anim %} fd-anim fd-fade-up{% endif %}">{{ section.settings.description }}</div>
        {%- endif -%}
        <div class="ifa-banner__actions{% if ifa_anim %} fd-anim fd-fade-up{% endif %}">
          {%- if section.settings.primary_button_label != blank -%}
            <a
              {% if section.settings.primary_button_link != blank %}
                href="{{ section.settings.primary_button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="ifa-banner__button ifa-banner__button--primary"
            >
              {{ section.settings.primary_button_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            <a
              {% if section.settings.secondary_button_link != blank %}
                href="{{ section.settings.secondary_button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="ifa-banner__button ifa-banner__button--secondary"
            >
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .shopify-section:has(.ifa-banner, .ifa-schedule, .ifa-series, .ifa-find-us, .ifa-subscribe)
    + .shopify-section:has(.ifa-banner, .ifa-schedule, .ifa-series, .ifa-find-us, .ifa-subscribe) {
    margin-top: 0 !important;
  }

  .ifa-banner {
    width: 100%;
  }

  .ifa-banner__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ifa-banner__frame--has-image {
    height: auto;
  }

  .ifa-banner__media {
    display: block;
    width: 100%;
    line-height: 0;
  }

  .ifa-banner__media-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .ifa-banner__frame--placeholder {
    min-height: calc(420 * var(--rem));
    background: #1a1a1a;
  }

  .ifa-banner__fallback {
    position: relative;
    width: 100%;
    min-height: calc(420 * var(--rem));
    background: #1a1a1a;
  }

  .ifa-banner__fallback-label {
    position: absolute;
    top: 50%;
    right: calc(120 * var(--rem));
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(480 * var(--rem));
    max-width: calc(100% - calc(640 * var(--rem)));
    min-height: calc(320 * var(--rem));
    padding: calc(24 * var(--rem));
    box-sizing: border-box;
    border-radius: calc(16 * var(--rem));
    background: #3a3a3a;
    color: rgba(255, 255, 255, 0.35);
    font-size: calc(16 * var(--rem));
    line-height: 1.4;
    text-align: center;
  }

  .ifa-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--ifa-overlay, 0.35));
    pointer-events: none;
  }

  .ifa-banner__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: calc(80 * var(--rem)) calc(120 * var(--rem));
  }

  .ifa-banner__copy {
    width: calc(520 * var(--rem));
    max-width: 100%;
  }

  .ifa-banner__eyebrow {
    margin: 0 0 calc(12 * var(--rem));
    color: var(--ifa-accent, #ff6501);
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    letter-spacing: calc(1.4 * var(--rem));
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ifa-banner__heading {
    margin: 0 0 calc(20 * var(--rem));
    color: #ffffff;
    font-size: calc(56 * var(--rem));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: calc(0.5 * var(--rem));
    text-transform: uppercase;
  }

  .ifa-banner__description {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: calc(16 * var(--rem));
    line-height: 1.6;
  }

  .ifa-banner__description p {
    margin: 0;
  }

  .ifa-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(16 * var(--rem));
    margin-top: calc(32 * var(--rem));
  }

  .ifa-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(44 * var(--rem));
    padding: calc(10 * var(--rem)) calc(28 * var(--rem));
    border-radius: calc(999 * var(--rem));
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: 1;
    letter-spacing: calc(0.4 * var(--rem));
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .ifa-banner__button--primary {
    background: var(--ifa-accent, #ff6501);
    color: #ffffff;
    border: 1px solid var(--ifa-accent, #ff6501);
  }

  .ifa-banner__button--secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  @media (hover: hover) {
    .ifa-banner__button--primary:hover,
    .ifa-banner__button--secondary:hover {
      opacity: 0.88;
      text-decoration: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ifa-banner__frame--placeholder,
    .ifa-banner__fallback {
      min-height: calc(780 * var(--rem));
    }

    .ifa-banner__fallback-label {
      right: calc(40 * var(--rem));
      left: calc(40 * var(--rem));
      width: auto;
      max-width: none;
      min-height: calc(280 * var(--rem));
      font-size: calc(24 * var(--rem));
    }

    .ifa-banner__content {
      align-items: flex-end;
      padding: calc(48 * var(--rem)) calc(40 * var(--rem));
    }

    .ifa-banner__copy {
      width: 100%;
    }

    .ifa-banner__eyebrow {
      margin-bottom: calc(10 * var(--rem));
      font-size: calc(22 * var(--rem));
      letter-spacing: calc(2 * var(--rem));
    }

    .ifa-banner__heading {
      margin-bottom: calc(16 * var(--rem));
      font-size: calc(48 * var(--rem));
    }

    .ifa-banner__description {
      font-size: calc(26 * var(--rem));
    }

    .ifa-banner__actions {
      gap: calc(20 * var(--rem));
      margin-top: calc(28 * var(--rem));
    }

    .ifa-banner__button {
      min-height: calc(72 * var(--rem));
      padding: calc(16 * var(--rem)) calc(36 * var(--rem));
      font-size: calc(26 * var(--rem));
    }
  }

  .ifa-banner--light .ifa-banner__frame--has-image {
    min-height: calc(480 * var(--rem));
    background: #eef1f3;
  }

  .ifa-banner--light .ifa-banner__media {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .ifa-banner--light .ifa-banner__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .ifa-banner--light .ifa-banner__frame--has-image::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(238 241 243 / 95%) 0%, rgb(238 241 243 / 84%) 38%, rgb(238 241 243 / 43%) 62%, rgb(238 241 243 / 0%) 100%);
  }

  .ifa-banner--light .ifa-banner__heading {
    color: #111111;
    text-transform: none;
  }

  .ifa-banner--light .ifa-banner__description {
    color: #666666;
  }

  .ifa-banner--light .ifa-banner__button--secondary {
    background: #ffffff;
    color: #111111;
    border-color: #111111;
  }

  .ifa-banner--light.ifa-banner--no-wash .ifa-banner__frame--has-image::after {
    display: none;
  }

  .ifa-banner--light .ifa-banner__button--primary::after {
    content: "";
    width: calc(8 * var(--rem));
    height: calc(8 * var(--rem));
    margin-left: calc(8 * var(--rem));
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @media screen and (max-width: 768px) {
    .ifa-banner--light .ifa-banner__frame--has-image {
      min-height: calc(1100 * var(--rem));
    }

    .ifa-banner--light .ifa-banner__media-image {
      object-position: 72% center;
    }

    .ifa-banner--light .ifa-banner__frame--has-image::after {
      background: linear-gradient(180deg, rgb(238 241 243 / 95%) 0%, rgb(238 241 243 / 87%) 52%, rgb(238 241 243 / 52%) 78%, rgb(238 241 243 / 15%) 100%);
    }

    .ifa-banner--light .ifa-banner__content {
      align-items: flex-start;
      padding-top: calc(220 * var(--rem));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .ifa-banner__content {
      padding: calc(90 * var(--rem)) calc(34 * var(--rem));
    }

    .ifa-banner__copy {
      width: 100%;
    }

    .ifa-banner__eyebrow {
      font-size: calc(16 * var(--rem));
    }

    .ifa-banner__heading {
      font-size: calc(18 * var(--rem));
    }

    .ifa-banner__description {
      max-width: calc(320 * var(--rem));
      font-size: calc(12 * var(--rem));
    }

    .ifa-banner__button {
      min-height: calc(22 * var(--rem));
      padding: calc(16 * var(--rem)) calc(36 * var(--rem));
      font-size: calc(12 * var(--rem));
    }
  }
</style>

{% schema %}
{
  "name": "IFA Exhibition Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to desktop image when empty."
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Banner background image",
      "info": "Shown when no background image is uploaded."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35,
      "info": "Improves text readability over bright images."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "文字色",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "浅字（深色遮罩）" },
        { "value": "light", "label": "深字（浅色渐变）" }
      ]
    },
    {
      "type": "checkbox",
      "id": "light_wash",
      "label": "浅色渐变蒙层",
      "info": "仅浅色文字模式。关掉后图片不再盖白。",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enter_animation",
      "label": "进场动画",
      "default": false
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff6501"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "RIDE THE FUTURE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RULE OF INNOVATION"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>AOTOS brings intelligent electric mobility to IFA 2026. Experience the next generation of urban adventure.</p>"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Label",
      "default": "book a visit"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Label",
      "default": "view products"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "IFA Exhibition Banner"
    }
  ]
}
{% endschema %}
