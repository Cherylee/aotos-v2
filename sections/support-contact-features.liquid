<section
  class="scf"
  id="scf-{{ section.id }}"
  style="--scf-pt: {{ section.settings.padding_top | default: 80, allow_false: true }}; --scf-pb: {{ section.settings.padding_bottom | default: 80, allow_false: true }}; --scf-pt-m: {{ section.settings.padding_top_mobile | default: 88, allow_false: true }}; --scf-pb-m: {{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }};"
>
  <div class="scf__shell">
    <div class="scf__info">
      {%- if section.settings.title != blank -%}
        <h2 class="scf__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="scf__desc">{{ section.settings.description | escape | newline_to_br }}</p>
      {%- endif -%}
      <div class="scf__details">
        {%- if section.settings.email != blank -%}
          <p class="scf__row">
            <strong>Email:</strong>
            <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
          </p>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <p class="scf__row">
            <strong>Phone:</strong>
            <span>{{ section.settings.phone | escape }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <p class="scf__row">
            <strong>Hours:</strong>
            <span>{{ section.settings.hours | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
    <div class="scf__grid">
      <div class="scf__item">
        <span class="scf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </span>
        <span>24H Response</span>
      </div>
      <div class="scf__item">
        <span class="scf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </span>
        <span>U.S. Warehouse</span>
      </div>
      <div class="scf__item">
        <span class="scf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </span>
        <span>Warranty Care</span>
      </div>
      <div class="scf__item">
        <span class="scf__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </span>
        <span>Order Tracking</span>
      </div>
    </div>
  </div>
</section>

{% style %}
  #scf-{{ section.id }} {
    background: #fdfdfd;
    color: #1d1d1f;
    padding-top: calc(var(--scf-pt) * var(--rem));
    padding-bottom: calc(var(--scf-pb) * var(--rem));
  }

  #scf-{{ section.id }} .scf__shell {
    display: flex;
    justify-content: space-between;
    gap: calc(60 * var(--rem));
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  #scf-{{ section.id }} .scf__info,
  #scf-{{ section.id }} .scf__grid {
    flex: 1 1 0;
    min-width: 0;
  }

  #scf-{{ section.id }} .scf__title {
    margin: 0 0 calc(12 * var(--rem));
    color: #000000;
    font-size: calc(26 * var(--rem));
    font-weight: 700;
    line-height: 1.2;
  }

  #scf-{{ section.id }} .scf__desc {
    margin: 0 0 calc(30 * var(--rem));
    color: #86868b;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: 1.5;
  }

  #scf-{{ section.id }} .scf__details {
    display: flex;
    flex-direction: column;
    gap: calc(12 * var(--rem));
  }

  #scf-{{ section.id }} .scf__row {
    display: flex;
    align-items: baseline;
    gap: calc(8 * var(--rem));
    margin: 0;
    color: #1d1d1f;
    font-size: calc(14 * var(--rem));
    line-height: 1.4;
  }

  #scf-{{ section.id }} .scf__row strong {
    flex: 0 0 calc(50 * var(--rem));
    color: #000000;
    font-weight: 700;
  }

  #scf-{{ section.id }} .scf__row a {
    color: inherit;
    text-decoration: none;
  }

  #scf-{{ section.id }} .scf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(8 * var(--rem));
  }

  #scf-{{ section.id }} .scf__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(22 * var(--rem));
    border: 1px solid #e5e5e7;
    border-radius: calc(15 * var(--rem));
    background: #ffffff;
    color: #000000;
    font-size: calc(15 * var(--rem));
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  #scf-{{ section.id }} .scf__icon {
    display: flex;
    width: calc(32 * var(--rem));
    height: calc(32 * var(--rem));
    margin-bottom: calc(15 * var(--rem));
  }

  #scf-{{ section.id }} .scf__icon svg {
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) {
    #scf-{{ section.id }} .scf__item,
    #scf-{{ section.id }} .scf__row a {
      transition: border-color 0.3s ease, box-shadow 0.3s ease, color 0.3s ease;
    }

    #scf-{{ section.id }} .scf__item:hover {
      border-color: #ff6501;
      box-shadow: 0 calc(6 * var(--rem)) calc(18 * var(--rem)) rgba(0, 0, 0, 0.05);
    }

    #scf-{{ section.id }} .scf__row a:hover {
      color: #000000;
    }
  }

  @media screen and (max-width: 768px) {
    #scf-{{ section.id }} {
      padding-top: calc(var(--scf-pt-m) * var(--rem));
      padding-bottom: calc(var(--scf-pb-m) * var(--rem));
    }

    #scf-{{ section.id }} .scf__shell {
      flex-direction: column;
      gap: calc(80 * var(--rem));
      width: 100%;
      padding: 0 calc(40 * var(--rem));
    }

    #scf-{{ section.id }} .scf__title {
      margin-bottom: calc(32 * var(--rem));
      font-size: calc(60 * var(--rem));
    }

    #scf-{{ section.id }} .scf__desc {
      margin-bottom: calc(60 * var(--rem));
      font-size: calc(24 * var(--rem));
      line-height: 1.5;
    }

    #scf-{{ section.id }} .scf__details {
      gap: calc(16 * var(--rem));
    }

    #scf-{{ section.id }} .scf__row {
      gap: calc(16 * var(--rem));
      font-size: calc(24 * var(--rem));
    }

    #scf-{{ section.id }} .scf__row strong {
      flex-basis: calc(120 * var(--rem));
    }

    #scf-{{ section.id }} .scf__grid {
      gap: calc(24 * var(--rem));
    }

    #scf-{{ section.id }} .scf__item {
      padding: calc(40 * var(--rem));
      border-radius: calc(24 * var(--rem));
      font-size: calc(24 * var(--rem));
    }

    #scf-{{ section.id }} .scf__icon {
      width: calc(60 * var(--rem));
      height: calc(60 * var(--rem));
      margin-bottom: calc(24 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #scf-{{ section.id }} .scf__item,
    #scf-{{ section.id }} .scf__row a {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Support Contact Features",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "标题", "default": "Customer Support" },
    { "type": "textarea", "id": "description", "label": "说明", "default": "We’re here to help with any questions about your order, products, or after-sales service." },
    { "type": "text", "id": "email", "label": "邮箱", "default": "support@aotos.com" },
    { "type": "text", "id": "phone", "label": "电话" },
    { "type": "text", "id": "hours", "label": "时间", "default": "Monday–Friday, 9:00 AM–6:00 PM (PST)" },
    { "type": "range", "id": "padding_top", "label": "上边距（PC）", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "下边距（PC）", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "上边距（手机）", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "下边距（手机）", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Support Contact Features" }]
}
{% endschema %}
