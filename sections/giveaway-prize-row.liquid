{%- liquid
  assign prize_count = section.blocks.size
  if prize_count > 6
    assign prize_count = 6
  endif
  if prize_count < 1
    assign prize_count = 1
  endif

  assign image_size = section.settings.image_size | default: 'large'
  assign show_numbers = section.settings.show_numbers
  assign heading = section.settings.section_heading | strip
  if heading == blank
    assign heading = section.settings.heading | strip
  endif
  if heading == blank and show_numbers and image_size == 'icon'
    assign heading = 'HOW TO ENTER'
  endif

  if image_size == 'icon'
    assign prize_sizes = '(max-width: 749px) 40px, 56px'
    assign img_w = 160
  elsif prize_count <= 3
    assign prize_sizes = '(max-width: 749px) 30vw, 360px'
    assign img_w = 800
  elsif prize_count == 4
    assign prize_sizes = '(max-width: 749px) 30vw, 260px'
    assign img_w = 800
  else
    assign prize_sizes = '(max-width: 749px) 30vw, 180px'
    assign img_w = 800
  endif
-%}

{% style %}
  #giveaway-prizes-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#f4f2ef' }};
    padding-top: calc({{ section.settings.padding_top | default: 40 }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 40 }} * var(--rem));
    color: {{ section.settings.text_color | default: '#333333' }};
    font-family: var(--font-body-family);
  }

  #giveaway-prizes-{{ section.id }} * {
    box-sizing: border-box;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__shell {
    width: calc(1100 * var(--rem));
    max-width: 100%;
    margin: 0 auto;
    padding: 0 calc(30 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__heading {
    margin: 0 0 calc(36 * var(--rem));
    text-align: center;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__title {
    margin: 0;
    font-size: calc(28 * var(--rem));
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#111111' }};
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__accent {
    display: block;
    width: calc(36 * var(--rem));
    height: calc(4 * var(--rem));
    margin: calc(10 * var(--rem)) auto 0;
    border-radius: calc(2 * var(--rem));
    background: {{ section.settings.accent_color | default: '#8bc34a' }};
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__row {
    display: grid;
    grid-template-columns: repeat({{ prize_count }}, minmax(0, 1fr));
    align-items: stretch;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__row--framed {
    border: 1px solid #e6e6e6;
    border-radius: calc(12 * var(--rem));
    box-shadow: 0 calc(6 * var(--rem)) calc(20 * var(--rem)) rgba(0, 0, 0, 0.06);
    background: #ffffff;
    padding: calc(16 * var(--rem)) 0;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__item {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: start;
    justify-content: center;
    min-width: 0;
    padding: calc(12 * var(--rem)) calc(20 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__item + .giveaway-prizes__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 56%;
    transform: translateY(-50%);
    background: {{ section.settings.divider_color | default: '#d8d4ce' }};
    pointer-events: none;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__index {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(28 * var(--rem));
    height: calc(28 * var(--rem));
    margin-right: calc(10 * var(--rem));
    border-radius: 50%;
    background: {{ section.settings.number_bg | default: '#111111' }};
    color: {{ section.settings.number_color | default: '#ffffff' }};
    font-size: calc(12 * var(--rem));
    line-height: 1;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(12 * var(--rem));
    margin: 0 auto calc(16 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(280 * var(--rem));
    height: calc(120 * var(--rem));
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__icons--pair .giveaway-prizes__media {
    width: calc(132 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  @media (hover: hover) {
    #giveaway-prizes-{{ section.id }} a.giveaway-prizes__media {
      transition: opacity 0.2s ease;
    }

    #giveaway-prizes-{{ section.id }} a.giveaway-prizes__media:hover {
      opacity: 0.82;
    }
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__caption {
    margin: 0;
    font-size: calc(16 * var(--rem));
    line-height: 1.4;
    color: {{ section.settings.text_color | default: '#333333' }};
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__note {
    margin: calc(4 * var(--rem)) 0 0;
    font-size: calc(12 * var(--rem));
    line-height: calc(18 * var(--rem));
    color: #999999;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__footnote {
    margin: calc(6 * var(--rem)) 0 0;
    font-size: calc(10 * var(--rem));
    line-height: calc(18 * var(--rem));
    color: #999999;
    text-align: left;
    padding-left: calc(10 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__icons {
    margin-bottom: calc(8 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__media {
    width: calc(60 * var(--rem));
    height: calc(60 * var(--rem));
    max-width: none;
    aspect-ratio: 1 / 1;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__icons--pair .giveaway-prizes__media {
    width: calc(44 * var(--rem));
    height: calc(44 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__caption {
    font-size: calc(16 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item {
    opacity: 0.42;
    transition: opacity 0.85s ease;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-done {
    opacity: 1;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-locked a.giveaway-prizes__media {
    pointer-events: none;
    cursor: default;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__index {
    transition: background-color 0.85s ease, transform 0.7s ease;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-done .giveaway-prizes__index {
    background: {{ section.settings.accent_color | default: '#ff6501' }};
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__caption {
    transition: color 0.85s ease;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-done .giveaway-prizes__caption {
    color: {{ section.settings.accent_color | default: '#ff6501' }};
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media {
    position: relative;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.accent_color | default: '#ff6501' }};
    -webkit-mask-image: var(--icon-mask);
    mask-image: var(--icon-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.85s ease, transform 0.7s ease;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media img {
    transition: opacity 0.85s ease;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__item.is-done .giveaway-prizes__media::after {
    opacity: 1;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__item.is-done .giveaway-prizes__media img {
    opacity: 0;
  }

  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-revealing .giveaway-prizes__index,
  #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item.is-revealing .giveaway-prizes__media {
    animation: giveaway-step-pop-{{ section.id }} 0.8s ease;
  }

  @keyframes giveaway-step-pop-{{ section.id }} {
    0% { transform: scale(0.86); }
    55% { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__index,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__caption,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media::after,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media img,
    #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-fill,
    #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-node {
      transition: none;
      animation: none;
    }
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__steps-wrap {
    display: contents;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress {
    position: relative;
    display: grid;
    grid-template-columns: repeat({{ prize_count }}, minmax(0, 1fr));
    align-items: center;
    width: 100%;
    margin-top: calc(28 * var(--rem));
    min-height: calc(18 * var(--rem));
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-track {
    position: absolute;
    left: calc(100% / {{ prize_count }} / 2);
    right: calc(100% / {{ prize_count }} / 2);
    top: 50%;
    height: calc(4 * var(--rem));
    transform: translateY(-50%);
    background: #e6e6e6;
    border-radius: calc(4 * var(--rem));
    overflow: hidden;
    pointer-events: none;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-fill {
    display: block;
    width: var(--progress, 0%);
    height: 100%;
    background: {{ section.settings.accent_color | default: '#ff6501' }};
    transition: width 0.85s ease, height 0.85s ease;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-node {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    border-radius: 50%;
    background: #e6e6e6;
    box-shadow: 0 0 0 calc(3 * var(--rem)) #ffffff;
    transition: background 0.85s ease, transform 0.7s ease;
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-node.is-done {
    background: {{ section.settings.accent_color | default: '#ff6501' }};
  }

  #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-node.is-current {
    transform: scale(1.25);
  }

  @media (max-width: 749px) {
    #giveaway-prizes-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 32 }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 32 }} * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__shell {
      padding: 0 calc(16 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__heading {
      margin-bottom: calc(24 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__title {
      font-size: calc(32 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__row,
    #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__progress-track {
      left: calc(100% / 3 / 2);
      right: calc(100% / 3 / 2);
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__item {
      flex-direction: column;
      align-items: center;
      padding: calc(12 * var(--rem)) calc(20 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__item + .giveaway-prizes__item::before {
      display: none;
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__item:not(:nth-child(3n + 1))::before {
      display: block;
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 1px;
      height: 56%;
      transform: translateY(-50%);
      background: {{ section.settings.divider_color | default: '#d8d4ce' }};
      pointer-events: none;
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__index {
      width: calc(40 * var(--rem));
      height: calc(40 * var(--rem));
      margin-right: 0;
      margin-bottom: calc(16 * var(--rem));
      font-size: calc(20 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__icons {
      margin-bottom: calc(10 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__media {
      max-width: none;
      width: calc(146 * var(--rem));
      height: auto !important;
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__icons--pair .giveaway-prizes__media {
      width: calc(88 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__caption {
      font-size: calc(24 * var(--rem));
      width: 70%;
      margin: 0 auto;
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__note {
      font-size: calc(18 * var(--rem));
      line-height: calc(24 * var(--rem));
      width: 70%;
      margin: calc(4 * var(--rem)) auto 0;
      text-align: left;
      font-weight: 600;
    }

    #giveaway-prizes-{{ section.id }} .giveaway-prizes__footnote {
      margin-top: calc(16 * var(--rem));
      font-size: calc(16 * var(--rem));
      line-height: calc(24 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__icons {
      margin-bottom: calc(6 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__media {
      width: calc(88 * var(--rem));
      height: calc(88 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__icons--pair .giveaway-prizes__media {
      width: calc(56 * var(--rem));
      height: calc(56 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__caption {
      font-size: calc(24 * var(--rem));
      width: 70%;
      margin: 0 auto;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__steps-wrap {
      display: grid;
      grid-template-columns: calc(28 * var(--rem)) minmax(0, 1fr);
      align-items: stretch;
      column-gap: calc(16 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__progress {
      grid-column: 1;
      grid-row: 1;
      grid-template-columns: 1fr;
      grid-template-rows: repeat({{ prize_count }}, minmax(0, 1fr));
      margin-top: 0;
      min-height: 0;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__row {
      grid-column: 2;
      grid-row: 1;
      grid-template-columns: minmax(0, 1fr);
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__progress-track {
      left: 50%;
      right: auto;
      top: calc(100% / {{ prize_count }} / 2);
      bottom: calc(100% / {{ prize_count }} / 2);
      width: calc(4 * var(--rem));
      height: auto;
      transform: translateX(-50%);
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__progress-fill {
      width: 100%;
      height: var(--progress, 0%);
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__progress-node {
      box-shadow: 0 0 0 calc(3 * var(--rem)) {{ section.settings.bg_color | default: '#ffffff' }};
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item {
      display: grid;
      grid-template-columns: auto calc(140 * var(--rem)) minmax(0, 1fr);
      align-items: center;
      column-gap: calc(16 * var(--rem));
      padding: calc(36 * var(--rem)) 0;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item + .giveaway-prizes__item::before,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item:not(:nth-child(3n + 1))::before {
      display: none;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__index {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-right: 0;
      margin-bottom: 0;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__body {
      display: contents;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__icons,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon.giveaway-prizes--steps .giveaway-prizes__icons {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: 100%;
      justify-content: center;
      align-items: center;
      margin: 0;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__caption,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon.giveaway-prizes--steps .giveaway-prizes__caption {
      grid-column: 3;
      grid-row: 1;
      width: auto;
      margin: 0;
      text-align: left;
      font-size: calc(24 * var(--rem));
      font-weight: 600;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__note {
      grid-column: 3;
      grid-row: 2;
      width: auto;
      margin: 0;
      text-align: left;
      font-weight: 600;
    }
  }

  @media screen and (min-width: 749px) and (max-width: 769px) {
    #giveaway-prizes-{{ section.id }} .giveaway-prizes__media {
      max-width: none;
      width: calc(146 * var(--rem));
      height: auto !important;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon .giveaway-prizes__media {
      width: calc(40 * var(--rem));
      height: calc(40 * var(--rem));
    }
  }

  @media screen and (min-width: 750px) {
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__item {
      align-items: flex-start;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__body {
      width: 100%;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps .giveaway-prizes__icons,
    #giveaway-prizes-{{ section.id }}.giveaway-prizes--icon.giveaway-prizes--steps .giveaway-prizes__icons {
      width: 100%;
      height: calc(60 * var(--rem));
      min-height: calc(60 * var(--rem));
      align-items: center;
      justify-content: center;
      margin: 0 auto calc(8 * var(--rem));
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__media {
      width: calc(60 * var(--rem));
      height: calc(60 * var(--rem)) !important;
    }

    #giveaway-prizes-{{ section.id }}.giveaway-prizes--steps.giveaway-prizes--icon .giveaway-prizes__icons--pair .giveaway-prizes__media {
      width: calc(44 * var(--rem));
      height: calc(44 * var(--rem)) !important;
    }
  }
{% endstyle %}

<section
  id="giveaway-prizes-{{ section.id }}"
  class="giveaway-prizes{% if image_size == 'icon' %} giveaway-prizes--icon{% endif %}{% if show_numbers %} giveaway-prizes--steps{% endif %}"
  {% if show_numbers %}data-current-step="1"{% endif %}
>
  <div class="giveaway-prizes__shell">
    {%- if heading != blank -%}
      <div class="giveaway-prizes__heading">
        <h2 class="giveaway-prizes__title">{{ heading | escape }}</h2>
        <span class="giveaway-prizes__accent" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    <div class="giveaway-prizes__steps-wrap">
    <div class="giveaway-prizes__row{% if section.settings.footnote != blank %} giveaway-prizes__row--framed{% endif %}">
      {%- for block in section.blocks limit: 6 -%}
        {%- liquid
          assign icon_count = 0
          if block.settings.image != blank
            assign icon_count = icon_count | plus: 1
          endif
          if block.settings.image_2 != blank
            assign icon_count = icon_count | plus: 1
          endif
        -%}
        <article
          class="giveaway-prizes__item{% if show_numbers and forloop.index == 1 %} is-done is-current{% endif %}"
          {% if show_numbers %}id="giveaway-step-{{ section.id }}-{{ forloop.index }}" data-step="{{ forloop.index }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if show_numbers -%}
            <span class="giveaway-prizes__index" aria-hidden="true">{{ forloop.index }}</span>
          {%- endif -%}
          <div class="giveaway-prizes__body">
            <div class="giveaway-prizes__icons{% if icon_count > 1 %} giveaway-prizes__icons--pair{% endif %}">
              {%- for icon_i in (1..2) -%}
                {%- liquid
                  if icon_i == 1
                    assign prize_img = block.settings.image
                    assign prize_link = block.settings.image_link
                    assign prize_alt = block.settings.image_alt | default: block.settings.caption | default: 'Giveaway item'
                  else
                    assign prize_img = block.settings.image_2
                    assign prize_link = block.settings.image_2_link
                    assign prize_alt = block.settings.image_2_alt | default: block.settings.caption | default: 'Giveaway item'
                  endif
                -%}
                {%- if prize_img != blank -%}
                  {%- assign prize_h = img_w | divided_by: prize_img.aspect_ratio | round -%}
                  {%- if prize_link != blank -%}
                    <a class="giveaway-prizes__media" href="{{ prize_link }}" style="--icon-mask: url('{{ prize_img | image_url: width: 160 }}');" {% if prize_link contains 'http' %}target="_blank" rel="noopener"{% endif %}>
                  {%- else -%}
                    <div class="giveaway-prizes__media" style="--icon-mask: url('{{ prize_img | image_url: width: 160 }}');">
                  {%- endif -%}
                    {%- if image_size == 'icon' -%}
                      <img
                        src="{{ prize_img | image_url: width: 160 }}"
                        srcset="
                          {{ prize_img | image_url: width: 80 }} 80w,
                          {{ prize_img | image_url: width: 160 }} 160w,
                          {{ prize_img | image_url: width: 240 }} 240w
                        "
                        sizes="{{ prize_sizes }}"
                        width="160"
                        height="{{ prize_h }}"
                        alt="{{ prize_alt | escape }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <img
                        src="{{ prize_img | image_url: width: 800 }}"
                        srcset="
                          {{ prize_img | image_url: width: 400 }} 400w,
                          {{ prize_img | image_url: width: 640 }} 640w,
                          {{ prize_img | image_url: width: 800 }} 800w,
                          {{ prize_img | image_url: width: 1200 }} 1200w
                        "
                        sizes="{{ prize_sizes }}"
                        width="800"
                        height="{{ prize_h }}"
                        alt="{{ prize_alt | escape }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                  {%- if prize_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.caption != blank -%}
              <p class="giveaway-prizes__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p class="giveaway-prizes__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if show_numbers -%}
      <div class="giveaway-prizes__progress" aria-hidden="true">
        <div class="giveaway-prizes__progress-track">
          <span class="giveaway-prizes__progress-fill"></span>
        </div>
        {%- for block in section.blocks limit: 6 -%}
          <span class="giveaway-prizes__progress-node{% if forloop.first %} is-done is-current{% endif %}" data-step="{{ forloop.index }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="giveaway-prizes__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{%- if show_numbers -%}
  <script>
    (function () {
      var root = document.getElementById('giveaway-prizes-{{ section.id }}');
      if (!root) return;

      var storageKey = 'giveaway-step:{{ section.id }}:' + window.location.pathname;
      var items = root.querySelectorAll('.giveaway-prizes__item[data-step]');
      var nodes = root.querySelectorAll('.giveaway-prizes__progress-node');
      var fill = root.querySelector('.giveaway-prizes__progress-fill');
      var total = items.length;
      if (!total) return;

      function setStep(step, scroll, animate) {
        step = Math.max(1, Math.min(Number(step) || 1, total));
        root.setAttribute('data-current-step', String(step));
        items.forEach(function (el) {
          var n = Number(el.getAttribute('data-step'));
          var wasDone = el.classList.contains('is-done');
          el.classList.toggle('is-done', n <= step);
          el.classList.toggle('is-current', n === step);
          if (animate && n <= step && !wasDone) {
            el.classList.remove('is-revealing');
            void el.offsetWidth;
            el.classList.add('is-revealing');
          }
        });
        nodes.forEach(function (el) {
          var n = Number(el.getAttribute('data-step'));
          el.classList.toggle('is-done', n <= step);
          el.classList.toggle('is-current', n === step);
        });
        if (fill) {
          var pct = total === 1 ? '100%' : ((step - 1) / (total - 1) * 100) + '%';
          fill.style.setProperty('--progress', pct);
          fill.style.width = pct;
        }
        try {
          sessionStorage.setItem(storageKey, String(step));
        } catch (e) {}
        items.forEach(function (el) {
          var n = Number(el.getAttribute('data-step'));
          var locked = n > step;
          el.classList.toggle('is-locked', locked);
          el.querySelectorAll('a.giveaway-prizes__media').forEach(function (link) {
            if (locked) {
              link.setAttribute('aria-disabled', 'true');
              link.setAttribute('tabindex', '-1');
            } else {
              link.removeAttribute('aria-disabled');
              link.removeAttribute('tabindex');
            }
          });
        });
        if (scroll) {
          var scrollToStep = function () {
            var target = document.getElementById('giveaway-step-{{ section.id }}-' + step) || root;
            var top = target.getBoundingClientRect().top + window.pageYOffset - 80;
            window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
          };
          scrollToStep();
          window.setTimeout(scrollToStep, 400);
          window.setTimeout(scrollToStep, 900);
        }
      }

      var saved = 1;
      try {
        saved = parseInt(sessionStorage.getItem(storageKey), 10) || 1;
      } catch (e) {}
      var done = saved >= 2;
      setStep(saved, false);

      root.addEventListener(
        'click',
        function (event) {
          var link = event.target.closest && event.target.closest('a.giveaway-prizes__media');
          if (!link) return;
          var item = link.closest('.giveaway-prizes__item[data-step]');
          if (!item) return;
          var n = Number(item.getAttribute('data-step'));
          var cur = Number(root.getAttribute('data-current-step')) || 1;
          if (n > cur) {
            event.preventDefault();
            event.stopPropagation();
          }
        },
        true
      );

      {%- if template == 'page.september-giveaway' -%}
        function getFormRoot() {
          return (
            document.querySelector('#shopify-section-{{ section.id }} ~ .shopify-section .sr-book') ||
            document.querySelector('.sr-book')
          );
        }

        function goStep2() {
          if ((Number(root.getAttribute('data-current-step')) || 1) >= 2) {
            done = true;
            return;
          }
          done = true;
          setStep(2, true, true);
        }

        function goStep3() {
          if ((Number(root.getAttribute('data-current-step')) || 1) < 2) return;
          if ((Number(root.getAttribute('data-current-step')) || 1) >= 3) return;
          setStep(3, true, true);
        }

        var stepTwo = root.querySelector('.giveaway-prizes__item[data-step="2"]');
        if (stepTwo) {
          stepTwo.querySelectorAll('.giveaway-prizes__media').forEach(function (icon) {
            icon.addEventListener('click', goStep3);
          });
        }

        function successVisible() {
          var formRoot = getFormRoot();
          if (!formRoot) return false;
          var els = formRoot.querySelectorAll('.message.success');
          for (var i = 0; i < els.length; i++) {
            var style = window.getComputedStyle(els[i]);
            if (style.display === 'none' || style.visibility === 'hidden' || Number(style.opacity) === 0) continue;
            if (els[i].getBoundingClientRect().height > 0 || els[i].offsetHeight > 0) return true;
          }
          return false;
        }

        function watchSuccess() {
          if (successVisible()) {
            goStep2();
            return;
          }
          var started = Date.now();
          var timer = window.setInterval(function () {
            if (done || Date.now() - started > 20000) {
              window.clearInterval(timer);
              return;
            }
            if (successVisible()) {
              window.clearInterval(timer);
              goStep2();
            }
          }, 250);
        }

        function isGiveawaySubmitControl(el) {
          if (!el || !el.closest) return null;
          var formRoot = getFormRoot();
          if (!formRoot) return null;
          var btn = el.closest('button, input[type="submit"], input[type="button"], .g-btn, [type="submit"]');
          if (!btn || !formRoot.contains(btn)) return null;
          var label = ((btn.textContent || btn.value || '') + ' ' + (btn.getAttribute('class') || '')).toLowerCase();
          if (btn.type === 'submit' || btn.getAttribute('type') === 'submit') return btn;
          if (/submit|send|enter/i.test(label)) return btn;
          if (btn.classList.contains('g-btn') && btn.type !== 'button') return btn;
          if (btn.classList.contains('g-btn')) return btn;
          return null;
        }

        document.addEventListener(
          'submit',
          function (event) {
            var formRoot = getFormRoot();
            var form = event.target;
            if (!formRoot || !form || !form.contains || !formRoot.contains(form)) return;
            watchSuccess();
          },
          true
        );

        document.addEventListener(
          'click',
          function (event) {
            if (!isGiveawaySubmitControl(event.target)) return;
            watchSuccess();
          },
          true
        );

        var formObserved = false;
        function observeForm() {
          var formRoot = getFormRoot();
          if (!formRoot || formObserved) return !!formRoot;
          formObserved = true;
          if (!('MutationObserver' in window)) return true;
          var observer = new MutationObserver(function () {
            if (successVisible()) goStep2();
          });
          observer.observe(formRoot, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['style', 'class']
          });
          return true;
        }

        if (!observeForm()) {
          document.addEventListener('DOMContentLoaded', observeForm);
          var wait = window.setInterval(function () {
            if (observeForm()) window.clearInterval(wait);
          }, 200);
          window.setTimeout(function () {
            window.clearInterval(wait);
          }, 20000);
        }
      {%- endif -%}
    })();
  </script>
{%- endif -%}

{% schema %}
{
