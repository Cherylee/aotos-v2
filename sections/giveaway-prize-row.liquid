        {
          "type": "prize",
          "settings": {
            "caption": "3 × $100 AOTOS Gift Cards",
            "note": "Additional details"
          }
        },
        {
          "type": "prize",
          "settings": {
            "caption": "5 × AOTOS Helmets ($79 each)",
            "note": "Additional details"
          }
        },
        {
