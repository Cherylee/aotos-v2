{%- style -%}
  #Article-{{ section.id }} {
    padding-top: calc({{ section.settings.padding_top | default: 80, allow_false: true }} * var(--rem));
    padding-bottom: calc({{ section.settings.padding_bottom | default: 80, allow_false: true }} * var(--rem));
    overflow-x: clip;
    background: #ffffff;
    color: #000000;
  }

  #Article-{{ section.id }} .article-template__shell {
    width: calc(800 * var(--rem));
    max-width: 100%;
    min-width: 0;
    margin: 0 auto;
    box-sizing: border-box;
  }

  #Article-{{ section.id }} .article-template__header {
    margin-bottom: calc(28 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__title {
    margin: 0;
    color: #000000;
    font-weight: 700;
  }

  #Article-{{ section.id }} .article-template__meta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(8 * var(--rem)) calc(16 * var(--rem));
    margin-top: calc(12 * var(--rem));
    color: #999999;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__share {
    margin-bottom: calc(18 * var(--rem));
  }

  #Article-{{ section.id }} .article-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-share__label {
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
  }

  #Article-{{ section.id }} .article-share__links {
    display: flex;
    align-items: center;
    gap: calc(12 * var(--rem));
  }

  #Article-{{ section.id }} .article-share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(28 * var(--rem));
    height: calc(28 * var(--rem));
    color: #1877f2;
    text-decoration: none;
  }

  #Article-{{ section.id }} .article-share__link .svg-wrapper,
  #Article-{{ section.id }} .article-share__link .icon {
    display: block;
    width: 100%;
    height: 100%;
  }

  #Article-{{ section.id }} .article-share__link--x {
    color: #ffffff;
    background: #000000;
    border-radius: 50%;
  }

  #Article-{{ section.id }} .article-share__link--x .svg-wrapper,
  #Article-{{ section.id }} .article-share__link--x .icon {
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
  }

  #Article-{{ section.id }} .article-share__link--pinterest {
    color: #e60023;
  }

  #Article-{{ section.id }} .article-share__copy {
    position: relative;
  }

  #Article-{{ section.id }} .article-share__copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(8 * var(--rem));
    min-height: calc(var(--aotos-button-height, 40) * var(--rem));
    padding: 0 calc(16 * var(--rem));
    border: 1px solid var(--aotos-theme-color, #ff6501);
    border-radius: var(--buttons-radius, calc(40 * var(--rem)));
    background: var(--aotos-theme-color, #ff6501);
    color: #ffffff;
    font-size: calc(var(--aotos-button-font-size, 14) * var(--rem));
    font-weight: var(--aotos-button-font-weight, 600);
    line-height: 1;
    cursor: pointer;
  }

  #Article-{{ section.id }} .article-share__copy-btn .svg-wrapper,
  #Article-{{ section.id }} .article-share__copy-btn .icon {
    display: block;
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
    color: currentColor;
  }

  #Article-{{ section.id }} .article-share__message {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8 * var(--rem));
    transform: translateX(-50%);
    padding: calc(4 * var(--rem)) calc(8 * var(--rem));
    border-radius: calc(4 * var(--rem));
    background: #000000;
    color: #ffffff;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
    white-space: nowrap;
  }

  @media (hover: hover) {
    #Article-{{ section.id }} .article-share__link {
      transition: transform 0.2s ease;
    }

    #Article-{{ section.id }} .article-share__link:hover {
      transform: scale(1.08);
    }

    #Article-{{ section.id }} .article-share__copy-btn:hover {
      background: #ffffff;
      color: var(--aotos-theme-color, #ff6501);
    }
  }

  #Article-{{ section.id }} .article-template__content {
    max-width: 100%;
    min-width: 0;
    color: #000000;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(22 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content table {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: calc(24 * var(--rem)) 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #Article-{{ section.id }} .article-template__content th,
  #Article-{{ section.id }} .article-template__content td {
    padding: calc(10 * var(--rem)) calc(12 * var(--rem));
    border: 1px solid #e5e5e5;
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }

  #Article-{{ section.id }} .article-template__content > *:first-child {
    margin-top: 0;
  }

  #Article-{{ section.id }} .article-template__content > *:last-child {
    margin-bottom: 0;
  }

  #Article-{{ section.id }} .article-template__content h2,
  #Article-{{ section.id }} .article-template__content h3,
  #Article-{{ section.id }} .article-template__content h4,
  #Article-{{ section.id }} .article-template__content strong,
  #Article-{{ section.id }} .article-template__content b {
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content h2,
  #Article-{{ section.id }} .article-template__content h3,
  #Article-{{ section.id }} .article-template__content h4 {
    margin: calc(32 * var(--rem)) 0 calc(12 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content p,
  #Article-{{ section.id }} .article-template__content li {
    margin: 0 0 calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content ul,
  #Article-{{ section.id }} .article-template__content ol {
    margin: 0 0 calc(16 * var(--rem));
    padding-left: calc(20 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content a {
    color: var(--aotos-theme-color, #ff6501);
  }

  #Article-{{ section.id }} .article-template__content img,
  #Article-{{ section.id }} .article-template__content video {
    display: block;
    width: 100%;
    height: auto;
    margin: calc(24 * var(--rem)) 0;
    border: 0;
    border-radius: calc(16 * var(--rem));
    box-shadow: none;
  }

  #Article-{{ section.id }} .article-template__content iframe {
    width: 100%;
    max-width: 100%;
    margin: calc(24 * var(--rem)) 0;
    border: 0;
    border-radius: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__content blockquote {
    margin: calc(24 * var(--rem)) 0;
    padding-left: calc(16 * var(--rem));
    border-left: calc(3 * var(--rem)) solid var(--aotos-theme-color, #ff6501);
    color: #000000;
  }

  #Article-{{ section.id }} .article-template__back {
    margin-top: calc(48 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__link {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--rem));
    color: #000000;
    font-size: calc(14 * var(--rem));
    font-weight: 600;
    line-height: calc(18 * var(--rem));
    text-decoration: none;
  }

  #Article-{{ section.id }} .article-template__link .svg-wrapper {
    width: calc(14 * var(--rem));
    height: calc(14 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__link .icon-wrap {
    display: flex;
    transform: rotate(180deg);
  }

  #Article-{{ section.id }} .article-template__comment-wrapper {
    margin-top: calc(80 * var(--rem));
    padding: calc(48 * var(--rem)) 0;
    background: #f7f7f7;
  }

  #Article-{{ section.id }} .article-template__comment-wrapper h2 {
    margin: 0 0 calc(48 * var(--rem));
    color: #000000;
    font-weight: 700;
  }

  #Article-{{ section.id }} .article-template__comments {
    margin-bottom: calc(48 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comments-comment {
    margin-bottom: calc(16 * var(--rem));
    padding: calc(20 * var(--rem));
    background: #ffffff;
    border-radius: calc(16 * var(--rem));
    color: #000000;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comments-comment p {
    margin: 0 0 calc(12 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comments-comment footer {
    color: #999999;
    font-size: calc(12 * var(--rem));
    font-weight: 400;
    line-height: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comment-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(16 * var(--rem));
    margin-bottom: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comment-fields > * {
    margin: 0;
  }

  #Article-{{ section.id }} .field__input,
  #Article-{{ section.id }} .text-area {
    padding: calc(34 * var(--rem)) calc(16 * var(--rem)) calc(16 * var(--rem));
    color: #000000;
    font-size: calc(14 * var(--rem));
    line-height: calc(18 * var(--rem));
  }

  #Article-{{ section.id }} .text-area {
    min-height: calc(140 * var(--rem));
  }

  #Article-{{ section.id }} .field__label {
    left: calc(16 * var(--rem));
    top: calc(10 * var(--rem));
    color: #999999;
    font-size: calc(14 * var(--rem));
    letter-spacing: 0;
    line-height: calc(18 * var(--rem));
  }

  #Article-{{ section.id }} .field__input:focus ~ .field__label,
  #Article-{{ section.id }} .field__input:not(:placeholder-shown) ~ .field__label,
  #Article-{{ section.id }} .field__input:-webkit-autofill ~ .field__label {
    top: calc(4 * var(--rem));
    left: calc(16 * var(--rem));
    font-size: calc(12 * var(--rem));
    letter-spacing: 0;
  }

  #Article-{{ section.id }} .article-template__comment-warning {
    margin: calc(16 * var(--rem)) 0;
    color: #999999;
    font-size: calc(12 * var(--rem));
    line-height: calc(16 * var(--rem));
  }

  #Article-{{ section.id }} .article-template__comment-wrapper .button {
    margin-top: calc(16 * var(--rem));
  }

  @media screen and (max-width: 768px) {
    #Article-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top_mobile | default: 88, allow_false: true }} * var(--rem));
      padding-bottom: calc({{ section.settings.padding_bottom_mobile | default: 88, allow_false: true }} * var(--rem));
    }

    #Article-{{ section.id }} .article-template__shell {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: calc(10 * var(--rem)) calc(40 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__meta {
      margin-top: calc(16 * var(--rem));
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-share {
      gap: calc(20 * var(--rem));
    }

    #Article-{{ section.id }} .article-share__label {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-share__links {
      gap: calc(16 * var(--rem));
    }

    #Article-{{ section.id }} .article-share__link {
      width: calc(48 * var(--rem));
      height: calc(48 * var(--rem));
    }

    #Article-{{ section.id }} .article-share__link--x .svg-wrapper,
    #Article-{{ section.id }} .article-share__link--x .icon {
      width: calc(24 * var(--rem));
      height: calc(24 * var(--rem));
    }

    #Article-{{ section.id }} .article-share__copy-btn {
      min-height: calc(var(--aotos-button-height-mobile, 80) * var(--rem));
      padding: 0 calc(28 * var(--rem));
      font-size: calc(var(--aotos-button-font-size-mobile, 22) * var(--rem));
    }

    #Article-{{ section.id }} .article-share__copy-btn .svg-wrapper,
    #Article-{{ section.id }} .article-share__copy-btn .icon {
      width: calc(28 * var(--rem));
      height: calc(28 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__content {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__content th,
    #Article-{{ section.id }} .article-template__content td {
      font-size: calc(20 * var(--rem));
      font-weight: 600;
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__content h2 {
      font-size: var(--aotos-section-title-size);
      font-weight: 700;
      line-height: calc(48 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__content h3,
    #Article-{{ section.id }} .article-template__content h4,
    #Article-{{ section.id }} .article-template__content strong,
    #Article-{{ section.id }} .article-template__content b {
      font-size: calc(22 * var(--rem));
      font-weight: 600;
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__content ul,
    #Article-{{ section.id }} .article-template__content ol {
      padding-left: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__link {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__link .svg-wrapper {
      width: calc(22 * var(--rem));
      height: calc(22 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__comment-wrapper {
      margin-top: calc(88 * var(--rem));
      padding: calc(48 * var(--rem)) 0;
    }

    #Article-{{ section.id }} .article-template__comment-fields {
      grid-template-columns: 1fr;
    }

    #Article-{{ section.id }} .article-template__comments-comment {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .article-template__comments-comment footer,
    #Article-{{ section.id }} .article-template__comment-warning {
      font-size: calc(20 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .field__input,
    #Article-{{ section.id }} .text-area,
    #Article-{{ section.id }} .field__label {
      font-size: calc(22 * var(--rem));
      line-height: calc(32 * var(--rem));
    }

    #Article-{{ section.id }} .field__input:focus ~ .field__label,
    #Article-{{ section.id }} .field__input:not(:placeholder-shown) ~ .field__label,
    #Article-{{ section.id }} .field__input:-webkit-autofill ~ .field__label {
      font-size: calc(20 * var(--rem));
    }
  }
{%- endstyle -%}

<article id="Article-{{ section.id }}" class="article-template">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="article-template__shell" {{ block.shopify_attributes }}>
          {% render block %}
        </div>

      {%- when 'title' -%}
        <header class="article-template__shell article-template__header" {{ block.shopify_attributes }}>
          <h1 class="article-template__title aotos-section-title">{{ article.title | escape }}</h1>
          {%- if block.settings.blog_show_date or block.settings.blog_show_author -%}
            <div class="article-template__meta">
              {%- if block.settings.blog_show_date -%}
                {{- article.published_at | time_tag: format: 'date' -}}
              {%- endif -%}
              {%- if block.settings.blog_show_author -%}
                <span>{{ article.author }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </header>

      {%- when 'content' -%}
        <div class="article-template__shell article-template__content rte" {{ block.shopify_attributes }}>
          {{ article.content }}
        </div>

      {%- when 'share' -%}
        <div class="article-template__shell article-template__share" {{ block.shopify_attributes }}>
          {%- assign share_url = request.origin | append: article.url -%}
          <div class="article-share">
            {%- if block.settings.share_label != blank -%}
              <span class="article-share__label">{{ block.settings.share_label | escape }}:</span>
            {%- endif -%}
            <div class="article-share__links">
              <a
                class="article-share__link article-share__link--facebook"
                href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}"
              >
                <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
              </a>
              <a
                class="article-share__link article-share__link--x"
                href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'general.social.alt_text.share_on_twitter' | t }}"
              >
                <span class="svg-wrapper">{{ 'icon-twitter.svg' | inline_asset_content }}</span>
              </a>
              <a
                class="article-share__link article-share__link--pinterest"
                href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ 'general.social.alt_text.share_on_pinterest' | t }}"
              >
                <span class="svg-wrapper">{{ 'icon-pinterest.svg' | inline_asset_content }}</span>
              </a>
            </div>
            <div class="article-share__copy">
              <button type="button" class="article-share__copy-btn" data-share-url="{{ share_url | escape }}">
                <span class="svg-wrapper">{{ 'icon-copy.svg' | inline_asset_content }}</span>
                <span>{{ 'general.share.copy_to_clipboard' | t }}</span>
              </button>
              <span class="article-share__message" role="status" hidden>{{ 'general.share.success_message' | t }}</span>
            </div>
          </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}

  <div class="article-template__shell article-template__back">
    <a href="{{ blog.url }}" class="article-template__link">
      <span class="icon-wrap">
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </span>
      {{ 'blogs.article.back_to_blog' | t: title: blog.title | escape }}
    </a>
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper">
      <div id="comments" class="article-template__shell">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}
          <h2 id="Comments-{{ article.id }}" class="aotos-section-title" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer>{{ comment.author }}</footer>
                </article>
              {%- endif -%}
              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer>
                    <span>{{ comment.author }}</span>
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}

        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2 class="aotos-section-title">{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.
                    </span>
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.
                    </span>
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span>
              </label>
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.
                </span>
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>
<script>
  (function () {
    var root = document.getElementById('Article-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('.article-share__copy-btn').forEach(function (button) {
      button.addEventListener('click', function () {
        var url = button.getAttribute('data-share-url');
        var message = button.parentElement.querySelector('.article-share__message');
        if (!url || !navigator.clipboard) return;
        navigator.clipboard.writeText(url).then(function () {
          if (!message) return;
          message.hidden = false;
          window.setTimeout(function () {
            message.hidden = true;
          }, 2000);
        });
      });
    });
  })();
</script>

