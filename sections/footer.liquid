{{ 'aotos-footer.css' | asset_url | stylesheet_tag }}

<footer class="aotos-footer">
  <div class="aotos-footer__shell">
    <div class="aotos-footer__main">
      <div class="aotos-footer__menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="aotos-footer__menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="aotos-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="aotos-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="aotos-footer__aside">
        {%- if section.settings.show_social -%}
          <ul class="aotos-footer__social" role="list">
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ settings.social_facebook_link }}" data-social="facebook" target="_blank" rel="noopener">
                  {{- 'icon-facebook.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Facebook</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ settings.social_instagram_link }}" data-social="instagram" target="_blank" rel="noopener">
                  {{- 'icon-instagram.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Instagram</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a href="{{ settings.social_youtube_link }}" data-social="youtube" target="_blank" rel="noopener">
                  {{- 'icon-youtube.svg' | inline_asset_content -}}
                  <span class="visually-hidden">YouTube</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a href="{{ settings.social_tiktok_link }}" data-social="tiktok" target="_blank" rel="noopener">
                  {{- 'icon-tiktok.svg' | inline_asset_content -}}
                  <span class="visually-hidden">TikTok</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li>
                <a href="{{ settings.social_twitter_link }}" data-social="twitter" target="_blank" rel="noopener">
                  {{- 'icon-twitter.svg' | inline_asset_content -}}
                  <span class="visually-hidden">X</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li>
                <a href="{{ settings.social_pinterest_link }}" data-social="pinterest" target="_blank" rel="noopener">
                  {{- 'icon-pinterest.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Pinterest</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_snapchat_link != blank -%}
              <li>
                <a href="{{ settings.social_snapchat_link }}" data-social="snapchat" target="_blank" rel="noopener">
                  {{- 'icon-snapchat.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Snapchat</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tumblr_link != blank -%}
              <li>
                <a href="{{ settings.social_tumblr_link }}" data-social="tumblr" target="_blank" rel="noopener">
                  {{- 'icon-tumblr.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Tumblr</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_vimeo_link != blank -%}
              <li>
                <a href="{{ settings.social_vimeo_link }}" data-social="vimeo" target="_blank" rel="noopener">
                  {{- 'icon-vimeo.svg' | inline_asset_content -}}
                  <span class="visually-hidden">Vimeo</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.newsletter_enable -%}
          {%- form 'customer', id: 'ContactFooter', class: 'aotos-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="aotos-footer__field">
              <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email</label>
              <input
                id="FooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Email"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="FooterEmailError-{{ section.id }}"
                {% endif %}
              >
              <button type="submit">{{ section.settings.newsletter_button | escape }}</button>
            </div>
            {%- if form.errors -%}
              <p class="aotos-footer__message aotos-footer__message--error" id="FooterEmailError-{{ section.id }}">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="aotos-footer__message" tabindex="-1" autofocus>Thanks for subscribing.</p>
            {%- endif -%}
            <label class="aotos-footer__consent">
              <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
              <span>
                {{ section.settings.consent_before | escape }}
                {%- if section.settings.privacy_link != blank -%}
                  <a href="{{ section.settings.privacy_link }}">{{ section.settings.privacy_label | escape }}</a>
                {%- else -%}
                  {{ section.settings.privacy_label | escape }}
                {%- endif -%}
                {{ section.settings.consent_middle | escape }}
                {%- if section.settings.terms_link != blank -%}
                  <a href="{{ section.settings.terms_link }}">{{ section.settings.terms_label | escape }}</a>{{ section.settings.consent_after | escape }}
                {%- else -%}
                  {{ section.settings.terms_label | escape }}{{ section.settings.consent_after | escape }}
                {%- endif -%}
              </span>
            </label>
          {%- endform -%}
        {%- endif -%}

        {%- if section.settings.hours != blank or section.settings.email != blank or settings.payment_icons != blank -%}
          <div class="aotos-footer__meta">
            {%- if section.settings.hours != blank -%}
              <p class="aotos-footer__note">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="12" r="8"></circle>
                  <path d="M12 8v4.5l3 2"></path>
                </svg>
                <span>{{ section.settings.hours | escape }}</span>
              </p>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <p class="aotos-footer__note">
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="4" y="6" width="16" height="12" rx="2"></rect>
                  <path d="M5 7l7 6 7-6"></path>
                </svg>
                <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
              </p>
            {%- endif -%}

            {%- if settings.payment_icons != blank -%}
              <ul class="aotos-footer__pay" role="list">
                {%- assign payment_list = settings.payment_icons | replace: '，', ',' | split: ',' -%}
                {%- for raw_name in payment_list -%}
                  {%- assign pay_name = raw_name | strip | downcase -%}
                  {%- case pay_name -%}
                    {%- when 'mastercard', 'master-card', 'master_card' -%}
                      {%- assign pay_name = 'master' -%}
                    {%- when 'amex', 'americanexpress', 'american-express', 'american express' -%}
                      {%- assign pay_name = 'american_express' -%}
                    {%- when 'diners', 'dinersclub', 'diners-club' -%}
                      {%- assign pay_name = 'diners_club' -%}
                    {%- when 'applepay', 'apple-pay', 'apple pay' -%}
                      {%- assign pay_name = 'apple_pay' -%}
                    {%- when 'googlepay', 'google-pay', 'google pay', 'gpay' -%}
                      {%- assign pay_name = 'google_pay' -%}
                    {%- when 'shoppay', 'shop-pay', 'shop pay', 'shop_pay' -%}
                      {%- assign pay_name = 'shopify_pay' -%}
                    {%- when 'union pay', 'union-pay', 'union_pay' -%}
                      {%- assign pay_name = 'unionpay' -%}
                  {%- endcase -%}
                  {%- if pay_name != blank -%}
                    <li>{{ pay_name | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.app_heading != blank or section.settings.app_store_image != blank or section.settings.google_play_image != blank -%}
          {%- if section.settings.app_heading != blank -%}
            <p class="aotos-footer__apps-label">{{ section.settings.app_heading | escape }}</p>
          {%- endif -%}
          <div class="aotos-footer__apps">
            {%- assign app_badge_sizes = '(max-width: 768px) 29vw, 10vw' -%}
            {%- if section.settings.app_store_image != blank -%}
              {%- assign app_store_height = 480 | divided_by: section.settings.app_store_image.aspect_ratio | round -%}
              <a class="aotos-footer__app" href="{{ section.settings.app_store_link | default: '#' }}">
                <img
                  src="{{ section.settings.app_store_image | image_url: width: 480 }}"
                  srcset="{{ section.settings.app_store_image | image_url: width: 240 }} 240w, {{ section.settings.app_store_image | image_url: width: 360 }} 360w, {{ section.settings.app_store_image | image_url: width: 480 }} 480w, {{ section.settings.app_store_image | image_url: width: 640 }} 640w"
                  sizes="{{ app_badge_sizes }}"
                  width="480"
                  height="{{ app_store_height }}"
                  loading="lazy"
                  alt="Download on the App Store"
                >
              </a>
            {%- endif -%}
            {%- if section.settings.google_play_image != blank -%}
              {%- assign google_play_height = 480 | divided_by: section.settings.google_play_image.aspect_ratio | round -%}
              <a class="aotos-footer__app" href="{{ section.settings.google_play_link | default: '#' }}">
                <img
                  src="{{ section.settings.google_play_image | image_url: width: 480 }}"
                  srcset="{{ section.settings.google_play_image | image_url: width: 240 }} 240w, {{ section.settings.google_play_image | image_url: width: 360 }} 360w, {{ section.settings.google_play_image | image_url: width: 480 }} 480w, {{ section.settings.google_play_image | image_url: width: 640 }} 640w"
                  sizes="{{ app_badge_sizes }}"
                  width="480"
                  height="{{ google_play_height }}"
                  loading="lazy"
                  alt="Get it on Google Play"
                >
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.copyright != blank -%}
      <p class="aotos-footer__copy">{{ section.settings.copyright | escape }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "页脚",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "link_list",
      "name": "菜单",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Product"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "菜单"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "显示社交图标",
      "info": "在主题设置 → 社交媒体里填写链接",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "显示订阅",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "订阅按钮",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "consent_before",
      "label": "同意文案前半",
      "default": "I agree to AOTOS's "
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "隐私政策文字",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "隐私政策链接"
    },
    {
      "type": "text",
      "id": "consent_middle",
      "label": "同意文案中间",
      "default": " and "
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "服务条款文字",
      "default": "Terms of Service"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "服务条款链接"
    },
    {
      "type": "text",
      "id": "consent_after",
      "label": "同意文案结尾",
      "default": "."
    },
    {
      "type": "text",
      "id": "hours",
      "label": "营业时间",
      "default": "Mon–Fri, 9:00 AM–6:00 PM ET"
    },
    {
      "type": "text",
      "id": "email",
      "label": "邮箱",
      "default": "support@aotos.com"
    },
    {
      "type": "text",
      "id": "app_heading",
      "label": "应用标题",
      "default": "GET APP"
    },
    {
      "type": "image_picker",
      "id": "app_store_image",
      "label": "App Store 图片"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "App Store 链接"
    },
    {
      "type": "image_picker",
      "id": "google_play_image",
      "label": "Google Play 图片"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "Google Play 链接"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "版权文字",
      "default": "© 2026, AOTOS. Ride Further. Ride Smarter."
    }
  ]
}
{% endschema %}
