    "flux_faq": {
      "type": "aotos-flux-faq",
      "blocks": {
        "faq_item_cCt6Eh": {
          "type": "faq_item",
          "settings": {
            "question": "What’s the difference between the FLUX X26 and Flux X26 Pro?",
            "related_product": "",
            "answer": "<p>The FLUX X26 is the standard model built for everyday rides, while the Flux X26 Pro is the high-performance version with more power, a larger battery, and advanced smart features. Both models share the same premium frame and suspension.</p>"
          }
        },
        "faq_item_UCRNeq": {
          "type": "faq_item",
          "settings": {
            "question": "What are the key specs of the FLUX X26 and Flux X26 Pro?",
            "related_product": "",
            "answer": "<p>FLUX X26: 750W rated / 1200WPeak in Boost*, 80 Nm torque, 48V 18Ah battery, and up to 50 miles of range.</p><p>FLUX X26 Pro: 750W rated / 2000W Peak in Boost*, 100 Nm torque, 48V 21Ah battery, and up to 70 miles of range.</p><p>Both models offer a top speed of 20 mph, a 330 lb max load, and an IPX5/IPX6 water-resistance rating. The Pro model adds advanced 4G, GPS, and TPMS smart features.</p>"
          }
        },
        "faq_item_T3fWcU": {
          "type": "faq_item",
          "settings": {
            "question": "What smart features are included?",
            "related_product": "",
            "answer": "<p>Both models support app connectivity and keyless unlocking. The Pro model adds 4G connectivity, real-time GPS tracking, tire pressure monitoring, and turn-by-turn navigation.</p>"
          }
        },
        "faq_item_jgHhTe": {
          "type": "faq_item",
          "settings": {
            "question": "What does the warranty cover?",
            "related_product": "",
            "answer": "<p>Warranty coverage varies by component type:</p><p></p><ul><li><strong>Main Components</strong> (Frame, Fork, Handlebar, Kickstand, Motor, Battery, Controller, Display, etc.): <strong>1 Year</strong></li><li><strong>Main Accessories</strong> (Throttle, Headlight, Taillight, Brake Levers, Charger, Shock Absorber, Crank, etc.): <strong>6 Months</strong></li><li><strong>Wear & Tear Parts</strong> (Tires, Fenders, Foot Pegs, Reflectors, Seat, Storage Box, Plastic Parts, etc.): <strong>3 Months</strong></li></ul><p></p><p><strong>Battery Note:</strong> Covered for 1 year or 500 charge cycles (whichever comes first), with capacity remaining at least 80% of rated capacity under 25°C conditions.</p>"
          }
        },
        "faq_item_qWeaLj": {
          "type": "faq_item",
          "settings": {
            "question": "What are your return and shipping policies?",
            "related_product": "",
            "answer": "<p>We offer 30-day returns on bikes in new condition. Free shipping is available within the contiguous U.S. See our Shipping & Returns Policy for full details.</p>"
          }
        },
        "faq_item_f6n3ff": {
          "type": "faq_item",
          "settings": {
            "question": "What is Shipping Protection?",
            "related_product": "",
            "answer": "<p>Shipping Protection is an optional coverage powered by Xcotton that gives you peace of mind when your order is on the way. It protects your package against common shipping risks.</p><p><strong>Shipping Protection cover:</strong></p><ul><li>Loss and damage in transit</li><li>Theft / Porch piracy</li><li>Mis-delivery by the courier</li><li>Quick and easy claims resolution</li></ul>"
          }
        }
      },
