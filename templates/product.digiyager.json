    "l2_features": {
      "type": "l2-features",
      "blocks": {
        "item_space": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/2_443f6d36-238d-4de1-962f-7529fb1b1b24.webp",
            "title": "Premium Craftsmanship, Lasting Appeal",
            "text": "This 20-inch suitcase offers a 31L capacity for organized travel. Check its dimensions and weight against your airline’s baggage requirements before you fly.",
            "tag": "Space-Savvy"
          }
        },
        "item_durable": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/3_2adbad9c-0f92-4bdc-9509-7ce38976d87d.webp",
            "title": "Seamless Strength, Built to Last",
            "text": "Crafted with an integrated aluminum alloy frame, this suitcase delivers unmatched durability and supports up to 242 lbs—designed for long-lasting performance on every journey.",
            "tag": "Durable Design"
          }
        },
        "item_speed": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/2_bb110765-7fd8-4784-a656-a89024c0cf5e.webp",
            "title": "Swift Ride, Extended Range",
            "text": "Reach speeds up to 6.2 mph and travel as far as 6.2 miles on a single charge—engineered for efficient, reliable mobility wherever your journey takes you.",
            "tag": "Speed & Stamina"
          }
        },
        "item_energy": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/1_8d822628-6bec-472f-b5e0-3c4bd048c35d.webp",
            "title": "Dual-Purpose Power Solution",
            "text": "Featuring a detachable power bank that fuels both the suitcase and your mobile devices, this design ensures seamless energy for your journey—anytime, anywhere.\n\n*For your safety, if you choose to check your suitcase, please remember to remove the detachable battery before handing it over.",
            "tag": "Versatile Energy"
          }
        }
      },
      "block_order": ["item_space", "item_durable", "item_speed", "item_energy"],
      "settings": {}
    },
