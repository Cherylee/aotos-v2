            "title": "Refined Design, Premium Feel",
            "text": "Meticulously crafted with high-quality materials, this suitcase exudes sophistication and durability, delivering a luxurious feel that elevates your travel style."
          }
        },
        "item_light": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/3_cdfd9623-8e8f-412f-8577-920e37336786.webp",
            "title": "Stylish Illumination, App-Controlled",
            "text": "Featuring stylish lighting on both sides that can be customized through the app, this suitcase lets you switch modes effortlessly—adding a bold, modern flair to your travels."
          }
        },
        "item_handle": {
          "type": "item",
          "settings": {
            "image": "shopify://shop_images/1_fd18f7d7-1389-46be-a233-7d75bb1abb4c.webp",
