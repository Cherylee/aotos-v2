{
  "sections": {
    "custom_liquid_XMqrw9": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .aotos-survey-wrap{max-width:920px;margin:0 auto;padding:24px 16px;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial}\n  .aotos-card{border:1px solid rgba(0,0,0,.10);border-radius:14px;padding:18px;background:#fff}\n  .aotos-title{font-size:30px;line-height:1.15;margin:0 0 12px;font-weight:900}\n  .aotos-note{font-size:13px;opacity:.78;line-height:1.6;margin:0 0 18px}\n  .aotos-q{margin:18px 0 0}\n  .aotos-q h3{font-size:15px;margin:0 0 10px;font-weight:900}\n  .aotos-req{color:#d11;font-weight:900;margin-left:6px;font-size:12px}\n  .aotos-grid{display:grid;gap:10px}\n  .aotos-opt{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border:1px solid rgba(0,0,0,.12);border-radius:12px;background:rgba(0,0,0,.02)}\n  .aotos-opt input{margin-top:3px}\n  .aotos-sub{font-size:12px;opacity:.75;line-height:1.4;margin-top:6px}\n  .aotos-hint{font-size:12px;opacity:.75;margin-top:8px;line-height:1.45}\n  .aotos-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}\n  .aotos-row input{width:100%;padding:10px 12px;border-radius:10px;border:1px solid rgba(0,0,0,.18)}\n  .aotos-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}\n  .aotos-btn{appearance:none;border:0;border-radius:999px;padding:12px 16px;font-weight:900;cursor:pointer}\n  .aotos-primary{background:#2c7dff;color:#fff}\n  .aotos-ghost{background:rgba(0,0,0,.06);color:#111}\n  .aotos-msg{margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(44,125,255,.25);background:rgba(44,125,255,.10)}\n  .aotos-err{margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,0,0,.18);background:rgba(255,0,0,.06)}\n  .aotos-thumb{width:100%;max-width:520px;border-radius:12px;border:1px solid rgba(0,0,0,.10);display:block;margin-top:8px}\n  .aotos-hidden{display:none !important}\n  @media (max-width:720px){.aotos-row{grid-template-columns:1fr}}\n/* 强制问卷区域文字为黑色（避免主题暗色scheme影响） */\n.aotos-survey-wrap,\n.aotos-survey-wrap *{\n  color:#111 !important;\n}\n\n/* 标题更黑更清晰 */\n.aotos-survey-wrap .aotos-title{\n  color:#111 !important;\n}\n\n/* 说明文字用深灰（仍然易读） */\n.aotos-survey-wrap .aotos-note,\n.aotos-survey-wrap .aotos-sub,\n.aotos-survey-wrap .aotos-hint{\n  color:#444 !important;\n  opacity:1 !important;\n}\n\n/* 卡片背景与边框 */\n.aotos-survey-wrap .aotos-card{\n  background:#fff !important;\n  border-color: rgba(0,0,0,.12) !important;\n}\n\n/* 选项块背景与边框 */\n.aotos-survey-wrap .aotos-opt{\n  background: rgba(0,0,0,.03) !important;\n  border-color: rgba(0,0,0,.14) !important;\n}\n\n/* 输入框文字与边框 */\n.aotos-survey-wrap input,\n.aotos-survey-wrap textarea,\n.aotos-survey-wrap select{\n  color:#111 !important;\n  border-color: rgba(0,0,0,.20) !important;\n  background:#fff !important;\n}\n\n/* 提交按钮保持蓝色白字 */\n.aotos-survey-wrap .aotos-primary{\n  background:#2c7dff !important;\n  color:#fff !important;\n}\n.aotos-survey-wrap .aotos-primary *{\n  color:#fff !important;\n}\n\n/* Reset按钮保持深色字 */\n.aotos-survey-wrap .aotos-ghost{\n  color:#111 !important;\n}\n\n</style>\n\n<div class=\"aotos-survey-wrap\">\n  <div class=\"aotos-card\">\n    <div class=\"aotos-title\">Youth Electric Stunt Bike Survey (US)</div>\n    <p class=\"aotos-note\">\n      This survey is for research purposes only and does not encourage unsafe riding.\n      Please always ride responsibly and follow local laws and regulations.\n    </p>\n\n    {% form 'contact', id: 'aotosSurveyForm' %}\n\n      {%- if form.posted_successfully? -%}\n        <div class=\"aotos-msg\"><strong>Thanks!</strong> Your response has been submitted.</div>\n      {%- endif -%}\n\n      {%- if form.errors -%}\n        <div class=\"aotos-err\">\n          <strong>Submit failed.</strong>\n          Please check required questions (Q1/Q2/Q3/Q15) and try again.\n        </div>\n      {%- endif -%}\n\n      <!-- 邮件主题 -->\n      <input type=\"hidden\" name=\"contact[subject]\" value=\"Youth Electric Stunt Bike Survey (US)\">\n\n      <!-- Shopify contact form 必须有 email 字段：这里用固定邮箱占位，实际填写者邮箱/电话我们会放在 Q15 里 -->\n      <input type=\"hidden\" name=\"contact[email]\" value=\"survey@aotos.com\">\n      <input type=\"hidden\" name=\"contact[name]\" value=\"AOTOS Survey\">\n\n      <!-- Q1 -->\n      <div class=\"aotos-q\">\n        <h3>Q1 | Which best describes you? (Single choice)<span class=\"aotos-req\">*</span></h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Rider aged 8–16\"><span>Rider aged 8–16</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Parent / Guardian\"><span>Parent / Guardian</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Riding enthusiast (researching for a friend or family member)\"><span>Riding enthusiast (researching for a friend or family member)</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Industry professional / Dealer / Content creator\"><span>Industry professional / Dealer / Content creator</span></label>\n        </div>\n      </div>\n\n      <!-- Q2 -->\n      <div class=\"aotos-q\">\n        <h3>Q2 | What is the rider’s age? (Single choice)<span class=\"aotos-req\">*</span></h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q2]\" value=\"8–10\"><span>8–10</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q2]\" value=\"11–13\"><span>11–13</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q2]\" value=\"14–16\"><span>14–16</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q2]\" value=\"17+\"><span>17+</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q2]\" value=\"Not sure yet\"><span>Not sure yet</span></label>\n        </div>\n      </div>\n\n      <!-- Q3 -->\n      <div class=\"aotos-q\">\n        <h3>Q3 | Riding experience? (Single choice)<span class=\"aotos-req\">*</span></h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q3]\" value=\"Complete beginner\"><span>Complete beginner</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q3]\" value=\"Has ridden electric scooters / balance bikes\"><span>Has ridden electric scooters / balance bikes</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q3]\" value=\"Has ridden an eBike\"><span>Has ridden an eBike</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q3]\" value=\"Has ridden electric dirt bikes / light motorcycles\"><span>Has ridden electric dirt bikes / light motorcycles</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q3]\" value=\"Has BMX / skateboard / dirt bike experience\"><span>Has BMX / skateboard / dirt bike experience</span></label>\n        </div>\n      </div>\n\n      <!-- Q4 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q4 | Main use (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Learning basic stunts (wheelies, balance control)\"><span>Learning basic stunts (wheelies, balance control)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Drift, slide, and handling practice\"><span>Drift, slide, and handling practice</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Casual riding / fun / stress relief\"><span>Casual riding / fun / stress relief</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Shooting videos / posting on TikTok or Reels\"><span>Shooting videos / posting on TikTok or Reels</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Off-road riding (non-racing)\"><span>Off-road riding (non-racing)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q4][]\" value=\"Not sure yet\"><span>Not sure yet</span></label>\n        </div>\n        <div class=\"aotos-hint\">Max 3 selections.</div>\n      </div>\n\n      <!-- Q5 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q5 | Preferred design styles (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q5][]\" value=\"KTM / race dirt bike style\"><span>KTM / race dirt bike style</span></label>\n          <div class=\"aotos-sub\">(Exposed frame, aggressive lines, looks like a real dirt bike)</div>\n          <img class=\"aotos-thumb\" src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/survey1_beeaf0df-baba-4670-aa86-d19b11a1e954.png?v=1767577298\" alt=\"KTM style\">\n\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q5][]\" value=\"High-tech / futuristic style\"><span>High-tech / futuristic style</span></label>\n          <div class=\"aotos-sub\">(Clean surfaces, enclosed design, feels like an electric tech product)</div>\n          <img class=\"aotos-thumb\" src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/1767583626355.jpg?v=1767583701\" alt=\"Futuristic style\">\n\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q5][]\" value=\"Lightweight / minimalist style\"><span>Lightweight / minimalist style</span></label>\n          <div class=\"aotos-sub\">(Looks light, simple, and not like a “big motorcycle”)</div>\n          <img class=\"aotos-thumb\" src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/1767583639584.jpg?v=1767583700\" alt=\"Minimalist style\">\n\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q5][]\" value=\"Street stunt style\"><span>Street stunt style</span></label>\n          <div class=\"aotos-sub\">(Short tail, compact, built around control and tricks)</div>\n          <img class=\"aotos-thumb\" src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/1767583659914.jpg?v=1767583701\" alt=\"Street stunt style\">\n\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q5][]\" value=\"No strong preference — performance matters more\"><span>No strong preference — performance matters more</span></label>\n        </div>\n        <div class=\"aotos-hint\">Max 3 selections.</div>\n      </div>\n\n      <!-- Q6 -->\n      <div class=\"aotos-q\">\n        <h3>Q6 | Interested stunt level (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Beginner (small wheelies, low-speed balance, circles)\"><span>Beginner (small wheelies, low-speed balance, circles)</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Intermediate (long wheelies, drifting, tight turns)\"><span>Intermediate (long wheelies, drifting, tight turns)</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Advanced aerial tricks (jumps, airtime)\"><span>Advanced aerial tricks (jumps, airtime)</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Not into stunts — just casual riding\"><span>Not into stunts — just casual riding</span></label>\n        </div>\n      </div>\n\n      <!-- Q7 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q7 | What matters most (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Safety features (crash protection, cut-off, speed limits)\"><span>Safety features (crash protection, cut-off, speed limits)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Easy to learn / good control for stunts\"><span>Easy to learn / good control for stunts</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Lightweight feel\"><span>Lightweight feel</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Looks “pro” / cool\"><span>Looks “pro” / cool</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Upgradeable / mod-friendly\"><span>Upgradeable / mod-friendly</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Price / value for money\"><span>Price / value for money</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Range / battery life\"><span>Range / battery life</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Brand trust & reliability\"><span>Brand trust & reliability</span></label>\n        </div>\n        <div class=\"aotos-hint\">Max 3 selections.</div>\n      </div>\n\n      <!-- Q8 -->\n      <div class=\"aotos-q\">\n        <h3>Q8 | Comfortable price range (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$1,000–1,500\"><span>$1,000–1,500</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$1,500–2,000\"><span>$1,500–2,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$2,000–3,000\"><span>$2,000–3,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$3,000–3,500\"><span>$3,000–3,500</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$3,500–4,000\"><span>$3,500–4,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"$4,000–4,500\"><span>$4,000–4,500</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Above $4,500\"><span>Above $4,500</span></label>\n        </div>\n      </div>\n\n      <!-- Q9 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q9 | Must-have safety/control features (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"Multiple power modes / speed limits\"><span>Multiple power modes / speed limits</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"Tip-over power cut-off\"><span>Tip-over power cut-off</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"Rear-brake priority / anti-misuse protection\"><span>Rear-brake priority / anti-misuse protection</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"Parent control via app\"><span>Parent control via app</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"Emergency shut-off (remote or magnetic kill switch)\"><span>Emergency shut-off (remote or magnetic kill switch)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q9][]\" value=\"I care more about pure mechanical feel\"><span>I care more about pure mechanical feel</span></label>\n        </div>\n        <div class=\"aotos-hint\">Max 3 selections.</div>\n      </div>\n\n      <!-- Q10 -->\n      <div class=\"aotos-q\">\n        <h3>Q10 | Thoughts on a “Stunt Mode”? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"Must have, but should be OFF by default\"><span>Must have, but should be OFF by default</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"Nice to have, with clear safety warnings\"><span>Nice to have, with clear safety warnings</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"Prefer not to have it — too risky\"><span>Prefer not to have it — too risky</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"No strong opinion\"><span>No strong opinion</span></label>\n        </div>\n      </div>\n\n      <!-- Q11 -->\n      <div class=\"aotos-q\">\n        <h3>Q11 | Bike + auto-follow drone interest (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q11]\" value=\"Very appealing — a strong reason to buy\"><span>Very appealing — a strong reason to buy</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q11]\" value=\"Interesting, but not essential\"><span>Interesting, but not essential</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q11]\" value=\"Might use it occasionally\"><span>Might use it occasionally</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q11]\" value=\"Not interested at all\"><span>Not interested at all</span></label>\n        </div>\n      </div>\n\n      <!-- Q12 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q12 | When would you use the drone? (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q12][]\" value=\"Auto-follow while riding\"><span>Auto-follow while riding</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q12][]\" value=\"Recording stunt training sessions\"><span>Recording stunt training sessions</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q12][]\" value=\"Shooting social media content\"><span>Shooting social media content</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q12][]\" value=\"Safety monitoring (remote overview)\"><span>Safety monitoring (remote overview)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q12][]\" value=\"I don’t need a drone\"><span>I don’t need a drone</span></label>\n        </div>\n        <div class=\"aotos-hint\">Max 3 selections.</div>\n      </div>\n\n      <!-- Q13 -->\n      <div class=\"aotos-q\">\n        <h3>Q13 | Preferred drone usage style (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q13]\" value=\"Stored on the bike, auto-launch while riding\"><span>Stored on the bike, auto-launch while riding</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q13]\" value=\"Manually launched when parked\"><span>Manually launched when parked</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q13]\" value=\"Controlled via app\"><span>Controlled via app</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q13]\" value=\"I don’t want my child to use a drone\"><span>I don’t want my child to use a drone</span></label>\n        </div>\n      </div>\n\n      <!-- Q14 -->\n      <div class=\"aotos-q\">\n        <h3>Q14 | Likelihood to consider a 16+ Pro version (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q14]\" value=\"Definitely would upgrade\"><span>Definitely would upgrade</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q14]\" value=\"Might consider it\"><span>Might consider it</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q14]\" value=\"Only interested in the base version\"><span>Only interested in the base version</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q14]\" value=\"Not interested\"><span>Not interested</span></label>\n        </div>\n      </div>\n\n      <!-- Q15 -->\n      <div class=\"aotos-q\">\n        <h3>Q15 | Beta testing / updates? (Single choice)<span class=\"aotos-req\">*</span></h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q15]\" value=\"Yes\"><span>Yes (Please leave your email or phone number below — optional)</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q15]\" value=\"Not at this time\"><span>Not at this time</span></label>\n        </div>\n\n        <div class=\"aotos-row\" id=\"aotosContactRow\">\n          <input name=\"contact[Email]\" type=\"email\" placeholder=\"Email (optional)\">\n          <input name=\"contact[Phone]\" type=\"tel\" placeholder=\"Phone (optional)\">\n        </div>\n\n        <div class=\"aotos-hint\">Required: Q1 / Q2 / Q3 / Q15.</div>\n      </div>\n\n      <div class=\"aotos-actions\">\n        <button type=\"submit\" class=\"aotos-btn aotos-primary\" id=\"aotosSubmitBtn\">Submit</button>\n        <button type=\"reset\" class=\"aotos-btn aotos-ghost\" id=\"aotosResetBtn\">Reset</button>\n      </div>\n\n    {% endform %}\n  </div>\n</div>\n\n<script>\n(function(){\n  const form = document.getElementById('aotosSurveyForm');\n  if(!form) return;\n\n  // 只在 Q15 选 Yes 时显示联系方式输入（可选）\n  const contactRow = document.getElementById('aotosContactRow');\n  function toggleContactRow(){\n    const v = (form.querySelector('input[name=\"contact[Q15]\"]:checked')||{}).value || '';\n    if(!contactRow) return;\n    contactRow.style.display = (v === 'Yes') ? 'grid' : 'none';\n  }\n  form.addEventListener('change', (e)=>{\n    if(e.target && e.target.name === 'contact[Q15]') toggleContactRow();\n  });\n  toggleContactRow();\n\n  // 多选题限制：data-max=\"3\"\n  function enforceMax(box){\n    const wrap = box.closest('[data-max]');\n    if(!wrap) return;\n    const max = parseInt(wrap.getAttribute('data-max'),10);\n    if(!max) return;\n    const checked = wrap.querySelectorAll('input[type=\"checkbox\"]:checked');\n    if(checked.length > max){\n      box.checked = false;\n      alert('Max ' + max + ' selections for this question.');\n    }\n  }\n  form.addEventListener('change', (e)=>{\n    if(e.target && e.target.type === 'checkbox') enforceMax(e.target);\n  });\n\n  // 提交前：确保必填题有选（浏览器 required 已经会拦一次，这里只是更直观）\n  form.addEventListener('submit', (e)=>{\n    const requiredNames = ['contact[Q1]','contact[Q2]','contact[Q3]','contact[Q15]'];\n    for(const n of requiredNames){\n      if(!form.querySelector('input[name=\"'+n+'\"]:checked')){\n        e.preventDefault();\n        alert('Please complete required questions: Q1 / Q2 / Q3 / Q15.');\n        return false;\n      }\n    }\n  });\n})();\n</script>",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
  "order": [
    "custom_liquid_XMqrw9"
  ]
}
