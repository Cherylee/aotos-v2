            "text": "Leave the routine behind and explore new routes, parks, and open spaces without planning your entire day around it."
          }
        },
        "city": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/suidao.png",
            "title": "Everyday City Flow",
            "text": "Commutes, meetups, quick errands, and group rides — Flux X26 is built to move with your day. Smooth power and a comfortable ride make every route feel easier."
          }
        }
      },
      "block_order": [
        "night",
        "weekend",
        "city"
      ],
      "settings": {
        "title": "Built for Weekdays.\nReady for Weekends.",
        "text": "The Flux X26 is made for more than spec sheets. From daily routes to spontaneous detours, it brings power, comfort, and control into the rides you actually take.",
