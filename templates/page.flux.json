    "flux_stories": {
      "type": "flux-lp-stories",
      "blocks": {
        "mark": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/4K_1_9def644b-69c5-40ae-ac38-6cc2684d8d46.png",
            "quote_icon": "shopify://shop_images/yinhao_081602e2-012d-4850-be4e-fa8e912d5f61.svg",
            "quote": "\"I bought it mainly for weekend trail rides, but it's become part of my daily routine. The stability on uneven terrain is what surprised me most — it feels planted and confident even when the path gets rough. I end up exploring places I would've turned around from before.\"",
            "avatar": "shopify://shop_images/555.png",
            "author": "Mark T. — Boulder, Colorado"
          }
        },
        "sarah": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/flux26_slide1.jpg",
            "quote_icon": "shopify://shop_images/yinhao_081602e2-012d-4850-be4e-fa8e912d5f61.svg",
            "quote": "\"The build quality is unlike anything I've seen at this price point. It handles my commute and weekend adventures with equal confidence.\"",
            "avatar": "shopify://shop_images/555.png",
            "author": "Sarah L. — Portland, Oregon"
          }
        },
        "james": {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/flux26_slide3.jpg",
            "quote_icon": "shopify://shop_images/yinhao_081602e2-012d-4850-be4e-fa8e912d5f61.svg",
            "quote": "\"I was skeptical at first, but after the first ride I was hooked. The power delivery is smooth and the range is better than advertised.\"",
            "avatar": "shopify://shop_images/555.png",
            "author": "James K. — Austin, Texas"
          }
        }
