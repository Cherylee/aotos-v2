    "flux_faq": {
      "type": "aotos-flux-faq",
      "blocks": {
        "faq_item_cCt6Eh": {
          "type": "faq_item",
          "settings": {
            "question": "What are the key specs of FLUX T26?",
            "related_product": "",
            "answer": "<p>500W rated / 750W Peak in BOOST*, 60 Nm torque, 48V 14.5Ah actual discharge capacity, and up to 40 miles** of range. 20\" × 4.0\" fat tires, front and rear hydraulic disc brakes, net weight about 84 lb.</p>"
          }
        },
        "faq_item_UCRNeq": {
          "type": "faq_item",
          "settings": {
            "question": "How do I unlock it, and what smart features are included?",
            "related_product": "",
            "answer": "<p>Unlock with NFC, proximity, or passcode. The 1.9\" TFT shows key ride info and supports navigation mirroring. Nearby over Bluetooth, the app shows battery, estimated range, charging status, basic self-check, and lighting settings.</p>"
          }
        },
        "faq_item_T3fWcU": {
          "type": "faq_item",
          "settings": {
            "question": "What does the warranty cover?",
            "related_product": "",
            "answer": "<p>Main components (frame, fork, handlebar, motor, battery, controller, display, etc.): 1 year. Main accessories (throttle, lights, brake levers, charger, etc.): 6 months. Wear parts (tires, fenders, seat, plastic parts, etc.): 3 months. Battery: 1 year or 500 charge cycles, whichever comes first, with at least 80% of rated capacity under normal conditions.</p>"
          }
        },
        "faq_item_jgHhTe": {
          "type": "faq_item",
          "settings": {
            "question": "Is it suitable for off-road riding?",
            "related_product": "",
            "answer": "<p>FLUX T26 is built for paved city streets: commuting, neighborhood trips, and weekend city rides. It is not designed for off-road use.<br/></p>"
          }
        },
        "faq_item_qWeaLj": {
          "type": "faq_item",
          "settings": {
            "question": "What are your return and shipping policies?",
            "related_product": "",
            "answer": "<p>30-day returns on bikes in new, unused condition with original packaging. Free shipping within the contiguous U.S. See our Shipping & Returns Policy for full details.</p>"
          }
        },
        "faq_item_f6n3ff": {
          "type": "faq_item",
          "disabled": true,
          "settings": {
            "question": "What is Shipping Protection?",
            "related_product": "",
