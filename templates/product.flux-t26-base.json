    "flux_features": {
      "type": "aotos-flux-features",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales01.webp",
            "pre_heading": "SMARTER FROM THE START",
            "heading": "Unlock Your Ride, Your Way.",
            "description": "<p>On FLUX T26, get moving with proximity, NFC, or passcode—no key fob hunt. The 1.9\" TFT keeps speed, mode, and battery clear, with navigation mirroring for everyday city trips.<br/></p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales02.webp",
            "pre_heading": "CITY-READY CONFIDENCE",
            "heading": "Built for Commutes and Neighborhood Miles.",
            "description": "<p>20\" × 4.0\" fat tires, hydraulic disc brakes, integrated lighting, and Walk Assist are tuned for paved streets, stop-and-go traffic, and the ride home—not off-road adventures.</p>"
          }
        },
        "card_6": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales03.webp",
            "pre_heading": "RANGE THAT FITS YOUR ROUTE",
            "heading": "Forty Miles When You Need Them.",
            "description": "<p>FLUX T26 delivers up to 40 miles** with 48V 14.5Ah actual discharge capacity. Enough for daily routes without carrying more battery than you need.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales04.webp",
            "pre_heading": "POWER FOR EVERYDAY RIDES",
            "heading": "Responsive Power for City Days.",
            "description": "<p>A 500W rated motor, 750W Peak in BOOST*, and 60 Nm of torque give FLUX T26 clean, predictable power for starts, hills, and stop-and-go riding. Standard power control—gyro-assisted posture sensing is PRO only.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales05.webp",
            "pre_heading": "CREATE AS YOU RIDE",
            "heading": "Capture the City You Ride.",
            "description": "<p>Add an optional bike-mounted Hover holder and use Hover app tracking tools to film rider and group-ride moments. The Hover Creator Kit is an accessory and content tool—not a drone built into the bike.</p>"
          }
        },
        "card_5": {
          "type": "card",
          "settings": {
            "video_url": "",
            "image": "shopify://shop_images/AOTOS_FLUX_T26_Ebike_sales06.webp",
            "pre_heading": "BOOST THE MOMENT",
            "heading": "10 Seconds. One Controlled Burst.",
            "description": "<p>Tap BOOST for up to 750W Peak* on FLUX T26—a short, controlled burst for starts and inclines. Ambient lighting adds a visible energy cue. Peak power is not a speed unlock.</p>"
          }
        }
      },
