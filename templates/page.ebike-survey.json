{
  "sections": {
    "custom_liquid_CVAVQ3": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .aotos-survey-wrap{max-width:920px;margin:0 auto;padding:24px 16px;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;color:#111}\n  .aotos-survey-wrap *{box-sizing:border-box}\n  .aotos-card{border:1px solid rgba(0,0,0,.12);border-radius:14px;padding:18px;background:#fff}\n  .aotos-title{font-size:28px;line-height:1.15;margin:0 0 10px;font-weight:900;color:#111}\n  .aotos-note{font-size:13px;opacity:.9;line-height:1.6;margin:0 0 18px;color:#111}\n  .aotos-q{margin:18px 0 0}\n  .aotos-q h3{font-size:15px;margin:0 0 10px;font-weight:900;color:#111}\n  .aotos-req{color:#d11;font-weight:900;margin-left:6px;font-size:12px}\n  .aotos-grid{display:grid;gap:10px}\n  .aotos-opt{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border:1px solid rgba(0,0,0,.14);border-radius:12px;background:rgba(0,0,0,.02);color:#111}\n  .aotos-opt input{margin-top:3px}\n  .aotos-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}\n  .aotos-row input,.aotos-row textarea,.aotos-input{\n    width:100%;padding:10px 12px;border-radius:10px;border:1px solid rgba(0,0,0,.20);color:#111;background:#fff\n  }\n  .aotos-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}\n  .aotos-btn{appearance:none;border:0;border-radius:999px;padding:12px 16px;font-weight:900;cursor:pointer}\n  .aotos-primary{background:#2c7dff;color:#fff}\n  .aotos-primary[disabled]{opacity:.65;cursor:not-allowed}\n  .aotos-ghost{background:rgba(0,0,0,.06);color:#111}\n  .aotos-msg{margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(44,125,255,.25);background:rgba(44,125,255,.10);color:#111}\n  .aotos-err{margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,0,0,.18);background:rgba(255,0,0,.06);color:#111}\n  .aotos-hint{font-size:12px;opacity:.9;margin-top:8px;line-height:1.45;color:#111}\n  .aotos-hidden{display:none !important}\n  @media (max-width:720px){.aotos-row{grid-template-columns:1fr}}\n</style>\n\n<div class=\"aotos-survey-wrap\">\n  <div class=\"aotos-card\">\n    <div class=\"aotos-title\">EBIKE Survey (US)</div>\n    <p class=\"aotos-note\">\n      This survey is for research purposes only and does not encourage unsafe riding.\n      Please always ride responsibly and follow local laws and regulations.\n    </p>\n\n    {% form 'contact', id: 'aotosEbikeSurvey' %}\n\n      <!-- 成功提示：用 URL 参数 submitted=1 显示（更稳定） -->\n      <div class=\"aotos-msg\" id=\"aotosOkMsg\" style=\"display:none;\">\n        <strong>Thanks!</strong> Your response has been submitted.\n      </div>\n\n      {% if form.errors %}\n        <div class=\"aotos-err\">\n          <strong>Submit failed.</strong> Please check the required questions and try again.\n        </div>\n      {% endif %}\n\n      <!-- 防垃圾（蜜罐，正常用户看不见） -->\n      <div class=\"aotos-hidden\">\n        <label>Leave this empty<input type=\"text\" name=\"contact[hp]\" value=\"\"></label>\n      </div>\n\n      <!-- 邮件主题 -->\n      <input type=\"hidden\" name=\"contact[subject]\" value=\"EBIKE Survey (US)\">\n      <!-- 关键：提交后回到当前页面，并带上 submitted=1 -->\n      <input type=\"hidden\" name=\"return_to\" value=\"{{ request.path }}?submitted=1\">\n\n      <!-- Shopify contact form 需要 email；这里用固定占位，真实联系方式在 Q10 -->\n      <input type=\"hidden\" name=\"contact[email]\" value=\"survey@aotos.com\">\n      <input type=\"hidden\" name=\"contact[name]\" value=\"AOTOS Survey\">\n\n      <!-- Q1 -->\n      <div class=\"aotos-q\">\n        <h3>Q1｜ What is your current e-biking status? (Single choice)<span class=\"aotos-req\">*</span></h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Never ridden an EBIKE\"><span>Never ridden an EBIKE</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Considering buying an EBIKE\"><span>Considering buying an EBIKE</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Already own an EBIKE\"><span>Already own an EBIKE</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Own multiple / Heavy user\"><span>Own multiple / Heavy user</span></label>\n          <label class=\"aotos-opt\"><input required type=\"radio\" name=\"contact[Q1]\" value=\"Industry professional / Dealer / Media\"><span>Industry professional / Dealer / Media</span></label>\n        </div>\n      </div>\n\n      <!-- Q2 -->\n      <div class=\"aotos-q\">\n        <h3>Q2｜What is the rider's age? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q2]\" value=\"8–12\"><span>8–12</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q2]\" value=\"13–17\"><span>13–17</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q2]\" value=\"18–22\"><span>18–22</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q2]\" value=\"Over 22\"><span>Over 22</span></label>\n        </div>\n      </div>\n\n      <!-- Q3 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q3｜What are your primary usage scenarios? (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q3][]\" value=\"City Commuting\"><span>City Commuting</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q3][]\" value=\"Leisure / Weekend Riding\"><span>Leisure / Weekend Riding</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q3][]\" value=\"Off-road / Mountain\"><span>Off-road / Mountain</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q3][]\" value=\"Food delivery / Work use\"><span>Food delivery / Work use</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q3][]\" value=\"Long-distance travel\"><span>Long-distance travel</span></label>\n        </div>\n        <div class=\"aotos-row\" style=\"margin-top:10px\">\n          <input class=\"aotos-input\" name=\"contact[Q3_Others]\" type=\"text\" placeholder=\"Others (optional) __________________\">\n        </div>\n        <div class=\"aotos-hint\">Tip: please select up to 3.</div>\n      </div>\n\n      <!-- Q4 -->\n      <div class=\"aotos-q\">\n        <h3>Q4｜When choosing an EBIKE, what factor do you value most? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Range / Battery Life\"><span>Range / Battery Life</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Power / Torque\"><span>Power / Torque</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Price\"><span>Price</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Weight of the bike\"><span>Weight of the bike</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Design / ID\"><span>Design / ID</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Brand\"><span>Brand</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Safety (Brakes/Lights/Certifications)\"><span>Safety (Brakes/Lights/Certifications)</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"Smart Features (App, Anti-theft, etc.)\"><span>Smart Features (App, Anti-theft, etc.)</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q4]\" value=\"After-sales & Warranty\"><span>After-sales & Warranty</span></label>\n        </div>\n      </div>\n\n      <!-- Q5 -->\n      <div class=\"aotos-q\">\n        <h3>Q5｜What price range are you willing to accept for an EBIKE? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q5]\" value=\"Under $1,000\"><span>Under $1,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q5]\" value=\"$1,000–1,500\"><span>$1,000–1,500</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q5]\" value=\"$1,500–2,000\"><span>$1,500–2,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q5]\" value=\"$2,000–3,000\"><span>$2,000–3,000</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q5]\" value=\"Over $3,000\"><span>Over $3,000</span></label>\n        </div>\n      </div>\n\n      <!-- Q6 -->\n      <div class=\"aotos-q\">\n        <h3>Q6｜What type of motor are you currently using or most interested in? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Hub Motor\"><span>Hub Motor</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"Mid-drive Motor\"><span>Mid-drive Motor</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q6]\" value=\"No preference / Not sure\"><span>No preference / Not sure</span></label>\n        </div>\n      </div>\n\n      <!-- Q7 -->\n      <div class=\"aotos-q\" data-max=\"3\">\n        <h3>Q7｜Which of the following smart features are you most interested in? (Select up to 3)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Anti-theft / GPS Tracking\"><span>Anti-theft / GPS Tracking</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Ride Data & App\"><span>Ride Data & App</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Smart Unlock / Keyless\"><span>Smart Unlock / Keyless</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Integration with Phone/Watch\"><span>Integration with Phone/Watch</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Wheelie Assist System (Makes wheelies easier)\"><span>Wheelie Assist System (Makes wheelies easier)</span></label>\n          <label class=\"aotos-opt\"><input type=\"checkbox\" name=\"contact[Q7][]\" value=\"Don't need smart features\"><span>Don't need smart features</span></label>\n        </div>\n        <div class=\"aotos-hint\">Tip: please select up to 3.</div>\n      </div>\n\n      <!-- Q8 -->\n      <div class=\"aotos-q\">\n        <h3>Q8｜What is your biggest concern regarding EBIKES currently? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Price is too high\"><span>Price is too high</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Range is not realistic\"><span>Range is not realistic</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Quality/Safety worries\"><span>Quality/Safety worries</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Maintenance is troublesome\"><span>Maintenance is troublesome</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Regulations / Road restrictions\"><span>Regulations / Road restrictions</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"Battery life / Safety\"><span>Battery life / Safety</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q8]\" value=\"No obvious concerns\"><span>No obvious concerns</span></label>\n        </div>\n      </div>\n\n      <!-- Q9（含三张图片） -->\n      <div class=\"aotos-q\">\n        <h3>Q9｜Which car do you like best? (Single choice)</h3>\n\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\" style=\"flex-direction:column;align-items:stretch;gap:10px;\">\n            <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n              <input type=\"radio\" name=\"contact[Q9]\" value=\"Retro style\">\n              <span><strong>Retro style</strong></span>\n            </div>\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/1_a9595e6e-13a3-464a-a44e-9b463d08f75d.jpg?v=1767753263\"\n              alt=\"Retro style\"\n              style=\"width:100%;max-width:520px;border-radius:12px;border:1px solid rgba(0,0,0,.10);display:block;\"\n            >\n          </label>\n\n          <label class=\"aotos-opt\" style=\"flex-direction:column;align-items:stretch;gap:10px;\">\n            <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n              <input type=\"radio\" name=\"contact[Q9]\" value=\"Fashionable style\">\n              <span><strong>Fashionable style</strong></span>\n            </div>\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/2_224704b2-44af-47c3-98c6-a14ea3dd834a.jpg?v=1767753263\"\n              alt=\"Fashionable style\"\n              style=\"width:100%;max-width:520px;border-radius:12px;border:1px solid rgba(0,0,0,.10);display:block;\"\n            >\n          </label>\n\n          <label class=\"aotos-opt\" style=\"flex-direction:column;align-items:stretch;gap:10px;\">\n            <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n              <input type=\"radio\" name=\"contact[Q9]\" value=\"Minimalist style\">\n              <span><strong>Minimalist style</strong></span>\n            </div>\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0719/2736/5851/files/3_32771cde-69de-409f-bee2-873d3bc877b8.jpg?v=1767753263\"\n              alt=\"Minimalist style\"\n              style=\"width:100%;max-width:520px;border-radius:12px;border:1px solid rgba(0,0,0,.10);display:block;\"\n            >\n          </label>\n        </div>\n      </div>\n\n      <!-- Q10 -->\n      <div class=\"aotos-q\">\n        <h3>Q10｜Are you willing to leave your email/scan a code to follow us and get access to new products or testing opportunities? (Single choice)</h3>\n        <div class=\"aotos-grid\">\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"Yes\"><span>Yes, please</span></label>\n          <label class=\"aotos-opt\"><input type=\"radio\" name=\"contact[Q10]\" value=\"No\"><span>No, thank you</span></label>\n        </div>\n\n        <div class=\"aotos-row\" id=\"aotosContactRow\" style=\"display:none\">\n          <input class=\"aotos-input\" name=\"contact[Contact Info]\" type=\"text\" placeholder=\"Leave your email or contact info here (optional)\">\n          <input class=\"aotos-input\" name=\"contact[Notes]\" type=\"text\" placeholder=\"(Optional) Notes\">\n        </div>\n      </div>\n\n      <div class=\"aotos-actions\">\n        <button type=\"submit\" class=\"aotos-btn aotos-primary\" id=\"aotosSubmitBtn\">Submit</button>\n        <button type=\"reset\" class=\"aotos-btn aotos-ghost\">Reset</button>\n      </div>\n\n    {% endform %}\n  </div>\n</div>\n\n<script>\n(function(){\n  // 0) 成功提示：URL 带 ?submitted=1\n  try{\n    const params = new URLSearchParams(window.location.search);\n    if(params.get('submitted') === '1'){\n      const ok = document.getElementById('aotosOkMsg');\n      if(ok) ok.style.display = 'block';\n      // 可选：滚动到提示\n      if(ok) ok.scrollIntoView({behavior:'smooth', block:'start'});\n    }\n  }catch(e){}\n\n  const form = document.getElementById('aotosEbikeSurvey');\n  if(!form) return;\n\n  // 1) Q10 选 Yes 才显示联系方式输入\n  const row = document.getElementById('aotosContactRow');\n  function toggleRow(){\n    const v = (form.querySelector('input[name=\"contact[Q10]\"]:checked')||{}).value || '';\n    if(!row) return;\n    row.style.display = (v === 'Yes') ? 'grid' : 'none';\n  }\n  form.addEventListener('change', (e)=>{\n    if(e.target && e.target.name === 'contact[Q10]') toggleRow();\n  });\n  toggleRow();\n\n  // 2) 多选最多 3 个（Q3/Q7）\n  function enforceMax(box){\n    const wrap = box.closest('[data-max]');\n    if(!wrap) return;\n    const max = parseInt(wrap.getAttribute('data-max'),10);\n    if(!max) return;\n    const checked = wrap.querySelectorAll('input[type=\"checkbox\"]:checked');\n    if(checked.length > max){\n      box.checked = false;\n      alert('Max ' + max + ' selections for this question.');\n    }\n  }\n  form.addEventListener('change', (e)=>{\n    if(e.target && e.target.type === 'checkbox') enforceMax(e.target);\n  });\n\n  // 3) 提交按钮反馈 + 必填校验（Q1）\n  const btn = document.getElementById('aotosSubmitBtn');\n  form.addEventListener('submit', (e)=>{\n    // 蜜罐：如果被填了，直接拦（多为机器人）\n    const hp = form.querySelector('input[name=\"contact[hp]\"]');\n    if(hp && hp.value && hp.value.trim() !== ''){\n      e.preventDefault();\n      return false;\n    }\n\n    // 必填：Q1\n    if(!form.querySelector('input[name=\"contact[Q1]\"]:checked')){\n      e.preventDefault();\n      alert('Please complete required question: Q1.');\n      return false;\n    }\n\n    if(btn){\n      btn.disabled = true;\n      btn.textContent = 'Submitting...';\n    }\n  });\n})();\n</script>",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
  "order": [
    "custom_liquid_CVAVQ3"
  ]
}
