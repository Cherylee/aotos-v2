{% comment %}
  标题上滑揭示：CSS 动画，不依赖 GSAP。
  用法：class="gsap-title-reveal"
  data-reveal-delay / data-reveal-duration / data-reveal-stagger 单位秒。
{% endcomment %}

<style>
  .gsap-title-reveal {
    overflow: hidden;
  }

  .gsap-title-reveal .reveal-line {
    display: block;
    transform: translateY(110%);
  }

  .gsap-title-reveal.is-inview .reveal-line {
    animation: aotos-title-reveal var(--reveal-duration, 1.6s) cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--reveal-delay, 0s) + var(--reveal-i, 0) * var(--reveal-stagger, 0.08s));
  }

  @keyframes aotos-title-reveal {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gsap-title-reveal .reveal-line {
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  (function () {
    function wrapLines(el) {
      if (el.dataset.revealInited === '1') return;
      el.dataset.revealInited = '1';

      var html = el.innerHTML.trim();
      if (!html) return;

      html = html.replace(/^<p[^>]*>([\s\S]*)<\/p>$/gi, '$1').trim();
      var parts = html.split(/<br\s*\/?>/gi);
      el.innerHTML = parts.map(function (part, i) {
        var trimmed = part.trim();
        if (!trimmed) return '';
        return '<span class="reveal-line" style="--reveal-i:' + i + '">' + trimmed + '</span>';
      }).filter(Boolean).join('');

      var delay = parseFloat(el.getAttribute('data-reveal-delay')) || 0;
      var duration = parseFloat(el.getAttribute('data-reveal-duration')) || 1.6;
      var stagger = parseFloat(el.getAttribute('data-reveal-stagger')) || 0.08;
      el.style.setProperty('--reveal-delay', delay + 's');
      el.style.setProperty('--reveal-duration', duration + 's');
      el.style.setProperty('--reveal-stagger', stagger + 's');
    }

    function reveal(el) {
      el.classList.add('is-inview');
    }

    function initTitleReveal() {
      var elements = document.querySelectorAll('.gsap-title-reveal');
      if (!elements.length) return;

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var observer = reduced
        ? null
        : new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              reveal(entry.target);
              observer.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -15% 0px', threshold: 0.01 });

      elements.forEach(function (el) {
        if (el.closest('.product-banner')) return;
        wrapLines(el);
        if (reduced) {
          reveal(el);
          return;
        }
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTitleReveal);
    } else {
      initTitleReveal();
    }
  })();
</script>
