{{ 'aotos-nav.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aotos-nav.js' | asset_url }}" defer="defer"></script>

<nav class="aotos-nav" data-aotos-nav aria-label="{{ 'sections.header.menu' | t }}">
  <button
    type="button"
    class="aotos-nav__toggle"
    data-aotos-nav-toggle
    aria-expanded="false"
    aria-controls="AotosNavList-{{ section.id }}"
    data-label-menu="{{ 'sections.header.menu' | t }}"
    data-label-close="Close"
  >
    <span class="visually-hidden">{{ 'sections.header.menu' | t }}</span>
    <span class="aotos-nav__toggle-bar"></span>
    <span class="aotos-nav__toggle-bar"></span>
    <span class="aotos-nav__toggle-bar"></span>
  </button>

  <button type="button" class="aotos-nav__backdrop" data-aotos-nav-close tabindex="-1" aria-hidden="true"></button>

  <ul class="aotos-nav__list" id="AotosNavList-{{ section.id }}" role="list">
    <li class="aotos-nav__back">
      <button type="button" data-aotos-nav-back>
        <span class="aotos-nav__back-icon" aria-hidden="true"></span>
        Back
      </button>
    </li>
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_link' -%}
        <li class="aotos-nav__item" {{ block.shopify_attributes }}>
          <a
            class="aotos-nav__link"
            href="{{ block.settings.link | default: '#' }}"
            {% if block.settings.link != blank and request.path == block.settings.link %}
              aria-current="page"
            {% endif %}
          >
            {{ block.settings.title | escape }}
          </a>
        </li>
      {%- elsif block.type == 'nav_dropdown' or block.type == 'nav_mega' -%}
        {%- liquid
          assign panel_id = 'AotosNavPanel-' | append: block.id
          assign item_current = false
          if block.settings.link != blank and request.path == block.settings.link
            assign item_current = true
          endif
          if block.settings.menu != blank
            if block.settings.menu.links.size > 0
              if request.path == block.settings.link
                assign item_current = true
              endif
            endif
          endif
        -%}
        <li
          class="aotos-nav__item{% if block.type == 'nav_mega' %} aotos-nav__item--mega{% else %} aotos-nav__item--drop{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="aotos-nav__row">
            {%- if block.type != 'nav_mega' and block.settings.link != blank -%}
              <a
                class="aotos-nav__link"
                href="{{ block.settings.link }}"
                {% if item_current %}
                  aria-current="page"
                {% endif %}
                aria-controls="{{ panel_id }}"
              >
                {{ block.settings.title | escape }}
              </a>
            {%- else -%}
              <button type="button" class="aotos-nav__link" data-aotos-sub-toggle aria-expanded="false" aria-controls="{{ panel_id }}">
                {{ block.settings.title | escape }}
              </button>
            {%- endif -%}
            <button
              type="button"
              class="aotos-nav__subtoggle"
              data-aotos-sub-toggle
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
            >
              <span class="visually-hidden">{{ block.settings.title | escape }}</span>
            </button>
          </div>

          {%- if block.type == 'nav_dropdown' -%}
            <div class="aotos-nav__panel aotos-nav__panel--drop" id="{{ panel_id }}">
              <ul class="aotos-nav__drop" role="list">
                {%- if block.settings.menu != blank -%}
                  {%- for child in block.settings.menu.links -%}
                    <li>
                      <a
                        class="aotos-nav__drop-link"
                        href="{{ child.url }}"
                        {% if child.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ child.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..6) -%}
                    {%- liquid
                      assign title_key = 'item_' | append: i | append: '_title'
                      assign url_key = 'item_' | append: i | append: '_url'
                      assign item_title = block.settings[title_key]
                      assign item_url = block.settings[url_key]
                    -%}
                    {%- if item_title != blank -%}
                      <li>
                        <a class="aotos-nav__drop-link" href="{{ item_url | default: '#' }}">{{ item_title | escape }}</a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- else -%}
            <div class="aotos-nav__panel aotos-nav__panel--mega" id="{{ panel_id }}">
              <div class="aotos-nav__mega">
                <ul class="aotos-nav__mega-list" role="list">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      case i
                        when 1
                          assign item_title = block.settings.item_1_title
                          assign item_url = block.settings.item_1_url
                          assign product_1 = block.settings.item_1_product_1
                          assign product_2 = block.settings.item_1_product_2
                          assign product_3 = block.settings.item_1_product_3
                          assign product_4 = block.settings.item_1_product_4
                        when 2
                          assign item_title = block.settings.item_2_title
                          assign item_url = block.settings.item_2_url
                          assign product_1 = block.settings.item_2_product_1
                          assign product_2 = block.settings.item_2_product_2
                          assign product_3 = block.settings.item_2_product_3
                          assign product_4 = block.settings.item_2_product_4
                        when 3
                          assign item_title = block.settings.item_3_title
                          assign item_url = block.settings.item_3_url
                          assign product_1 = block.settings.item_3_product_1
                          assign product_2 = block.settings.item_3_product_2
                          assign product_3 = block.settings.item_3_product_3
                          assign product_4 = block.settings.item_3_product_4
                        when 4
                          assign item_title = block.settings.item_4_title
                          assign item_url = block.settings.item_4_url
                          assign product_1 = block.settings.item_4_product_1
                          assign product_2 = block.settings.item_4_product_2
                          assign product_3 = block.settings.item_4_product_3
                          assign product_4 = block.settings.item_4_product_4
                      endcase
                    -%}
                    {%- if item_title != blank or product_1 != blank or product_2 != blank or product_3 != blank or product_4 != blank -%}
                      <li class="aotos-nav__mega-item{% if forloop.first %} is-active{% endif %}">
                        <a class="aotos-nav__mega-link" href="{{ item_url | default: product_1.url | default: '#' }}">
                          {{ item_title | default: product_1.title | escape }}
                        </a>
                        <div class="aotos-nav__mega-products">
                          {%- for n in (1..4) -%}
                            {%- liquid
                              case n
                                when 1
                                  assign nav_product = product_1
                                when 2
                                  assign nav_product = product_2
                                when 3
                                  assign nav_product = product_3
                                when 4
                                  assign nav_product = product_4
                              endcase
                            -%}
                            {%- if nav_product != blank -%}
                              <a class="aotos-nav__card{% if request.path == nav_product.url %} is-current{% endif %}" href="{{ nav_product.url }}">
                                <span class="aotos-nav__card-media">
                                  {%- if nav_product.featured_image != blank -%}
                                    {%- assign card_width = 320 -%}
                                    {%- assign card_height = card_width | divided_by: nav_product.featured_image.aspect_ratio | round -%}
                                    {{
                                      nav_product.featured_image
                                      | image_url: width: card_width
                                      | image_tag:
                                        widths: '160, 240, 320',
                                        sizes: '(max-width: 768px) 28vw, 11vw',
                                        width: card_width,
                                        height: card_height,
                                        loading: 'lazy',
                                        alt: nav_product.title
                                    }}
                                  {%- endif -%}
                                </span>
                                <span class="aotos-nav__card-title">{{ nav_product.title | escape }}</span>
                              </a>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>
