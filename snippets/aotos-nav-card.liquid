{%- liquid
  assign card_title = nav_title | default: nav_product.title
-%}
<a class="aotos-nav__card{% if request.path == nav_product.url %} is-current{% endif %}" href="{{ nav_product.url }}">
  <span class="aotos-nav__card-media">
    {%- if nav_product.featured_image != blank -%}
      {%- assign card_width = 720 -%}
      {%- assign card_height = card_width | divided_by: nav_product.featured_image.aspect_ratio | round -%}
      {{
        nav_product.featured_image
        | image_url: width: card_width
        | image_tag:
          widths: '360, 540, 720, 960',
          sizes: '(max-width: 768px) 45vw, 22vw',
          width: card_width,
          height: card_height,
          loading: 'lazy',
          alt: card_title
      }}
    {%- endif -%}
  </span>
  <span class="aotos-nav__card-title">
    <span class="aotos-nav__card-name">
      <span class="aotos-nav__card-label">{{ card_title | escape }}</span>
      {%- if nav_new -%}
        <span class="aotos-nav__badge" style="--aotos-nav-badge-bg: #ff0101; --aotos-nav-badge-color: #ffffff;">{{ nav_badge | default: 'New' | escape }}</span>
      {%- endif -%}
    </span>
  </span>
</a>
