{%- if product and product.variants.size > 1 -%}
  {%- assign modal_id = 'AotosOpt-' | append: section_id | append: '-' | append: product.id -%}
  {%- assign first_image = product.featured_image -%}
  {%- if product.selected_or_first_available_variant.featured_image -%}
    {%- assign first_image = product.selected_or_first_available_variant.featured_image -%}
  {%- endif -%}
  <aotos-option-modal
    class="aotos-opt-modal"
    id="{{ modal_id }}"
    hidden
    data-product="{{ product.id }}"
    data-option-count="{{ product.options.size }}"
  >
    <div class="aotos-opt-modal__backdrop" data-opt-close></div>
    <div
      class="aotos-opt-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="aotos-opt-modal__close"
        data-opt-close
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="aotos-opt-modal__media">
        {%- if first_image != blank -%}
          <img
            data-opt-image
            src="{{ first_image | image_url: width: 400 }}"
            alt="{{ product.title | escape }}"
            width="400"
            height="{{ 400 | divided_by: first_image.aspect_ratio | round }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <h3 class="aotos-opt-modal__title">{{ product.title | escape }}</h3>
      <p class="aotos-opt-modal__price" data-opt-price>
        {{ product.selected_or_first_available_variant.price | money }}
      </p>
      {%- for option in product.options_with_values -%}
        <div class="aotos-opt-modal__option">
          <span class="aotos-opt-modal__label">{{ option.name | escape }}:</span>
          <div class="aotos-opt-modal__pills">
            {%- for value in option.values -%}
              <button
                type="button"
                class="aotos-opt-modal__pill{% if option.selected_value == value %} is-active{% endif %}"
                data-option-index="{{ forloop.parentloop.index0 }}"
                data-opt-value="{{ value | escape }}"
              >
                {{ value | escape }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <product-form data-section-id="{{ section_id }}" data-hide-errors="true">
        {%- assign modal_form_id = modal_id | append: '-form' -%}
        {%- form 'product',
          product,
          id: modal_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            class="product-variant-id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
          <button
            type="submit"
            name="add"
            class="aotos-opt-modal__add"
            {% unless product.selected_or_first_available_variant.available %}
              disabled
            {% endunless %}
          >
            <span>{{ 'products.product.add_to_cart' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    </div>
    <script type="application/json" data-opt-variants>
      [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "price": {{ variant.price | money | json }},
            "options": {{ variant.options | json }},
            "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </aotos-option-modal>
{%- endif -%}
