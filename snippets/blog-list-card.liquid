<a class="blog-list__card" href="{{ article.url }}" data-blog-card {% if hidden %}hidden{% endif %}>
  <span class="blog-list__media">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 600 }}"
        srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 800 }} 800w"
        sizes="(max-width: 768px) 92vw, 360px"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="600"
        height="450"
        {% if loading == 'high' %}
          loading="eager"
          fetchpriority="high"
        {% elsif loading == 'eager' %}
          loading="eager"
        {% else %}
          loading="lazy"
        {% endif %}
      >
    {%- endif -%}
    {%- if badge != blank -%}
      <span class="blog-list__badge">{{ badge | escape }}</span>
    {%- endif -%}
  </span>
  <span class="blog-list__body">
    <time class="blog-list__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
      {{- article.published_at | date: '%b %d, %Y' -}}
    </time>
    <span class="blog-list__title">{{ article.title | escape }}</span>
    {%- if excerpt != blank -%}
      <span class="blog-list__excerpt">{{ excerpt | escape }}</span>
    {%- endif -%}
    <span class="blog-list__more">
      Read Article
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
</a>
