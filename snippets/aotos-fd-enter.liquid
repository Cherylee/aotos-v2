{% comment %}
  经销商页进场：CSS 动画，不加载 GSAP。
  .fd-anim.fd-fade-up / .fd-from-left / .fd-from-right
  .fd-anim.fd-stagger > .fd-stagger__item
  .fd-anim.fd-zoom > img
{% endcomment %}
<style>
  html.js .fd-fade-up:not(.is-inview) {
    opacity: 0;
    transform: translate3d(0, 50px, 0);
  }

  html.js .fd-fade-up.is-inview {
    animation: fd-fade-up 1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  html.js .fd-from-left:not(.is-inview) {
    opacity: 0;
    transform: translate3d(-100px, 0, 0);
  }

  html.js .fd-from-left.is-inview {
    animation: fd-from-left 1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  html.js .fd-from-right:not(.is-inview) {
    opacity: 0;
    transform: translate3d(100px, 0, 0);
  }

  html.js .fd-from-right.is-inview {
    animation: fd-from-right 1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  html.js .fd-stagger:not(.is-inview) > .fd-stagger__item {
    opacity: 0;
    transform: translate3d(0, 40px, 0) scale(0.9);
  }

  html.js .fd-stagger.is-inview > .fd-stagger__item {
    animation: fd-stagger-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(2) { animation-delay: 0.15s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(3) { animation-delay: 0.3s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(4) { animation-delay: 0.45s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(5) { animation-delay: 0.6s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(6) { animation-delay: 0.75s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(7) { animation-delay: 0.9s; }
  html.js .fd-stagger.is-inview > .fd-stagger__item:nth-child(8) { animation-delay: 1.05s; }

  .fd-zoom {
    overflow: hidden;
  }

  html.js .fd-zoom:not(.is-inview) img {
    transform: scale(1.3);
  }

  html.js .fd-zoom.is-inview img {
    transform-origin: center center;
    animation: fd-zoom-in 1.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes fd-fade-up {
    from { opacity: 0; transform: translate3d(0, 50px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes fd-from-left {
    from { opacity: 0; transform: translate3d(-100px, 0, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes fd-from-right {
    from { opacity: 0; transform: translate3d(100px, 0, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes fd-stagger-in {
    from { opacity: 0; transform: translate3d(0, 40px, 0) scale(0.9); }
    to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes fd-zoom-in {
    from { transform: scale(1.3); }
    to { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .fd-fade-up,
    html.js .fd-fade-up:not(.is-inview),
    html.js .fd-from-left,
    html.js .fd-from-left:not(.is-inview),
    html.js .fd-from-right,
    html.js .fd-from-right:not(.is-inview),
    html.js .fd-stagger > .fd-stagger__item,
    html.js .fd-stagger:not(.is-inview) > .fd-stagger__item,
    html.js .fd-zoom img,
    html.js .fd-zoom:not(.is-inview) img {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
<script>
  (function () {
    function bind() {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var nodes = document.querySelectorAll('.fd-anim:not([data-fd-bound])');
      if (!nodes.length) return;

      if (reduced || !('IntersectionObserver' in window)) {
        nodes.forEach(function (el) {
          el.dataset.fdBound = '1';
          el.classList.add('is-inview');
        });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-inview');
          io.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -20% 0px', threshold: 0.01 });

      nodes.forEach(function (el) {
        el.dataset.fdBound = '1';
        io.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }

    document.addEventListener('shopify:section:load', bind);
  })();
</script>
